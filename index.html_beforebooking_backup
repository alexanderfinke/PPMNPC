/* ----- overview / pivot / chart ----- */
function bucketOf(month, granularity) {
  var parts = String(month).split('-');
  var y = parts[0] || '';
  var m = Number(parts[1] || 1);
  if (granularity === 'Year') return y;
  if (granularity === 'Quarter') return y + '-Q' + (Math.floor((m - 1) / 3) + 1);
  return ym(month);
}
function bucketLabel(bucket, granularity) {
  if (granularity === 'Month') return monthLabel(bucket.length === 7 ? bucket + '-01' : bucket);
  if (granularity === 'Quarter') {
    var pq = bucket.split('-');
    return (pq[1] || '') + ' ' + String(pq[0] || '').slice(2);
  }
  return bucket;
}
function bucketsList(months, granularity) {
  var out = [];
  months.forEach(function (m) {
    var b = bucketOf(m, granularity);
    if (out.indexOf(b) < 0) out.push(b);
  });
  return out;
}
function monthsPerBucket(months, granularity) {
  var map = {};
  months.forEach(function (m) {
    var b = bucketOf(m, granularity);
    map[b] = (map[b] || 0) + 1;
  });
  return map;
}

function overviewMetricLabel(metric, source) {
  var base = OV_METRIC_LABELS[metric] || metric;
  return source === 'snapshot' ? base + ' (snap)' : base;
}

function overviewActiveDims(direction, levels) {
  var demand = OV_DEMAND_LEVELS.filter(function (l) { return levels[l.id] !== false; }).map(function (l) { return l.id; });
  var alloc = OV_ALLOC_LEVELS.filter(function (l) { return levels[l.id] !== false; }).map(function (l) { return l.id; });
  var dims = direction === 'alloc_to_demand' ? alloc.concat(demand) : demand.concat(alloc);
  if (!dims.length) dims = ['project'];
  return dims;
}

function overviewDimLabel(dim, row) {
  var project = row.project_id ? state.projectById[row.project_id] : null;
  var employee = row.employee_id ? state.employeeById[row.employee_id] : null;
  var role = (employee && employee.role) || row.role || '';
  switch (dim) {
    case 'portfolio': return blankLabel(project && project.portfolio);
    case 'category': return blankLabel(project && project.category);
    case 'program': return blankLabel(project && project.program);
    case 'project': return blankLabel(row.project_topic || (project && project.project_topic));
    case 'unit': return roleUnitFromRole(role);
    case 'department': return roleDepartmentFromRole(role);
    case 'group': return blankLabel(employee && employee.group_name);
    case 'fte_type': return blankLabel(employee && employee.fte_type);
    case 'location': return blankLabel(employee && employee.people_location);
    case 'role': return blankLabel(row.role || role);
    case 'name': return blankLabel(row.name || (employee && employee.name));
    default: return '—';
  }
}

function overviewMetricValue(row, month, metric, source) {
  if (source === 'snapshot') {
    var cmp = state.compare[row.id];
    if (!cmp || !cmp.months) return 0;
    var skey = monthKey(month);
    var snap = cmp.months[skey] || cmp.months[month] || cmp.months[ym(month)];
    if (!snap) return 0;
    var sv = snap[metric];
    return sv == null || sv === '' || isNaN(Number(sv)) ? 0 : Number(sv);
  }
  var key = monthKey(month);
  var cell = row.months && (row.months[key] || row.months[month] || row.months[ym(month)]);
  if (!cell) return 0;
  var raw = cell[metric];
  return raw == null || raw === '' || isNaN(Number(raw)) ? 0 : Number(raw);
}

function emptyOverviewBucket() {
  return { a: 0, b: 0 };
}

function aggregateCompareSeries(rows, months, granularity, seriesA, seriesB, seriesBSource) {
  var cols = bucketsList(months, granularity);
  var sizes = monthsPerBucket(months, granularity);
  var sums = {};
  cols.forEach(function (c) { sums[c] = emptyOverviewBucket(); });
  rows.forEach(function (row) {
    if (isHeader(row) || isAvail(row)) return;
    months.forEach(function (month) {
      var b = bucketOf(month, granularity);
      if (!sums[b]) sums[b] = emptyOverviewBucket();
      sums[b].a += overviewMetricValue(row, month, seriesA, 'current');
      sums[b].b += overviewMetricValue(row, month, seriesB, seriesBSource);
    });
  });
  return cols.map(function (col) {
    var acc = sums[col] || emptyOverviewBucket();
    var n = granularity === 'Month' ? 1 : (sizes[col] || 1);
    var a = n ? acc.a / n : 0;
    var b = n ? acc.b / n : 0;
    return {
      bucket: col,
      label: bucketLabel(col, granularity),
      a: a,
      b: b,
      delta: a - b,
      labelA: overviewMetricLabel(seriesA, 'current'),
      labelB: overviewMetricLabel(seriesB, seriesBSource)
    };
  });
}

function buildOverviewPivot(rows, months, granularity, dims, seriesA, seriesB, seriesBSource) {
  var roots = [];
  var index = {};
  rows.forEach(function (row) {
    if (isHeader(row) || isAvail(row)) return;
    var path = '';
    var siblings = roots;
    for (var depth = 0; depth < dims.length; depth++) {
      var label = overviewDimLabel(dims[depth], row);
      path = path ? path + '›' + label : label;
      var node = index[path];
      if (!node) {
        node = {
          key: path,
          label: label,
          depth: depth,
          values: {},
          period: emptyOverviewBucket(),
          children: []
        };
        index[path] = node;
        siblings.push(node);
      }
      months.forEach(function (month) {
        var bucket = bucketOf(month, granularity);
        if (!node.values[bucket]) node.values[bucket] = emptyOverviewBucket();
        node.values[bucket].a += overviewMetricValue(row, month, seriesA, 'current');
        node.values[bucket].b += overviewMetricValue(row, month, seriesB, seriesBSource);
      });
      siblings = node.children;
    }
  });

  function sortTree(nodes) {
    nodes.sort(function (a, b) { return a.label.localeCompare(b.label, undefined, { sensitivity: 'base' }); });
    nodes.forEach(function (n) { sortTree(n.children); });
  }
  sortTree(roots);

  var cols = bucketsList(months, granularity);
  var sizes = monthsPerBucket(months, granularity);
  function walk(nodes) {
    nodes.forEach(function (node) {
      if (granularity !== 'Month') {
        Object.keys(node.values).forEach(function (bucket) {
          var n = sizes[bucket] || 1;
          if (n > 1) {
            node.values[bucket].a /= n;
            node.values[bucket].b /= n;
          }
        });
      }
      var sumA = 0, sumB = 0, weight = 0;
      cols.forEach(function (col) {
        var n = granularity === 'Month' ? 1 : (sizes[col] || 1);
        var acc = node.values[col] || emptyOverviewBucket();
        sumA += acc.a * n;
        sumB += acc.b * n;
        weight += n;
      });
      if (granularity === 'Month') node.period = { a: sumA, b: sumB };
      else node.period = { a: weight ? sumA / weight : 0, b: weight ? sumB / weight : 0 };
      walk(node.children);
    });
  }
  walk(roots);
  return roots;
}

function overviewPivotToTree(nodes, cols) {
  return nodes.map(function (node) {
    var row = {
      id: node.key,
      label: node.label,
      a__total: node.period.a,
      b__total: node.period.b,
      d__total: node.period.a - node.period.b,
      _children: undefined
    };
    cols.forEach(function (c) {
      var v = node.values[c] || emptyOverviewBucket();
      row['a__' + c] = v.a;
      row['b__' + c] = v.b;
      row['d__' + c] = v.a - v.b;
    });
    if (node.children.length) row._children = overviewPivotToTree(node.children, cols);
    return row;
  });
}

function overviewNumFormatter(cell) {
  var v = Number(cell.getValue() || 0);
  return v ? v.toFixed(1) : '';
}

function overviewDeltaFormatter(cell) {
  var v = Number(cell.getValue() || 0);
  if (!v) return '';
  var cls = v > 0 ? 'overview-delta-pos' : 'overview-delta-neg';
  return '<span class="' + cls + '">' + v.toFixed(1) + '</span>';
