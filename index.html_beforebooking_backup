function findTableRow(table, rowId) {
  if (!table || rowId == null || rowId === '') return null;
  var want = String(rowId);
  try {
    var direct = table.getRow(rowId) || table.getRow(want);
    if (!direct && want !== '' && !isNaN(Number(want))) direct = table.getRow(Number(want));
    if (direct) return direct;
  } catch (e) {}
  function walk(rows) {
    for (var i = 0; i < (rows || []).length; i++) {
      var row = rows[i];
      var d = row.getData();
      if (String(d.id) === want) return row;
      var kids = row.getTreeChildren ? row.getTreeChildren() : [];
      var nested = walk(kids || []);
      if (nested) return nested;
    }
    return null;
  }
  try { return walk(table.getRows() || []); } catch (e2) { return null; }
}

function isListPickerCell(cell) {
