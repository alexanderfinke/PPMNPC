function applyAccessCellEdit(cell, deptOpts, unitOpts, programOpts) {
  if (state.role !== 'Admin') return;
  var d = cell.getData();
  if (!d || d.is_auto || d.id === DEFAULT_ADMIN_ACCESS_ID) return;
  var field = cell.getField();
  var val = cell.getValue();
  deptOpts = deptOpts || [];
  unitOpts = unitOpts || [];
  programOpts = programOpts || [];
  for (var i = 0; i < state.access.length; i++) {
    if (String(state.access[i].id) !== String(d.id)) continue;
    state.access[i][field] = val;
    if (field === 'role_type') {
      var rt = val;
      if (rt === 'admin' || rt === 'viewer') {
        state.access[i].scope_type = 'global';
        state.access[i].scope_value = null;
      } else if (rt === 'people_lead' &&
          ['project', 'program'].indexOf(state.access[i].scope_type) >= 0) {
        state.access[i].scope_type = 'department';
        state.access[i].scope_value = deptOpts[0] || null;
      } else if (rt === 'project_lead' &&
          ['department', 'unit'].indexOf(state.access[i].scope_type) >= 0) {
        state.access[i].scope_type = 'project';
        state.access[i].scope_value = state.projects[0] ? state.projects[0].id : null;
      }
    }
    if (field === 'scope_type') {
      state.access[i].scope_value = null;
      if (val === 'department' && deptOpts[0]) state.access[i].scope_value = deptOpts[0];
      if (val === 'unit' && unitOpts[0]) state.access[i].scope_value = unitOpts[0];
      if (val === 'program' && programOpts[0]) state.access[i].scope_value = programOpts[0];
      if (val === 'project' && state.projects[0]) state.access[i].scope_value = state.projects[0].id;
    }
    if (field === 'user_name') noteMetaValue('User Name', val);
    if (field === 'scope_value') {
      var st = state.access[i].scope_type;
      if (st === 'department') noteMetaValue('Department', val);
      if (st === 'unit') noteMetaValue('Unit', val);
      if (st === 'program') noteMetaValue('Program', val);
