function blankLabel(v) {
  var s = v == null ? '' : String(v).trim();
  return s || '—';
}

function roleUnitFromRole(role) {
  var s = String(role || '').trim();
  if (!s) return '—';
  var slash = s.indexOf('/');
  var beforeSlash = slash < 0 ? s : s.slice(0, slash).trim();
  // No space before "/": unit = text before "/" (same token as department)
  if (slash >= 0 && beforeSlash.indexOf(' ') < 0) {
    return blankLabel(beforeSlash);
  }
  var sp = s.indexOf(' ');
  return blankLabel(sp < 0 ? s : s.slice(0, sp));
}

function roleDepartmentFromRole(role) {
  var s = String(role || '').trim();
  if (!s) return '—';
  var slash = s.indexOf('/');
  return blankLabel(slash < 0 ? s : s.slice(0, slash).trim());
}

function sortRowsByFields(rows, fields) {
  return (rows || []).slice().sort(function (a, b) {
    for (var i = 0; i < fields.length; i++) {
      var c = String(blankLabel(a[fields[i]])).localeCompare(String(blankLabel(b[fields[i]])), undefined, { sensitivity: 'base' });
      if (c) return c;
    }
    return 0;
  });
}

/** Sort and mark first-of-group cells for hierarchy styling. */
function prepareOutlineRows(rows, fields) {
  var sorted = sortRowsByFields(rows, fields);
  var prev = null;
  sorted.forEach(function (r) {
    r._start = {};
    fields.forEach(function (f, i) {
      var v = blankLabel(r[f]);
      var changed = !prev || blankLabel(prev[f]) !== v;
      if (!changed && i > 0) {
        for (var j = 0; j < i; j++) {
          if (r._start[fields[j]]) { changed = true; break; }
        }
      }
      r._start[f] = changed;
    });
    prev = r;
  });
  return sorted;
}

/**
 * Hierarchy cell: first occurrence stands out;
 * repeats are light-blue links, or grey in edit mode.
 */
function outlineFormatter(fields, outlineField, opts) {
  opts = opts || {};
  return function (cell) {
    var d = cell.getData();
    var text = opts.getText ? String(opts.getText(cell) || '') : (cell.getValue() == null ? '' : String(cell.getValue()));
    var isStart = !!(d._start && d._start[outlineField]);
    var tip = text;
    var body;
    if (opts.edit || !opts.dim || !text) {
      body = esc(text);
    } else {
      body = '<span class="ppm-filter-link" data-filter-dim="' + esc(opts.dim) + '" data-filter-value="' + esc(text) +
        '" data-filter-tab="' + esc(opts.filterTab || 'demand') + '">' + esc(text) + '</span>';
    }
    var isLink = !opts.edit && !!opts.dim && !!text;
    var cls = isStart ? 'ppm-outline-start' : (isLink ? 'ppm-outline-repeat-link' : 'ppm-outline-repeat-edit');
    body = '<span class="' + cls + '">' + body + '</span>';
    return withCellTooltip(cell, tip, body);
  };
}

