      { title: 'Δ', field: 'd__total', hozAlign: 'right', headerSort: false, width: 64, formatter: overviewDeltaFormatter }
    ]
  }]);

  state.tables.overview = new Tabulator(host, {
    data: tree,
    columns: columns,
    height: '100%',
