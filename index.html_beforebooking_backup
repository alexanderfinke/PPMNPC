/* Cap Plan finance layer — cost centers, budget, booking, transfer.
 * Included inside startPulseApp() via sync (pasted before boot). */
var FTE_HOURS = 133;
var TRANSFER_SPLIT_HOURS = 99;
var FINANCE_TRANSFER_TYPES = ['direct', 'indirect', 'finance', 'none'];
var CC_LEVELS = ['unit', 'department', 'group', 'role', 'name'];
var CC_LEVEL_RANK = { unit: 1, department: 2, group: 3, role: 4, name: 5 };
var CC_ATTR_FIELDS = [
  'internal_cost_center', 'internal_activity_type',
  'external_cost_center', 'external_activity_type',
  'rbs_skill_name', 'hourly_cost'
];

function financeYearOptions() {
  var years = {};
  (state.months || []).forEach(function (m) {
    var y = Number(String(m).slice(0, 4));
    if (y) years[y] = 1;
  });
  (state.budgetRecords || []).forEach(function (r) { if (r.year) years[r.year] = 1; });
  (state.bookingRecords || []).forEach(function (r) { if (r.year) years[r.year] = 1; });
  var list = Object.keys(years).map(Number).sort();
  if (!list.length) list = [new Date().getFullYear()];
  return list;
}

function fillFinanceYearSelects() {
  var years = financeYearOptions();
  ['budgetYear', 'bookingYear', 'transferYear'].forEach(function (id) {
    var el = $(id);
    if (!el) return;
    var cur = el.value;
    el.innerHTML = years.map(function (y) {
      return '<option value="' + y + '">' + y + '</option>';
    }).join('');
    if (cur && years.indexOf(Number(cur)) >= 0) el.value = cur;
    else el.value = String(years[0]);
  });
}

function isIndyPeopleLocation(loc) {
  var s = String(loc || '').toLowerCase();
  return s.indexOf('indianapolis') >= 0 || /(^|[^a-z])indy([^a-z]|$)/.test(s);
}

function normalizeTransferType(v) {
  var s = String(v || '').trim().toLowerCase();
  return FINANCE_TRANSFER_TYPES.indexOf(s) >= 0 ? s : 'direct';
}

function emptyFinanceMonths() {
  return { '01': null, '02': null, '03': null, '04': null, '05': null, '06': null,
    '07': null, '08': null, '09': null, '10': null, '11': null, '12': null };
}

function monthKeysForYear(year) {
  var y = String(year);
  return ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].map(function (mm) {
    return y + '-' + mm + '-01';
  });
}

function financeMm(monthKey) {
  return String(monthKey || '').slice(5, 7);
}

function isProjectAllocatedEmployee(emp) {
  return String((emp && emp.fte_type) || '').trim().toLowerCase() === 'project-allocated';
}

function hierarchyForEmployee(emp, row) {
  var role = (row && row.role) || (emp && emp.role) || '';
  var name = (row && row.name) || (emp && emp.name) || '';
  return {
    unit: roleUnitFromRole(role),
    department: roleDepartmentFromRole(role),
    group: (emp && emp.group_name) || '',
    role: role,
    name: name
  };
}

function costCenterIndex() {
  var byLevel = { unit: {}, department: {}, group: {}, role: {}, name: {} };
  (state.costCenters || []).forEach(function (c) {
    var lvl = String(c.level || '').toLowerCase();
    var key = String(c.level_value || '').trim().toLowerCase();
    if (!byLevel[lvl] || !key) return;
    byLevel[lvl][key] = c;
  });
  return byLevel;
}

/** Most-specific wins per field across unit→name. */
function resolveCostCenterAttrs(hier) {
  var idx = costCenterIndex();
  var out = {
    internal_cost_center: '',
    internal_activity_type: '',
    external_cost_center: '',
    external_activity_type: '',
    rbs_skill_name: '',
    hourly_cost: '',
    missing: false,
    source_level: {}
  };
  var order = ['unit', 'department', 'group', 'role', 'name'];
  order.forEach(function (lvl) {
    var key = String(hier[lvl] || '').trim().toLowerCase();
    var hit = key && idx[lvl] && idx[lvl][key];
    if (!hit) return;
    CC_ATTR_FIELDS.forEach(function (f) {
      var v = hit[f];
      if (v != null && String(v).trim() !== '') {
        out[f] = String(v).trim();
        out.source_level[f] = lvl;
      }
    });
  });
  if (!out.internal_cost_center || !out.internal_activity_type) out.missing = true;
  return out;
}

function projectCostCenterForContext(project, peopleLocation) {
  if (!project) return { cc: '', site: 'ma', missing: true };
  if (isIndyPeopleLocation(peopleLocation)) {
    var indy = String(project.wbs_indy || '').trim();
    return { cc: indy, site: 'indy', missing: !indy };
  }
  var ma = String(project.wbs_ma || '').trim();
  return { cc: ma, site: 'ma', missing: !ma };
}

function parseHourlyCost(text) {
  var s = String(text || '').trim();
  if (!s) return { amount: null, currency: 'CUR' };
  var m = s.match(/([0-9]+(?:[.,][0-9]+)?)/);
  var amount = m ? Number(String(m[1]).replace(',', '.')) : null;
  var cur = 'CUR';
  if (/€|eur/i.test(s)) cur = '€';
  else if (/\$|usd/i.test(s)) cur = 'USD';
  else if (/chf/i.test(s)) cur = 'CHF';
  else if (/gbp|£/i.test(s)) cur = 'GBP';
  else {
    var tok = s.replace(m ? m[0] : '', '').trim();
    if (tok) cur = tok.split(/\s+/)[0];
  }
  return { amount: amount, currency: cur };
}

function financeDisplayValue(fte, hourlyText, unit) {
  if (fte == null || fte === '') return null;
  var n = Number(fte);
  if (!isFinite(n)) return null;
  if (unit === 'hours') return roundFte(n * FTE_HOURS);
  if (unit === 'cur') {
    var p = parseHourlyCost(hourlyText);
    if (p.amount == null) return null;
    return roundFte(n * FTE_HOURS * p.amount);
  }
  return roundFte(n);
}

function financeRecordKey(rec) {
  var kind = String(rec.kind || 'pair').toLowerCase() === 'row' ? 'row' : 'pair';
  if (kind === 'row') return 'row|' + String(rec.row_id || '') + '|' + String(rec.year || '');
  return 'pair|' +
    String(rec.cost_center || '').trim().toLowerCase() + '|' +
    String(rec.activity_type || '').trim().toLowerCase() + '|' +
    String(rec.project_cost_center || '').trim().toLowerCase() + '|' +
    String(rec.year || '');
}

function markFinanceDirty(kind) {
  if (!state.mastersDirty) state.mastersDirty = {};
  if (kind === 'costCenters') state.mastersDirty.costCenters = true;
  if (kind === 'budget') state.mastersDirty.budget = true;
  if (kind === 'booking') state.mastersDirty.booking = true;
  setDirty(true);
}

function canEditBudgetFinance() {
  return state.role === 'Admin' || roleHasProjectLead(state.role);
}

function canEditBookingFinance() {
  return state.role === 'Admin' || roleHasPeopleLead(state.role);
}

function canEditCostCentersFinance() {
  return state.role === 'Admin' || roleHasPeopleLead(state.role);
}

/** Planning rows eligible for budget/booking — same Cap Plan filter scope as Demand. */
function financeEligibleRows(year) {
  var months = monthKeysForYear(year);
  var scoped = typeof filteredRows === 'function'
    ? filteredRows('demand')
    : (state.rows || []);
  return (scoped || []).filter(function (r) {
    if (!r || isAvail(r) || isHeader(r) || isGroup(r) || isSection(r)) return false;
    var emp = r.employee_id ? state.employeeById[r.employee_id] : null;
    if (!isProjectAllocatedEmployee(emp)) return false;
    if (!r.project_id) return false;
    var hasDemand = months.some(function (mk) {
      var cell = (r.months || {})[mk] || {};
      return cell.demand != null && cell.demand !== '' && Number(cell.demand) > 0;
    });
    return hasDemand;
  });
}

function pairKeyFromParts(cc, act, pcc, year) {
  return [String(cc || '').trim().toLowerCase(), String(act || '').trim().toLowerCase(),
    String(pcc || '').trim().toLowerCase(), String(year || '')].join('|');
}

function buildFinanceContexts(year) {
  var out = [];
  financeEligibleRows(year).forEach(function (r) {
    var emp = r.employee_id ? state.employeeById[r.employee_id] : null;
    var proj = r.project_id ? state.projectById[r.project_id] : null;
    var hier = hierarchyForEmployee(emp, r);
    var attrs = resolveCostCenterAttrs(hier);
    var pcc = projectCostCenterForContext(proj, emp && emp.people_location);
    out.push({
      row: r,
      emp: emp,
      proj: proj,
      hier: hier,
      attrs: attrs,
      project_cost_center: pcc.cc,
      pcc_missing: pcc.missing,
      site: pcc.site,
      pair_key: pairKeyFromParts(attrs.internal_cost_center, attrs.internal_activity_type, pcc.cc, year),
      transfer_default: normalizeTransferType(proj && (proj.transfer_type || proj.transferType))
    });
  });
  return out;
}

function findFinanceRecord(list, kind, opts) {
  var year = opts.year;
  return (list || []).find(function (rec) {
    if (Number(rec.year) !== Number(year)) return false;
    if (String(rec.kind || 'pair') !== kind) return false;
    if (kind === 'row') return String(rec.row_id) === String(opts.row_id);
    return String(rec.cost_center || '').trim().toLowerCase() === String(opts.cost_center || '').trim().toLowerCase() &&
      String(rec.activity_type || '').trim().toLowerCase() === String(opts.activity_type || '').trim().toLowerCase() &&
      String(rec.project_cost_center || '').trim().toLowerCase() === String(opts.project_cost_center || '').trim().toLowerCase();
  }) || null;
}

function upsertFinanceRecord(listName, rec) {
  var list = state[listName] || [];
  var key = financeRecordKey(rec);
  var found = false;
  for (var i = 0; i < list.length; i++) {
    if (financeRecordKey(list[i]) === key) {
      list[i] = rec;
      found = true;
      break;
    }
  }
  if (!found) list.push(rec);
  state[listName] = list;
}

function demandByMm(row, year) {
