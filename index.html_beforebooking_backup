/** Finish any open Tabulator edit so getData() reflects the typed value. */
function commitActiveTabulatorEdit(table) {
  try {
    if (table && table.modules && table.modules.edit) {
      var edit = table.modules.edit;
      if (edit.currentCell) {
        // Prefer success path when available; otherwise blur the editor input.
        if (typeof edit.success === 'function') {
          try { edit.success(); } catch (e0) {}
