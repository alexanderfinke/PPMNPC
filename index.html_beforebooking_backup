function continueWaveLoads(mode) {
  var identity = (state._boot && state._boot.identity) || state.registeredAs || '';
  if (!state._boot) state._boot = {};
  var chain = Promise.resolve();

  // Wave 2a: Current data + snapshot row identity (fast — show structure quickly)
  if (mode.needsPortfolio && !state._boot.portfolioRowsDone && !state._boot.portfolioRowsStarted) {
    state._boot.portfolioRowsStarted = true;
    setBootProgress(62);
    setWaveStatus('Loading planning rows…');
    chain = chain.then(function () {
      return runGas('getPortfolioRowsBundle', identity, false);
    }).then(function (pack) {
      applyPortfolioWave(pack, { yearsPending: true });
      setBootProgress(78);
      setWaveStatus('Loading month values…');
      showTab(state.activeTab || mode.defaultTab);
      renderAll();
      toast('Rows ready · loading month values…');
      markLastLoadAt();
      updateStaleBanner();
    });
  }

  // Wave 2b: Current data_years + snapshot _years
  if (mode.needsPortfolio && !state._boot.portfolioYearsDone && !state._boot.portfolioYearsStarted) {
    chain = chain.then(function () {
      state._boot.portfolioYearsStarted = true;
      return runGas('getPortfolioYearsBundle', identity, false);
    }).then(function (pack) {
      applyPortfolioWave(pack, { yearsPending: false });
      state._boot.portfolioDone = true;
      setBootProgress(mode.needsFinance ? 88 : 100);
      setWaveStatus(mode.needsFinance && !state._boot.financeDone ? 'Loading budget & booking…' : '');
      showTab(state.activeTab || mode.defaultTab);
      renderAll();
      if (!mode.needsFinance || mode.id === 'resource') {
        toast('Loaded as ' + identity + ' · ' + mode.label + ' · ' + state.rows.length + ' rows');
        applyDeepLinkAfterBoot();
      }
      markLastLoadAt();
      updateStaleBanner();
    });
  }

  if ((mode.needsFinance || mode.id === 'resource') && !state._boot.financeDone && !state._boot.financeStarted) {
    chain = chain.then(function () {
      state._boot.financeStarted = true;
      return runGas('getFinanceBundle');
    }).then(function (pack) {
      applyFinanceWave(pack);
      setBootProgress(100);
      setWaveStatus('');
      if (mode.id === 'cost') {
        showTab(state.activeTab || mode.defaultTab);
        renderAll();
        toast('Loaded as ' + identity + ' · ' + mode.label);
        applyDeepLinkAfterBoot();
      } else if (typeof applyFinanceBudgetToRows === 'function') {
        applyFinanceBudgetToRows();
        if (state.activeTab === 'overview') renderOverview();
        if (state.activeTab === 'budget' && typeof renderBudget === 'function') renderBudget();
        if (state.activeTab === 'booking' && typeof renderBooking === 'function') renderBooking();
        if (state.activeTab === 'transfer' && typeof renderTransfer === 'function') renderTransfer();
      }
      markLastLoadAt();
      updateStaleBanner();
    });
  }

  chain.catch(function (e) {
    setWaveStatus('Background load issue: ' + (e && e.message ? e.message : e));
    toast('Some data failed to load — retry via refresh');
  });
  return chain;
}

