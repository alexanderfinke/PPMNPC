/**
 * Split pair month total across underarching contexts.
 * Manual row overrides kept; remainder split by demand ratio of non-edited rows.
 * Overarching (pair) value wins over row_id when pair month is set.
 */
function splitPairMonth(total, contexts, mm, rowOverrides, pairLocked) {
  var result = {};
  var demandSum = 0;
  var lockedSum = 0;
  var free = [];
  contexts.forEach(function (ctx) {
    var id = String(ctx.row.id);
    var dem = Number((ctx._demand && ctx._demand[mm]) || 0);
    demandSum += dem;
    var ov = rowOverrides[id];
    var hasOv = ov && ov[mm] != null && ov[mm] !== '';
    if (pairLocked) {
      // pair wins — ignore row overrides for display split
      free.push(ctx);
    } else if (hasOv) {
      result[id] = Number(ov[mm]);
      lockedSum += Number(ov[mm]);
    } else {
      free.push(ctx);
    }
  });
  var remaining = Number(total);
  if (!isFinite(remaining)) remaining = 0;
  if (!pairLocked) remaining = remaining - lockedSum;
  var freeDemand = free.reduce(function (s, ctx) {
    return s + Number((ctx._demand && ctx._demand[mm]) || 0);
  }, 0);
  free.forEach(function (ctx) {
    var id = String(ctx.row.id);
    var dem = Number((ctx._demand && ctx._demand[mm]) || 0);
    if (freeDemand > 1e-9) result[id] = roundFte(remaining * (dem / freeDemand));
    else result[id] = free.length ? roundFte(remaining / free.length) : 0;
  });
  return { byRow: result, demandSum: demandSum };
}

function ensurePairBudgetRecord(cc, act, pcc, year) {
  var rec = findFinanceRecord(state.budgetRecords, 'pair', {
    year: year, cost_center: cc, activity_type: act, project_cost_center: pcc
  });
  if (rec) return rec;
  rec = {
    kind: 'pair',
    row_id: '',
    cost_center: cc,
    activity_type: act,
    project_cost_center: pcc,
    year: Number(year),
    manual: false,
    months: emptyFinanceMonths()
  };
  upsertFinanceRecord('budgetRecords', rec);
  return rec;
}

function buildBudgetTree(year) {
  var contexts = buildFinanceContexts(year);
  var groups = {};
  contexts.forEach(function (ctx) {
    ctx._demand = demandByMm(ctx.row, year);
    if (ctx.attrs.missing || ctx.pcc_missing) {
      ctx._missing = true;
    }
    var key = ctx.pair_key;
    if (!groups[key]) {
      groups[key] = {
        key: key,
        cost_center: ctx.attrs.internal_cost_center,
        activity_type: ctx.attrs.internal_activity_type,
        project_cost_center: ctx.project_cost_center,
        hourly_cost: ctx.attrs.hourly_cost,
        missing: !!(ctx.attrs.missing || ctx.pcc_missing),
        contexts: [],
        transfer_default: ctx.transfer_default
      };
    }
    if (ctx.attrs.missing || ctx.pcc_missing) groups[key].missing = true;
    groups[key].contexts.push(ctx);
  });

  var rows = [];
  Object.keys(groups).sort().forEach(function (key) {
    var g = groups[key];
    var pair = findFinanceRecord(state.budgetRecords, 'pair', {
      year: year,
      cost_center: g.cost_center,
      activity_type: g.activity_type,
      project_cost_center: g.project_cost_center
    });
    var pairMonths = (pair && pair.months) || emptyFinanceMonths();
    var pairManual = !!(pair && pair.manual);
    var rowOverrides = {};
    g.contexts.forEach(function (ctx) {
      var rr = findFinanceRecord(state.budgetRecords, 'row', { year: year, row_id: ctx.row.id });
      if (rr && rr.months) rowOverrides[String(ctx.row.id)] = rr.months;
    });

    var pairDemand = emptyFinanceMonths();
    var pairBudget = emptyFinanceMonths();
    var childRows = [];

    ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].forEach(function (mm) {
      var dem = g.contexts.reduce(function (s, c) { return s + Number((c._demand[mm]) || 0); }, 0);
      pairDemand[mm] = dem;
      var total = pairMonths[mm];
      if (total == null || total === '') {
        // no pair value — use sum of row overrides if any
        var sumOv = 0;
        var anyOv = false;
        g.contexts.forEach(function (ctx) {
          var ov = rowOverrides[String(ctx.row.id)];
          if (ov && ov[mm] != null && ov[mm] !== '') {
            sumOv += Number(ov[mm]);
            anyOv = true;
          }
        });
        total = anyOv ? sumOv : null;
      }
      pairBudget[mm] = total;
      var locked = pairManual && total != null && total !== '';
      // overarching wins when pair month set
      var usePair = total != null && total !== '';
      var split = usePair
        ? splitPairMonth(total, g.contexts, mm, rowOverrides, locked || usePair)
        : { byRow: {}, demandSum: dem };
      g.contexts.forEach(function (ctx) {
        if (!ctx._budget) ctx._budget = emptyFinanceMonths();
        if (!ctx._demandMm) ctx._demandMm = emptyFinanceMonths();
        ctx._demandMm[mm] = ctx._demand[mm];
        if (usePair) ctx._budget[mm] = split.byRow[String(ctx.row.id)];
        else {
          var ov = rowOverrides[String(ctx.row.id)];
          ctx._budget[mm] = ov && ov[mm] != null && ov[mm] !== '' ? Number(ov[mm]) : null;
        }
        ctx._pairLocked = locked;
      });
    });

    rows.push({
      id: 'pair|' + key,
      _isPair: true,
      _isGroup: true,
      label: (g.cost_center || '—') + ' / ' + (g.activity_type || '—') + ' → ' + (g.project_cost_center || 'MISSING'),
      cost_center: g.cost_center,
      activity_type: g.activity_type,
      project_cost_center: g.project_cost_center,
      hourly_cost: g.hourly_cost,
      missing: g.missing,
      manual: pairManual,
      demand: pairDemand,
      budget: pairBudget,
      _children: g.contexts.map(function (ctx) {
        var projTopic = (ctx.proj && ctx.proj.project_topic) || ctx.row.project_topic || '';
        return {
          id: 'row|' + ctx.row.id,
          _isPair: false,
          row_id: ctx.row.id,
          label: (ctx.hier.name || ctx.hier.role || projTopic),
          unit: ctx.hier.unit,
          department: ctx.hier.department,
          group: ctx.hier.group,
          role: ctx.hier.role,
          name: ctx.hier.name,
          project_topic: projTopic,
          project_id: ctx.row.project_id,
          cost_center: g.cost_center,
          activity_type: g.activity_type,
          project_cost_center: g.project_cost_center,
          hourly_cost: ctx.attrs.hourly_cost,
          missing: !!(ctx.attrs.missing || ctx.pcc_missing),
          manual: !!(findFinanceRecord(state.budgetRecords, 'row', { year: year, row_id: ctx.row.id }) || {}).manual,
          pair_locked: !!ctx._pairLocked,
          demand: ctx._demand,
          budget: ctx._budget,
          _parent_key: key
        };
      })
    });
  });
  return rows;
}

function autoBookingForContext(ctx, year) {
  var alloc = allocationByMm(ctx.row, year);
  var avail = availabilityByEmpMm(ctx.row.employee_id, year);
  // total alloc vs total avail across year months for ratio when over-allocated
  var months = emptyFinanceMonths();
  Object.keys(alloc).forEach(function (mm) {
    var a = Number(alloc[mm] || 0);
    var cap = avail[mm];
    if (cap == null || cap === '') {
      months[mm] = a;
      return;
    }
    cap = Number(cap);
    // If allocation <= availability for this month, use allocation; else scale by avail/alloc
    // Spec: reduce by ratio between total availability and total allocation
    months[mm] = a;
  });
  // Apply global ratio per employee when sum(alloc) > sum(avail)
  var sumA = 0;
  var sumC = 0;
  Object.keys(alloc).forEach(function (mm) {
    sumA += Number(alloc[mm] || 0);
    if (avail[mm] != null && avail[mm] !== '') sumC += Number(avail[mm]);
  });
  var ratio = (sumA > 1e-9 && sumC > 0 && sumA > sumC) ? (sumC / sumA) : 1;
  Object.keys(months).forEach(function (mm) {
    months[mm] = roundFte(Number(months[mm] || 0) * ratio);
  });
  return months;
}

function buildBookingTree(year) {
  var contexts = buildFinanceContexts(year);
  var groups = {};
  contexts.forEach(function (ctx) {
    ctx._demand = demandByMm(ctx.row, year);
    ctx._auto = autoBookingForContext(ctx, year);
    var key = ctx.pair_key;
    if (!groups[key]) {
      groups[key] = {
        key: key,
        cost_center: ctx.attrs.internal_cost_center,
        activity_type: ctx.attrs.internal_activity_type,
        external_cost_center: ctx.attrs.external_cost_center,
        external_activity_type: ctx.attrs.external_activity_type,
        project_cost_center: ctx.project_cost_center,
        hourly_cost: ctx.attrs.hourly_cost,
        missing: !!(ctx.attrs.missing || ctx.pcc_missing),
        contexts: [],
        transfer_default: ctx.transfer_default
      };
    }
    if (ctx.attrs.missing || ctx.pcc_missing) groups[key].missing = true;
    groups[key].contexts.push(ctx);
  });

  var rows = [];
  Object.keys(groups).sort().forEach(function (key) {
    var g = groups[key];
    var pair = findFinanceRecord(state.bookingRecords, 'pair', {
      year: year,
      cost_center: g.cost_center,
      activity_type: g.activity_type,
      project_cost_center: g.project_cost_center
    });
    var pairManual = !!(pair && pair.manual);
    var transferType = normalizeTransferType((pair && pair.transfer_type) || g.transfer_default);
    var rowOverrides = {};
    g.contexts.forEach(function (ctx) {
      var rr = findFinanceRecord(state.bookingRecords, 'row', { year: year, row_id: ctx.row.id });
      if (rr) rowOverrides[String(ctx.row.id)] = rr;
    });

    var pairBooking = emptyFinanceMonths();
    var pairAuto = emptyFinanceMonths();

    ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].forEach(function (mm) {
      var autoSum = g.contexts.reduce(function (s, c) { return s + Number(c._auto[mm] || 0); }, 0);
      pairAuto[mm] = roundFte(autoSum);
      if (pairManual && pair && pair.months && pair.months[mm] != null && pair.months[mm] !== '') {
        pairBooking[mm] = Number(pair.months[mm]);
      } else {
        // sum underarching (override or auto)
        var sum = 0;
        g.contexts.forEach(function (ctx) {
          var rr = rowOverrides[String(ctx.row.id)];
          if (rr && rr.manual && rr.months && rr.months[mm] != null && rr.months[mm] !== '') {
            sum += Number(rr.months[mm]);
          } else sum += Number(ctx._auto[mm] || 0);
        });
        pairBooking[mm] = roundFte(sum);
      }
      var usePair = pairManual && pair && pair.months && pair.months[mm] != null && pair.months[mm] !== '';
      var split = usePair
        ? splitPairMonth(pairBooking[mm], g.contexts.map(function (c) {
          c._demand = c._auto; // split by auto ratio when pair locked
          return c;
        }), mm, {}, true)
        : null;
      g.contexts.forEach(function (ctx) {
        if (!ctx._booking) ctx._booking = emptyFinanceMonths();
        if (!ctx._autoShow) ctx._autoShow = emptyFinanceMonths();
        ctx._autoShow[mm] = ctx._auto[mm];
        if (usePair) {
          ctx._booking[mm] = split.byRow[String(ctx.row.id)];
          ctx._pairLocked = true;
        } else {
          var rr = rowOverrides[String(ctx.row.id)];
          if (rr && rr.manual && rr.months && rr.months[mm] != null && rr.months[mm] !== '') {
            ctx._booking[mm] = Number(rr.months[mm]);
            ctx._rowManual = true;
          } else {
            ctx._booking[mm] = ctx._auto[mm];
          }
          ctx._pairLocked = false;
        }
      });
    });

    rows.push({
      id: 'pair|' + key,
      _isPair: true,
      _isGroup: true,
      label: (g.cost_center || '—') + ' / ' + (g.activity_type || '—') + ' → ' + (g.project_cost_center || 'MISSING'),
      cost_center: g.cost_center,
      activity_type: g.activity_type,
      external_cost_center: g.external_cost_center,
      external_activity_type: g.external_activity_type,
      project_cost_center: g.project_cost_center,
      hourly_cost: g.hourly_cost,
      missing: g.missing,
      manual: pairManual,
      transfer_type: transferType,
      booking: pairBooking,
      auto: pairAuto,
      _children: g.contexts.map(function (ctx) {
        var rr = rowOverrides[String(ctx.row.id)];
        var projTopic = (ctx.proj && ctx.proj.project_topic) || ctx.row.project_topic || '';
        return {
          id: 'row|' + ctx.row.id,
          _isPair: false,
          row_id: ctx.row.id,
          label: (ctx.hier.name || ctx.hier.role || projTopic),
          unit: ctx.hier.unit,
          department: ctx.hier.department,
          group: ctx.hier.group,
          role: ctx.hier.role,
          name: ctx.hier.name,
          project_topic: projTopic,
          project_id: ctx.row.project_id,
          cost_center: g.cost_center,
          activity_type: g.activity_type,
          project_cost_center: g.project_cost_center,
          hourly_cost: ctx.attrs.hourly_cost,
          missing: !!(ctx.attrs.missing || ctx.pcc_missing),
          manual: !!(rr && rr.manual),
          pair_locked: !!ctx._pairLocked,
          transfer_type: transferType,
          booking: ctx._booking,
          auto: ctx._autoShow,
          original_auto: ctx._auto
        };
      })
    });
  });
  return rows;
}

function applyFinanceBudgetToRows() {
  var years = financeYearOptions();
  years.forEach(function (year) {
    var tree = buildBudgetTree(year);
    tree.forEach(function (pair) {
      (pair._children || []).forEach(function (ch) {
        var row = findRow(ch.row_id);
        if (!row) return;
        row.months = row.months || {};
        monthKeysForYear(year).forEach(function (mk) {
          var mm = financeMm(mk);
          var cell = row.months[mk] || { demand: null, allocation: null, employee: null, budget: null };
          var b = ch.budget && ch.budget[mm];
          cell.budget = b == null || b === '' ? null : Number(b);
          row.months[mk] = cell;
        });
      });
    });
  });
}

function financeMonthColumns(prefix, unit, opts) {
