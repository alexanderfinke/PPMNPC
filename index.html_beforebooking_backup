  var data = tree.map(function (p) {
    var root = Object.assign({}, p);
    ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].forEach(function (mm) {
      root['k_' + mm] = p.booking ? p.booking[mm] : null;
      root['auto_' + mm] = p.auto ? p.auto[mm] : null;
    });
    root.unit = '';
    root.department = '';
    root.group = '';
    root.role = '';
    root.name = '';
    root.project_topic = '';
    root._children = (p._children || []).map(function (c) {
      var ch = Object.assign({}, c);
      ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].forEach(function (mm) {
        ch['k_' + mm] = c.booking ? c.booking[mm] : null;
        ch['auto_' + mm] = c.auto ? c.auto[mm] : null;
      });
      return ch;
    });
    return root;
  });
  if (state.tables.booking) {
    try { state.tables.booking.destroy(); } catch (e) {}
    state.tables.booking = null;
    host.innerHTML = '';
  }
  var cols = [
    { title: 'Cost center → Project CC', field: 'label', minWidth: 200, frozen: 1, formatter: function (cell) {
      var d = cell.getData();
      var t = cell.getValue() || '';
      var miss = d.missing ? ' <span class="ppm-budget-low">missing</span>' : '';
      var bits = [];
      if (d.manual) bits.push('manual');
      if (d.pair_locked && !d._isPair) bits.push('locked');
      return esc(t) + miss + (bits.length ? ' <span class="meta">· ' + bits.join(', ') + '</span>' : '');
    } },
    { title: 'Transfer', field: 'transfer_type', width: 90, editor: edit ? 'list' : false,
      editorParams: edit ? { values: FINANCE_TRANSFER_TYPES } : undefined,
      editable: function (cell) { return edit && !!(cell.getData() || {})._isPair; } },
    { title: 'Unit', field: 'unit', width: 70 },
    { title: 'Department', field: 'department', width: 100 },
    { title: 'Group', field: 'group', width: 90 },
    { title: 'Role', field: 'role', width: 110 },
    { title: 'Name', field: 'name', width: 110 },
    { title: 'Project / Topic', field: 'project_topic', minWidth: 120 },
    { title: 'Internal CC', field: 'cost_center', width: 95 },
    { title: 'Activity', field: 'activity_type', width: 85 },
    { title: 'Project CC', field: 'project_cost_center', width: 95 }
  ].concat(financeMonthColumns('k_', unit, {
    year: year,
    editable: function (cell) {
      if (!edit) return false;
      var d = cell.getData();
      if (d.pair_locked && !d._isPair) return false;
      return true;
    },
    onEdit: function (cell) { onBookingCellEdited(cell, year); }
  }));
  state.tables.booking = new Tabulator(host, {
    data: data,
    height: '100%',
    layout: 'fitDataStretch',
    index: 'id',
    dataTree: true,
    dataTreeChildField: '_children',
    dataTreeStartExpanded: true,
    dataTreeElementColumn: 'label',
    columns: cols,
    rowDblClick: function (e, row) {
      var d = row.getData();
      if (d && d.row_id) {
        state._focusRowId = d.row_id;
        showTab('allocation');
      }
    }
  });
  state.tables.booking.on('cellEdited', function (cell) {
    if (cell.getField() === 'transfer_type') {
      var d = cell.getData();
      if (!d._isPair || !edit) return;
      var rec = findFinanceRecord(state.bookingRecords, 'pair', {
        year: year, cost_center: d.cost_center, activity_type: d.activity_type,
        project_cost_center: d.project_cost_center
      });
      if (!rec) {
        rec = {
          kind: 'pair', row_id: '', cost_center: d.cost_center, activity_type: d.activity_type,
          project_cost_center: d.project_cost_center, year: Number(year), manual: false,
