function setDirty(v) {
  if (v) {
    if (state.historyBaseline) {
      state.undoPast.push(state.historyBaseline);
      if (state.undoPast.length > 50) state.undoPast.shift();
      state.undoFuture = [];
      state.historyBaseline = null;
    }
    if (!state._recaptureScheduled) {
      state._recaptureScheduled = true;
      setTimeout(function () {
        state._recaptureScheduled = false;
        if (!state.historyBaseline) captureHistoryBaseline();
        updateUndoButtons();
      }, 0);
    }
  } else {
    captureHistoryBaseline();
    state.undoPast = [];
    state.undoFuture = [];
  }
  state.dirty = !!v;
  var b = $('btnSave');
  b.disabled = !state.dirty;
  b.textContent = state.dirty ? 'Save changes' : 'Saved';
  updateUndoButtons();
}
function captureHistoryBaseline() {
  state.historyBaseline = {
    rows: clone(state.rows),
    deleted: (state._deleted || []).slice()
  };
}
function updateUndoButtons() {
  var canUndo = state.undoPast.length > 0;
  var canRedo = state.undoFuture.length > 0;
  document.querySelectorAll('[data-act="undo"], #btnUndo').forEach(function (el) {
    el.disabled = !canUndo;
  });
  document.querySelectorAll('[data-act="redo"], #btnRedo').forEach(function (el) {
    el.disabled = !canRedo;
  });
}
function isTypingTarget(el) {
  if (!el) return false;
  var tag = (el.tagName || '').toLowerCase();
  if (tag === 'input' || tag === 'textarea' || tag === 'select') return true;
  if (el.isContentEditable) return true;
  if (el.closest && el.closest('.tabulator-editing')) return true;
  return false;
}
function undoPortfolio() {
  if (!state.undoPast.length) return;
  var previous = state.undoPast.pop();
  state.undoFuture.unshift({ rows: clone(state.rows), deleted: (state._deleted || []).slice() });
  if (state.undoFuture.length > 50) state.undoFuture.pop();
  state.rows = previous.rows;
  state._deleted = previous.deleted || [];
  state.historyBaseline = null;
  state.dirty = true;
  var b = $('btnSave');
  b.disabled = false;
  b.textContent = 'Save changes';
