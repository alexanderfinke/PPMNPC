/** Apply a master-grid cell edit into state and mark dirty (Tabulator 6 event API). */
function applyTopicsCellEdit(cell) {
  var d = cell.getData();
  var field = cell.getField();
  var val = cell.getValue();
  if (!d || d.id == null || !field) return;
  var found = false;
  for (var i = 0; i < state.projects.length; i++) {
    if (String(state.projects[i].id) !== String(d.id)) continue;
    state.projects[i][field] = val;
    found = true;
    break;
  }
  if (!found) return;
  if (field === 'portfolio') noteMetaValue('Portfolio', val);
  if (field === 'category') noteMetaValue('Category', val);
  if (field === 'program') noteMetaValue('Program', val);
  if (field === 'status') noteMetaValue('Status', val);
  if (field === 'project_location') noteMetaValue('Location', val);
  if (field === 'project_lead') {
    noteMetaValue('Project Lead', val);
    syncAutoProjectLeadsLocal();
  }
  if (field === 'project_topic') noteMetaValue('Project / Topic', val);
  if (field === 'transfer_type') {
    state.projects.forEach(function (p) {
