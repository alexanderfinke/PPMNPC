/* ----- gaps / exceptions ----- */
var GAP_TYPE_META = {
  unfilled: { label: 'Unfilled demand', short: 'Unfilled', jump: 'demand' },
  overassign: { label: 'Overassignment', short: 'Overassign', jump: 'demand' },
  capacity: { label: 'Over capacity', short: 'Capacity', jump: 'allocation' },
  unattended: { label: 'Unattended', short: 'Unattended', jump: 'demand' }
};

function defaultGapTypes() {
  return { unfilled: true, overassign: true, capacity: true, unattended: true };
}

function ensureGapState() {
  if (!state.gaps || typeof state.gaps !== 'object') state.gaps = { types: defaultGapTypes() };
  if (!state.gaps.types || typeof state.gaps.types !== 'object') state.gaps.types = defaultGapTypes();
  return state.gaps;
}

function statusGapWeight(row) {
  var project = row.project_id ? state.projectById[row.project_id] : null;
  var st = normalizeStatusKey((project && project.status) || row.status || '');
  if (st === 'active') return 1.5;
  if (st === 'budgeted') return 1.25;
  if (st === 'closing') return 1.15;
  if (st === 'proposal') return 0.7;
  if (st === 'on hold') return 0.55;
  if (st === 'completed') return 0.35;
  return 1;
}

function rowLooksUnattended(row) {
  if (!row || isHeader(row) || isAvail(row) || isSection(row) || isGroup(row)) return false;
  var name = String(row.name || '').trim();
  if (!row.employee_id) return true;
  if (NN_RE.test(name)) return true;
  if (NEW_HIRE_RE.test(name)) return true;
  if (!rowHasNamedEmployee(row)) return true;
  return false;
}

function formatGapMonthSpan(months) {
  if (!months || !months.length) return '';
  var first = monthLabel(months[0].length === 7 ? months[0] + '-01' : months[0]);
  if (months.length === 1) return first;
  var last = monthLabel(months[months.length - 1].length === 7 ? months[months.length - 1] + '-01' : months[months.length - 1]);
  return first + ' → ' + last + ' (' + months.length + ')';
}

function gapRowContext(row) {
  var project = row.project_id ? state.projectById[row.project_id] : null;
  var employee = row.employee_id ? state.employeeById[row.employee_id] : null;
  return {
    project: row.project_topic || (project && project.project_topic) || '—',
    name: row.name || (employee && employee.name) || '—',
    role: row.role || (employee && employee.role) || '—',
    department: roleDepartmentFromRole(row.role || (employee && employee.role) || '') ||
      (employee && (employee.group_name || employee.department)) || '—',
    status: (project && project.status) || row.status || '—'
  };
}

function scoreGapFinding(severity, duration, weight) {
  var sev = Math.max(0, Number(severity) || 0);
  var dur = Math.max(1, Number(duration) || 1);
  var w = Number(weight) || 1;
  return roundFte(sev * w * (1 + 0.12 * (dur - 1)));
}

function collectGapFindings() {
  ensureGapState();
  refreshAnalysis();
  var delta = Number(state.settings.colorDelta) || 0;
  var months = state.months || [];
  var showDel = state.settings.showDeletedRows !== false;
  var rows = applyGlobalFilters(state.rows).filter(function (r) {
    if (isPendingDelete(r) && !showDel) return false;
    return true;
  });
  var capacity = state.capacity || {};
  var assigned = state.assigned || {};
  var findings = [];
  var availByEmp = {};
  var planningByEmp = {};

  rows.forEach(function (row) {
    if (isHeader(row) || isSection(row) || isGroup(row)) return;
    var ek = empKey(row.employee_id);
    if (isAvail(row)) {
      if (ek) availByEmp[ek] = row;
      return;
    }
    if (ek) {
      if (!planningByEmp[ek]) planningByEmp[ek] = row;
    }

    var ctx = gapRowContext(row);
    var weight = statusGapWeight(row);
    var unfilledMonths = [];
    var unfilledSum = 0;
    var unfilledMax = 0;
    var unfilledWorst = '';
    var overMonths = [];
    var overSum = 0;
    var overMax = 0;
    var overWorst = '';
    var demandSum = 0;
    var hasDemand = false;
    var hasAlloc = false;

    months.forEach(function (month) {
      var key = monthKey(month);
      var mk = ym(month);
      var cell = (row.months && (row.months[key] || row.months[month] || row.months[mk])) || {};
      var dem = cell.demand == null || cell.demand === '' ? null : Number(cell.demand);
      var allo = cell.allocation == null || cell.allocation === '' ? null : Number(cell.allocation);
      if (dem != null && !isNaN(dem) && dem > 0) {
        hasDemand = true;
        demandSum += dem;
      }
      if (allo != null && !isNaN(allo) && allo > 0) hasAlloc = true;

      if (dem != null && !isNaN(dem) && greaterByDelta(dem, allo == null || isNaN(allo) ? 0 : allo, delta)) {
        var ugap = dem - (allo == null || isNaN(allo) ? 0 : allo);
        unfilledMonths.push(mk);
        unfilledSum += ugap;
        if (ugap >= unfilledMax) {
          unfilledMax = ugap;
          unfilledWorst = mk;
        }
      }
      if (allo != null && !isNaN(allo) && greaterByDelta(allo, dem == null || isNaN(dem) ? 0 : dem, delta)) {
        var ogap = allo - (dem == null || isNaN(dem) ? 0 : dem);
        overMonths.push(mk);
        overSum += ogap;
        if (ogap >= overMax) {
          overMax = ogap;
          overWorst = mk;
        }
      }
    });

    if (unfilledMonths.length) {
      findings.push({
        id: 'gap_unfilled_' + row.id,
        type: 'unfilled',
        rowId: row.id,
        jumpTab: 'demand',
        severity: roundFte(unfilledSum),
        duration: unfilledMonths.length,
        worstMonth: unfilledWorst,
        worstGap: roundFte(unfilledMax),
        months: unfilledMonths,
        score: scoreGapFinding(unfilledSum, unfilledMonths.length, weight),
        project: ctx.project,
        name: ctx.name,
        role: ctx.role,
        department: ctx.department,
        status: ctx.status,
        detail: 'Demand exceeds allocation by ' + roundFte(unfilledSum).toFixed(1) + ' FTE-months'
      });
    }
    if (overMonths.length) {
      findings.push({
        id: 'gap_over_' + row.id,
        type: 'overassign',
        rowId: row.id,
        jumpTab: 'demand',
        severity: roundFte(overSum),
        duration: overMonths.length,
        worstMonth: overWorst,
        worstGap: roundFte(overMax),
        months: overMonths,
        score: scoreGapFinding(overSum, overMonths.length, weight),
        project: ctx.project,
        name: ctx.name,
        role: ctx.role,
        department: ctx.department,
        status: ctx.status,
        detail: 'Allocation exceeds demand by ' + roundFte(overSum).toFixed(1) + ' FTE-months'
      });
    }
    if (rowLooksUnattended(row) && (hasDemand || hasAlloc)) {
      var uSev = hasDemand ? demandSum : 0;
      findings.push({
        id: 'gap_unatt_' + row.id,
        type: 'unattended',
        rowId: row.id,
        jumpTab: 'demand',
        severity: roundFte(uSev),
        duration: months.filter(function (month) {
          var key = monthKey(month);
          var mk = ym(month);
          var cell = (row.months && (row.months[key] || row.months[month] || row.months[mk])) || {};
          var dem = cell.demand == null || cell.demand === '' ? 0 : Number(cell.demand);
          var allo = cell.allocation == null || cell.allocation === '' ? 0 : Number(cell.allocation);
          return (dem > 0) || (allo > 0);
        }).length || 1,
        worstMonth: '',
        worstGap: roundFte(uSev),
        months: [],
        score: scoreGapFinding(Math.max(uSev, 0.5), 1, weight * 1.1),
        project: ctx.project,
        name: ctx.name,
        role: ctx.role,
        department: ctx.department,
        status: ctx.status,
        detail: !row.employee_id
          ? 'No linked employee on a staffed planning row'
          : (NN_RE.test(String(row.name || '').trim()) || NEW_HIRE_RE.test(String(row.name || '').trim())
            ? 'Placeholder / open name on active demand'
            : 'Name not linked to Employees master')
      });
    }
  });

  var empIds = {};
  Object.keys(availByEmp).forEach(function (k) { empIds[k] = 1; });
  Object.keys(planningByEmp).forEach(function (k) { empIds[k] = 1; });

  Object.keys(empIds).forEach(function (emp) {
    var capMonths = [];
    var capSum = 0;
    var capMax = 0;
    var capWorst = '';
    months.forEach(function (month) {
      var mk = ym(month);
      var cap = capacity[emp + '|' + mk];
      if (cap == null || cap === '') return;
      var asg = assigned[emp + '|' + mk];
      if (asg == null || asg === '') asg = 0;
      if (greaterByDelta(Number(asg), Number(cap), delta)) {
        var gap = Number(asg) - Number(cap);
        capMonths.push(mk);
        capSum += gap;
        if (gap >= capMax) {
          capMax = gap;
          capWorst = mk;
        }
      }
    });
    if (!capMonths.length) return;
    var jumpRow = availByEmp[emp] || planningByEmp[emp];
    if (!jumpRow) return;
    var empRec = state.employeeById[emp] || state.employeeById[jumpRow.employee_id];
    var ctx2 = gapRowContext(jumpRow);
    if (empRec && empRec.name) ctx2.name = empRec.name;
    findings.push({
      id: 'gap_cap_' + emp,
      type: 'capacity',
      rowId: jumpRow.id,
      jumpTab: 'allocation',
      severity: roundFte(capSum),
      duration: capMonths.length,
      worstMonth: capWorst,
      worstGap: roundFte(capMax),
      months: capMonths,
      score: scoreGapFinding(capSum, capMonths.length, 1.35),
      project: ctx2.project,
      name: ctx2.name,
      role: ctx2.role,
      department: ctx2.department,
      status: ctx2.status,
      detail: '∑ allocation exceeds availability by ' + roundFte(capSum).toFixed(1) + ' FTE-months'
    });
  });

  findings.sort(function (a, b) {
    if (b.score !== a.score) return b.score - a.score;
    if (b.severity !== a.severity) return b.severity - a.severity;
    return String(a.project).localeCompare(String(b.project));
  });
  findings.forEach(function (f, i) { f.rank = i + 1; });
  return findings;
}

function filteredGapFindings(allFindings) {
  var types = ensureGapState().types;
  var all = allFindings || collectGapFindings();
  return all.filter(function (f) {
    return types[f.type] !== false;
  }).map(function (f, i) {
    var copy = Object.assign({}, f);
    copy.rank = i + 1;
    return copy;
  });
}

function renderGapTypeChips() {
  var host = $('gapTypeChips');
  if (!host) return;
  var types = ensureGapState().types;
  host.innerHTML = Object.keys(GAP_TYPE_META).map(function (key) {
    var meta = GAP_TYPE_META[key];
    var on = types[key] !== false;
    return '<button type="button" class="gap-chip' + (on ? ' active' : '') + '" data-gap-type="' + key + '">' +
      esc(meta.short) + '</button>';
  }).join('');
  host.onclick = function (e) {
    var btn = e.target.closest('[data-gap-type]');
    if (!btn) return;
    var key = btn.getAttribute('data-gap-type');
    var g = ensureGapState();
    g.types[key] = g.types[key] === false;
    var anyOn = Object.keys(GAP_TYPE_META).some(function (k) { return g.types[k] !== false; });
    if (!anyOn) g.types[key] = true;
    renderGaps();
  };
}

function jumpToGapFinding(finding) {
  if (!finding || !finding.rowId) {
    toast('No row to open');
    return;
  }
  var tab = finding.jumpTab || (GAP_TYPE_META[finding.type] && GAP_TYPE_META[finding.type].jump) || 'demand';
  state._focusRowId = finding.rowId;
  state.selectedId = finding.rowId;
  showTab(tab);
  softRefreshTables(false);
  toast('Opened in ' + (tab === 'allocation' ? 'Resource Allocation' : 'Capacity Demand'));
}

/** Open a row from email deep link (?row=&tab=) injected by doGet. */
function applyDeepLinkAfterBoot() {
  var deep = window.__CAPPLAN_DEEP_LINK;
  if (!deep || !deep.row) return;
  window.__CAPPLAN_DEEP_LINK = null;
  var rowId = String(deep.row).trim();
  if (!rowId) return;
  var tab = String(deep.tab || '').toLowerCase() === 'allocation' ? 'allocation' : 'demand';
  var row = findRow(rowId);
  if (!row && !isNaN(Number(rowId))) row = findRow(Number(rowId));
  if (row && row.id != null) rowId = row.id;
  if (row && isAvail(row)) tab = 'allocation';
  state._focusRowId = rowId;
  state._focusCollapseOthers = true;
  state.selectedId = rowId;
  showTab(tab);
  softRefreshTables(false);
  toast(row
    ? ('Opened row in ' + (tab === 'allocation' ? 'Resource Allocation' : 'Capacity Demand'))
    : 'Deep link row not found — filters may hide it');
}

function renderGaps() {
  ensureGapState();
  renderGapTypeChips();
  var all = collectGapFindings();
  var findings = filteredGapFindings(all);
  var byType = { unfilled: 0, overassign: 0, capacity: 0, unattended: 0 };
  var sevByType = { unfilled: 0, overassign: 0, capacity: 0, unattended: 0 };
  all.forEach(function (f) {
    byType[f.type] = (byType[f.type] || 0) + 1;
    sevByType[f.type] = (sevByType[f.type] || 0) + (f.severity || 0);
  });

  var kpiHost = $('gaps-kpis');
  if (kpiHost) {
    kpiHost.innerHTML =
      '<div class="card"><b>' + findings.length + '</b><span>Shown findings</span></div>' +
      '<div class="card"><b>' + byType.unfilled + '</b><span>Unfilled · ' + sevByType.unfilled.toFixed(1) + ' FTE-mo</span></div>' +
      '<div class="card"><b>' + byType.overassign + '</b><span>Overassign · ' + sevByType.overassign.toFixed(1) + ' FTE-mo</span></div>' +
      '<div class="card"><b>' + byType.capacity + '</b><span>Capacity · ' + sevByType.capacity.toFixed(1) + ' FTE-mo</span></div>' +
