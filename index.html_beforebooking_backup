function duplicateSelected() {
  if (state.role === 'Employee' || roleIsViewerOnly(state.role)) { toast(roleIsViewerOnly(state.role) ? 'Viewer is read-only' : 'Read-only for Employee role'); return; }
  var mode = state.activeTab === 'allocation' ? 'allocation' : 'demand';
  var ids = collectSelectedRowIds(mode);
  var srcId = ids[0] || state.selectedId;
  var row = findRow(srcId);
  if (!row || isPendingDelete(row)) { toast('Select a row first'); return; }
  if (roleHasProjectLead(state.role) && state.role !== 'Admin' && !rowInProjectLeadScope(row)) {
    toast('Only allowed for your own projects');
    return;
  }
  var copy = clone(row);
  copy.id = newRowId();
  copy._pendingDelete = false;
  placeNewRowAfter(copy, row, mode);
  state._focusRowId = copy.id;
  state.selectedId = copy.id;
  refreshAnalysis();
  setDirty(true);
  softRefreshTables();
}

function collectSelectedRowIds(mode) {
  var ids = [];
  var seen = {};
  var table = state.tables[mode];
  if (table) {
    tableRanges(table).forEach(function (range) {
      (range.getRows ? range.getRows() : []).forEach(function (row) {
        var d = row.getData();
        if (isGroup(d) || isSection(d) || isEphemeral(d.id)) return;
        if (seen[d.id]) return;
        seen[d.id] = 1;
        ids.push(d.id);
      });
    });
  }
  if (!ids.length && state.selectedId && !isEphemeral(state.selectedId)) {
    ids.push(state.selectedId);
  }
  return ids;
}

function markRowDeleted(id) {
  state._deleted = state._deleted || [];
  if (state._deleted.indexOf(id) < 0) state._deleted.push(id);
}

function deleteSelected() {
  if (state.role === 'Employee' || roleIsViewerOnly(state.role)) { toast(roleIsViewerOnly(state.role) ? 'Viewer is read-only' : 'Read-only for Employee role'); return; }
  var mode = state.activeTab === 'allocation' ? 'allocation' : 'demand';
  var ids = collectSelectedRowIds(mode).filter(function (id) { return !isEphemeral(id); });
  if (!ids.length) { toast('Select a row first'); return; }
  if (roleHasProjectLead(state.role) && state.role !== 'Admin') {
    var blocked = ids.some(function (id) {
      var row = findRow(id);
      return row && !rowInProjectLeadScope(row);
    });
    if (blocked) {
      toast('Only allowed for your own projects');
      return;
    }
  }

  var soft = [];
  var hard = [];
  ids.forEach(function (id) {
    var row = findRow(id);
    if (!row) return;
    if (isPendingDelete(row)) return;
    if (rowHasSnapshotData(id)) soft.push(id);
    else hard.push(id);
  });
  if (!soft.length && !hard.length) {
    toast('Selected rows are already marked deleted');
    return;
  }

  var msg = 'Delete ' + (soft.length + hard.length) + ' row(s)?';
  if (soft.length && hard.length) {
    msg = 'Delete ' + hard.length + ' new row(s) and mark ' + soft.length +
      ' snapshot row(s) as deleted (strikethrough until save)?';
  } else if (soft.length) {
    msg = 'Mark ' + soft.length + ' row(s) as deleted? They stay visible (strikethrough) until you save' +
      (state.settings.showDeletedRows === false ? '' : ' — hide via Settings if needed') + '.';
  }
  if (!confirm(msg)) return;

  hard.forEach(function (id) {
    state.rows = state.rows.filter(function (r) { return r.id !== id; });
    markRowDeleted(id);
  });
  soft.forEach(function (id) {
    var row = findRow(id);
    if (row) row._pendingDelete = true;
    markRowDeleted(id);
  });

  if (hard.indexOf(state.selectedId) >= 0 || soft.indexOf(state.selectedId) >= 0) {
    state.selectedId = null;
  }
  refreshAnalysis();
  setDirty(true);
  softRefreshTables(true);
  var bits = [];
  if (hard.length) bits.push(hard.length + ' removed');
  if (soft.length) bits.push(soft.length + ' struck through');
  toast('Deleted: ' + bits.join(', '));
}

function deleteSelectedTopicFromDemand() {
  if (state.role !== 'Admin') { toast('Admin only'); return; }
  var row = findRow(state.selectedId);
  var projectId = row && row.project_id;
  if (!projectId) {
    // try selected group
    var t = state.tables.demand;
    if (t) {
      var sel = t.getSelectedRows && t.getSelectedRows()[0];
      if (sel) projectId = sel.getData().project_id;
    }
  }
  if (!projectId) { toast('Select a row in a project first'); return; }
  var topic = state.projectById[projectId];
  var label = (topic && topic.project_topic) || projectId;
  if (!confirm('Delete topic "' + label + '" and all related demand/timeline rows?')) return;
  var related = state.rows.filter(function (r) { return r.project_id === projectId; }).map(function (r) { return r.id; });
  state.rows = state.rows.filter(function (r) { return r.project_id !== projectId; });
  state._deleted = (state._deleted || []).concat(related);
  state.projects = state.projects.filter(function (p) { return p.id !== projectId; });
  syncAutoProjectLeadsLocal();
  rebuildLookups();
  google.script.run.withSuccessHandler(function (data) {
    onBoot(data);
    toast('Topic deleted');
  }).withFailureHandler(function (e) {
    setDirty(true);
    softRefreshTables(true);
    toast(e && e.message ? e.message : 'Topic removed locally — save portfolio to persist row deletes');
  }).deleteProject(projectId, currentActingIdentity() || '', loadForceRegistered());
}

