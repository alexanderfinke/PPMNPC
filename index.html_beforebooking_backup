function forceEditCell(cell) {
  if (!cell) return;
  try {
    var table = cell.getTable && cell.getTable();
    if (table && table.modules && table.modules.edit && table.modules.edit.cancelEdit) {
      table.modules.edit.cancelEdit();
    }
  } catch (e) {}
  try {
    if (typeof cell.edit === 'function') cell.edit(true);
  } catch (e2) {}
  requestAnimationFrame(function () {
    try {
      var el = cell.getElement && cell.getElement();
      var input = el && el.querySelector && el.querySelector('input, textarea');
      if (input) {
        input.focus();
        input.select();
      }
    } catch (e3) {}
  });
}

function bindCellEditInteractions(table, mode) {
  table.on('cellEdited', function (cell) {
    var field = cell.getField();
    if (isMonthField(field)) {
      onMonthEdited(cell);
      return;
    }
    if (syncIdentityFromCell(cell)) {
      // Keep lookup mirrors in sync without a full table rebuild.
      try { cell.getRow().reformat(); } catch (e) {}
    }
  });
  table.on('cellClick', function (e, cell) {
    var target = e.target;
    if (target && target.closest && target.closest('.tabulator-data-tree-control')) return;
    if (target && target.closest && target.closest('.ppm-drag-grip')) return;
    var field = cell.getField();
    if (!field || field === '_drag') return;
    var rowData = cell.getData();
    if (isSection(rowData) || isGroup(rowData)) return;
    if (!isEphemeral(rowData.id)) state.selectedId = rowData.id;

    var extendRange = e.shiftKey || e.ctrlKey || e.metaKey;
    if (extendRange) {
      state.selectedListCellKey[mode] = null;
      return;
    }

    var key = String(rowData.id) + ':' + field;
    var openEdit = function () {
      window.setTimeout(function () {
        var live = findTableRow(table, rowData.id);
        var liveCell = live && live.getCell(field);
        if (!liveCell) return;
        var d = liveCell.getData();
        var src = findRow(d.id) || d;
        if (isMonthField(field)) {
          var kind = monthFieldKind(field) || 'demand';
          if (!canEditMonth(state.role, kind, src)) return;
          forceEditCell(liveCell);
          return;
        }
        var ed = liveCell.getColumn().getDefinition().editable;
        var ok = typeof ed === 'function' ? ed(liveCell) : !!ed;
        if (ok) forceEditCell(liveCell);
      }, 50);
    };

    if (isListPickerCell(cell)) {
      var already = state.selectedListCellKey[mode] === key;
      state.selectedListCellKey[mode] = key;
      if (already) openEdit();
      return;
    }

    // Month values (incl. Avail/Dmnd capacity): open editor after selection settles
    if (isMonthField(field)) {
      state.selectedListCellKey[mode] = key;
      openEdit();
      return;
    }

    if (cell.getColumn().getDefinition().editable) {
      state.selectedListCellKey[mode] = null;
      openEdit();
    } else {
      state.selectedListCellKey[mode] = null;
    }
  });

  table.on('cellDblClick', function (e, cell) {
    var field = cell.getField();
    if (!field || field === '_drag') return;
    var rowData = cell.getData();
    if (isSection(rowData) || isGroup(rowData)) return;
    state.selectedListCellKey[mode] = String(rowData.id) + ':' + field;
    window.setTimeout(function () {
      var live = findTableRow(table, rowData.id);
      var liveCell = live && live.getCell(field);
      if (!liveCell) return;
      if (isMonthField(field)) {
        var kind = monthFieldKind(field) || 'demand';
        if (!canEditMonth(state.role, kind, findRow(rowData.id) || rowData)) return;
      }
      forceEditCell(liveCell);
    }, 40);
  });

  // F2 / Enter starts edit on the active range cell (Excel-like)
  table.element.addEventListener('keydown', function (e) {
    if (e.key !== 'F2' && e.key !== 'Enter') return;
    if (isTypingTarget(e.target)) return;
    var ranges = tableRanges(table);
    if (!ranges.length) return;
    var cells = ranges[0].getCells ? ranges[0].getCells() : [];
    var active = cells[0] && cells[0][0];
    if (!active) return;
    var field = active.getField();
    if (!isMonthField(field) && !isListPickerCell(active)) return;
    e.preventDefault();
    var d = active.getData();
    var live = findTableRow(table, d.id);
    var liveCell = live && live.getCell(field);
    if (!liveCell) return;
    if (isMonthField(field)) {
      var kind = monthFieldKind(field) || 'demand';
      if (!canEditMonth(state.role, kind, findRow(d.id) || d)) return;
    }
    forceEditCell(liveCell);
  });
}

function softRefreshTables(forceColumns) {
  var focusId = state._focusRowId;
  var collapseOthers = !!state._focusCollapseOthers;
  state._focusCollapseOthers = false;
  var scrolls = focusId ? null : {
    demand: captureScroll('demand'),
    allocation: captureScroll('allocation')
  };
  ['demand', 'allocation'].forEach(function (mode) {
    ensureTable(mode, !!forceColumns);
    if (scrolls) restoreScroll(mode, scrolls[mode]);
  });
  // Keep finance tabs in sync with Cap Plan portfolio / filters
  if (typeof applyFinanceBudgetToRows === 'function') applyFinanceBudgetToRows();
  if (state.activeTab === 'costcenters' && typeof renderCostCenters === 'function') renderCostCenters();
  if (state.activeTab === 'budget' && typeof renderBudget === 'function') renderBudget();
  if (state.activeTab === 'booking' && typeof renderBooking === 'function') renderBooking();
  if (state.activeTab === 'transfer' && typeof renderTransfer === 'function') renderTransfer();
  if (focusId) {
    state._focusRowId = null;
    setTimeout(function () {
      if (collapseOthers) {
        var mode = state.activeTab === 'allocation' ? 'allocation' : 'demand';
        treeExpandAll(mode, false);
      }
      focusRowInGrids(focusId);
    }, 50);
  }
}

function ensureTable(mode, forceColumns) {
  var host = $('grid-' + mode);
  var sig = columnsSignature(mode);
  var needNew = !state.tables[mode] || forceColumns || state.columnsSig[mode] !== sig;

  if (needNew) {
    if (state.tables[mode]) {
      try { state.tables[mode].destroy(); } catch (e) {}
      state.tables[mode] = null;
      host.innerHTML = '';
    }
    state.columnsSig[mode] = sig;
    var identityCols = buildIdentityColumns(mode);
    var treeCol = (identityCols[0] && identityCols[0].field) || 'displayName';
    var opts = {
      data: buildTreeData(mode),
      columns: buildColumns(mode),
      layout: 'fitDataStretch',
      height: '100%',
      renderVertical: 'virtual',
      dataTree: true,
      dataTreeChildField: '_children',
      dataTreeStartExpanded: true,
      dataTreeElementColumn: treeCol,
      index: 'id',
      editTriggerEvent: 'dblclick',
      selectableRange: true,
      selectableRangeInitializeDefault: false,
      selectableRangeClearCells: false,
      selectableRangeClearCellsValue: null,
      selectableRangeAutoFocus: false,
      clipboard: true,
      clipboardCopyStyled: false,
      clipboardCopyRowRange: 'range',
      clipboardPasteParser: 'range',
      clipboardCopyConfig: { columnHeaders: false, columnGroups: false, rowHeaders: false, columnCalcs: false, formatCells: false },
      clipboardPasteAction: function (pasteRows) {
        var table = (this && this.table) || state.tables[mode];
        applyPasteToRange(table, pasteRows || []);
        return [];
      },
      movableRows: false,
      movableRowsConnectedTables: false,
      placeholder: 'No rows',
      rowFormatter: rowFormatter,
      rowClick: function (e, row) {
        var d = row.getData();
        if (!isGroup(d) && !isSection(d)) {
          state.selectedId = d.id;
          selectWholeTableRow(state.tables[mode], row);
        }
      },
      cellEdited: function (cell) {
        var field = cell.getField();
        if (isMonthField(field)) return;
        if (syncIdentityFromCell(cell)) {
          // Light refresh for linked lookup columns only when project/name/role change
          if (field === 'project_topic' || field === 'name' || field === 'role' ||
              field === 'alternative_financing' || String(field).indexOf('lk_') === 0) {
            softRefreshTables();
          }
        }
      }
    };
    if (mode === 'demand') {
      // Tabulator movableRows does not work reliably with dataTree — custom HTML5 DnD instead
      opts.movableRows = false;
    }
    state.tables[mode] = new Tabulator(host, opts);
    host.classList.add('ppm');
    bindClipboard(state.tables[mode], mode);
    bindCellEditInteractions(state.tables[mode], mode);
    if (mode === 'demand') bindDemandRowReorder(state.tables[mode]);
  } else {
    state.tables[mode].replaceData(buildTreeData(mode));
  }
}

/** Resolve a demand planning row id from a drop/drag DOM event. */
function demandRowIdFromDomEvent(table, e) {
  var t = e && e.target;
  if (!t || !t.closest) return null;
  // Direct hit on grip
  var grip = t.closest('.ppm-drag-grip[data-row-id]');
  if (grip) return String(grip.getAttribute('data-row-id'));
  var rowEl = t.closest('.tabulator-row');
  if (!rowEl) return null;
  // Grip inside the hovered row
  grip = rowEl.querySelector('.ppm-drag-grip[data-row-id]');
  if (grip) return String(grip.getAttribute('data-row-id'));
  // data-row-id stamped on the row element
  if (rowEl.getAttribute('data-row-id')) return String(rowEl.getAttribute('data-row-id'));
  // Tabulator APIs
  try {
    if (table.getRowFromEvent) {
      var r1 = table.getRowFromEvent(e);
      if (r1) {
        var d1 = r1.getData();
        if (d1 && d1.id != null) return String(d1.id);
      }
    }
  } catch (err1) {}
  try {
    if (table.getRowFromElement) {
      var r2 = table.getRowFromElement(rowEl);
      if (r2) {
        var d2 = r2.getData();
        if (d2 && d2.id != null) return String(d2.id);
      }
    }
  } catch (err2) {}
  return null;
}

/** Custom drag-and-drop reorder for Capacity Demand (within one project only). */
function bindDemandRowReorder(table) {
  if (!table || !table.element) return;
  var el = table.element;
  if (el._ppmReorderBound) return;
  el._ppmReorderBound = true;
  var dragId = null;
  var dragProjectId = null;

  el.addEventListener('dragstart', function (e) {
    var grip = e.target && e.target.closest && e.target.closest('.ppm-drag-grip');
    if (!grip) return;
    var id = grip.getAttribute('data-row-id');
    var row = findRow(id);
    if (!row) {
      toast('Drag start failed: row not found');
      e.preventDefault();
      return;
    }
    if (roleHasProjectLead(state.role) && state.role !== 'Admin' && !rowInProjectLeadScope(row)) {
      toast('Drag blocked: not your project');
      e.preventDefault();
      return;
    }
    dragId = String(id);
    dragProjectId = String(row.project_id || '');
    e.dataTransfer.effectAllowed = 'move';
    try { e.dataTransfer.setData('text/plain', dragId); } catch (err) {}
    toast('Drag start: ' + dragId);
  });

  el.addEventListener('dragover', function (e) {
    if (!dragId) return;
    var rowEl = e.target && e.target.closest && e.target.closest('.tabulator-row');
    if (!rowEl) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    el.querySelectorAll('.ppm-drag-over').forEach(function (n) { n.classList.remove('ppm-drag-over'); });
    rowEl.classList.add('ppm-drag-over');
  });

  el.addEventListener('dragleave', function (e) {
    var rowEl = e.target && e.target.closest && e.target.closest('.tabulator-row');
    if (rowEl) rowEl.classList.remove('ppm-drag-over');
  });

  el.addEventListener('drop', function (e) {
    el.querySelectorAll('.ppm-drag-over').forEach(function (n) { n.classList.remove('ppm-drag-over'); });
    if (!dragId) return;
    e.preventDefault();
    e.stopPropagation();

    var targetId = demandRowIdFromDomEvent(table, e);
    if (!targetId) {
      toast('Drop ignored: could not resolve target row');
      dragId = null;
      return;
    }
    var target = findRow(targetId);
    // Group/section headers: insert at end of that project if same project
    if (!target || isGroup({ id: targetId, _isGroup: String(targetId).indexOf('__project_root__') === 0 }) ||
        isSection({ id: targetId }) || isEphemeral(targetId)) {
      var tableRow = null;
      try {
        if (table.getRowFromEvent) tableRow = table.getRowFromEvent(e);
        else if (table.getRowFromElement && e.target.closest) {
          tableRow = table.getRowFromElement(e.target.closest('.tabulator-row'));
        }
      } catch (err) {}
      var td = tableRow ? tableRow.getData() : null;
      if (td && isGroup(td) && String(td.project_id || '') === dragProjectId) {
        // Drop on project folder → move to end of that project
        var siblings = state.rows.filter(function (r) {
          return !isEphemeral(r.id) && String(r.project_id || '') === dragProjectId &&
            String(r.id) !== dragId;
        }).sort(function (a, b) {
          return (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0);
        });
        var last = siblings[siblings.length - 1];
        if (last) {
          toast('Drop on project header → move to end');
          reorderDemandRowBeforeOrAfter(dragId, last.id, { clientY: 1e9, target: e.target });
        } else {
          toast('Drop ignored: empty project');
        }
        dragId = null;
        dragProjectId = null;
        return;
      }
      toast('Drop ignored: target is not a reorderable data row');
      dragId = null;
      return;
    }
    if (!target) {
      toast('Drop ignored: target row not in portfolio');
      dragId = null;
      return;
    }
    var targetProject = String(target.project_id || '');
    if (String(targetId) === dragId) {
      toast('Drop ignored: same row');
      dragId = null;
      return;
    }
    if (dragProjectId && targetProject && dragProjectId !== targetProject) {
      toast('Rows can only be reordered within the same project');
      dragId = null;
      softRefreshTables();
      return;
    }
    // Same project (or missing ids) — this is the intended case
    toast('Drop within project → reorder');
    reorderDemandRowBeforeOrAfter(dragId, targetId, e);
    dragId = null;
    dragProjectId = null;
  });

  el.addEventListener('dragend', function () {
    el.querySelectorAll('.ppm-drag-over').forEach(function (n) { n.classList.remove('ppm-drag-over'); });
    dragId = null;
    dragProjectId = null;
  });
}

/** Place movedId before/after targetId within the same project, then persist sort_order. */
function reorderDemandRowBeforeOrAfter(movedId, targetId, evt) {
  var moved = findRow(movedId);
  var target = findRow(targetId);
  if (!moved || !target) {
    toast('Reorder failed: row missing');
    return;
  }
  var pid = String(moved.project_id || '');
  if (String(target.project_id || '') !== pid) {
    toast('Rows can only be reordered within the same project');
    return;
  }
  var siblings = state.rows.filter(function (r) {
    return !isEphemeral(r.id) && String(r.project_id || '') === pid;
  }).slice().sort(function (a, b) {
    return (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0) ||
      String(a.id).localeCompare(String(b.id));
  });
  var without = siblings.filter(function (r) { return String(r.id) !== String(movedId); });
  var targetIdx = -1;
  for (var i = 0; i < without.length; i++) {
    if (String(without[i].id) === String(targetId)) { targetIdx = i; break; }
  }
  if (targetIdx < 0) {
    toast('Reorder failed: target not in project');
    return;
  }
  var insertAt = targetIdx;
  if (evt && evt.clientY != null) {
    var rowEl = evt.target && evt.target.closest && evt.target.closest('.tabulator-row');
    if (rowEl) {
      var rect = rowEl.getBoundingClientRect();
      if (evt.clientY > rect.top + rect.height / 2) insertAt = targetIdx + 1;
    }
  }
  without.splice(insertAt, 0, moved);
  var orderedIds = without.map(function (r) { return String(r.id); });
  applyDemandSortOrderFromIds(orderedIds, pid);
  if (!state._sortOrderTouched) state._sortOrderTouched = {};
  orderedIds.forEach(function (id) { state._sortOrderTouched[id] = true; });
  setDirty(true);
  toast('Reorder saved locally · ' + orderedIds.length + ' rows · dirty=' + !!state.dirty);
  softRefreshTables();
}

function treeExpandAll(mode, expand) {
  var t = state.tables[mode];
  if (!t) return;
  t.getRows().forEach(function (row) {
    if (expand) row.treeExpand();
    else row.treeCollapse();
  });
}

/* ----- actions ----- */
function handleAction(act, mode) {
  if (!guardProjectLeadAction(mode, act)) return;
  if ((state.role === 'Employee' || roleIsViewerOnly(state.role)) &&
      ['addRow', 'addTimeline', 'addPerson', 'dup', 'del', 'delTopic', 'fillDA', 'fillAD', 'level'].indexOf(act) >= 0) {
    toast(roleIsViewerOnly(state.role) ? 'Viewer is read-only' : 'Read-only for Employee role');
    return;
  }
  if (act === 'expand') treeExpandAll(mode, true);
  else if (act === 'collapse') treeExpandAll(mode, false);
  else if (act === 'fillDA') fillDemandToAllocation(mode);
  else if (act === 'fillAD') fillMonths(mode, 'allocation', 'demand');
  else if (act === 'addRow') addRow(mode, 'Demand/Allocation');
  else if (act === 'addTimeline') addRow('demand', 'Timeline/Header');
  else if (act === 'addPerson') addPerson();
  else if (act === 'dup') duplicateSelected();
  else if (act === 'del') deleteSelected();
  else if (act === 'delTopic') deleteSelectedTopicFromDemand();
  else if (act === 'undo') undoPortfolio();
  else if (act === 'redo') redoPortfolio();
  else if (act === 'ovExpand' || act === 'ovCollapse') {
    overviewTreeExpandAll(act === 'ovExpand');
  }
  else if (act === 'level') {
    levelSelectedResources(mode);
  }
  else if (act === 'notify') {
    openNotifyDialog(mode);
  }
}

function ensureMonthCell(row, key) {
  if (!row.months) row.months = {};
  if (!row.months[key]) row.months[key] = emptyMonthCell();
  var cell = row.months[key];
  if (cell.employee === undefined) cell.employee = null;
  if (cell.budget === undefined) cell.budget = null;
  return cell;
}

function monthAllocValue(cell) {
  if (!cell || cell.allocation == null || cell.allocation === '') return null;
  return Number(cell.allocation);
}

function monthDemandValue(cell) {
  if (!cell || cell.demand == null || cell.demand === '') return null;
  return Number(cell.demand);
}

/**
 * Fit allocation to demand (selected cells):
 * Set each selected cell's allocation toward its demand, but never use more than
 * free availability (= availability − allocations on non-selected rows).
 * Handles both over-alloc (reduce) and under-alloc / empty (increase).
 */
function fillDemandToAllocation(mode) {
  var sel = selectedRangeMeta(mode);
  if (!sel || !sel.rowIds.length) {
    toast('Select cells to fit');
    return;
  }
  var monthList = sel.months.length
    ? sel.months.map(function (mk) { return monthKey(mk); })
    : state.months.map(monthKey);
  var selectedPair = {};
  sel.rowIds.forEach(function (id) {
    monthList.forEach(function (key) {
      selectedPair[String(id) + '|' + ym(key)] = true;
    });
  });

  var changed = 0;
  var byEmpMonth = {};

  state.rows.forEach(function (r) {
    if (isAvail(r) || isHeader(r)) return;
    var emp = empKey(r.employee_id);
    if (!emp) return;
    var included = countsTowardTotalAlloc(r);
    monthList.forEach(function (key) {
      var m = ym(key);
      var isSel = !!selectedPair[String(r.id) + '|' + m];
      if (!included && !isSel) return;
      var bucket = emp + '|' + m;
      if (!byEmpMonth[bucket]) {
        byEmpMonth[bucket] = { totalAlloc: 0, selectedAlloc: 0, candidates: [] };
      }
      var cell = r.months && (r.months[key] || r.months[m]);
      var a = monthAllocValue(cell);
      if (included && a != null) byEmpMonth[bucket].totalAlloc += a;

      if (!isSel) return;
      if (!canEditMonth(state.role, 'allocation', r)) return;
      var d = monthDemandValue(cell);
      if (d == null || !(d >= 0) || isNaN(d)) return;
      var cur = a == null ? 0 : a;
      if (included) byEmpMonth[bucket].selectedAlloc += cur;
      byEmpMonth[bucket].candidates.push({
        row: r,
        month: key,
        demand: d,
        current: cur
      });
    });
  });

  Object.keys(byEmpMonth).forEach(function (bucket) {
    var pack = byEmpMonth[bucket];
    if (!pack.candidates.length) return;
    var parts = bucket.split('|');
    var emp = parts[0];
    var m = parts[1];
    var avail = state.capacity[emp + '|' + m];
    if (avail == null || avail === '') avail = 1;
    avail = Number(avail);
    if (isNaN(avail) || avail < 0) avail = 1;

    var nonSelected = pack.totalAlloc - pack.selectedAlloc;
    var free = avail - nonSelected;
    if (free < 0) free = 0;

    var selectedDemand = pack.candidates.reduce(function (s, c) { return s + c.demand; }, 0);
    if (!(selectedDemand > 1e-9) && free < 1e-9) {
      // All demands zero and no free capacity — zero out selected allocs if needed
      pack.candidates.forEach(function (c) {
        var cell = ensureMonthCell(c.row, c.month);
        if (cell.allocation != null && cell.allocation !== 0) {
          cell.allocation = 0;
          changed++;
        }
      });
      return;
    }

    // Target each cell at its demand, scaled down if demand sum exceeds free availability
    var fitScale = selectedDemand > 1e-9
      ? (free >= selectedDemand - 1e-9 ? 1 : free / selectedDemand)
      : 0;

    pack.candidates.forEach(function (c) {
      var next = Math.round(c.demand * fitScale * 100) / 100;
      var cell = ensureMonthCell(c.row, c.month);
      var prev = cell.allocation;
      if (prev !== next) {
        cell.allocation = next;
        changed++;
      }
    });
  });

  refreshAnalysis();
  if (!changed) {
    toast('No allocation changes in the selection');
    return;
  }
  setDirty(true);
  softRefreshTables();
  toast('Fit allocation to demand: updated ' + changed + ' cell(s)');
}

function fillMonths(mode, from, to) {
  var sel = selectedRangeMeta(mode);
  if (!sel || !sel.rowIds.length) {
    toast('Select cells to fill');
    return;
  }
  var monthList = sel.months.length
    ? sel.months.map(function (mk) { return monthKey(mk); })
    : state.months.map(monthKey);
  var n = 0;
  sel.rowIds.forEach(function (id) {
    var r = findRow(id);
    if (!r) return;
    if (isHeader(r) || isAvail(r)) return;
    if (!canEditMonth(state.role, to, r)) return;
    monthList.forEach(function (key) {
      var cell = r.months[key] || r.months[ym(key)] || { demand: null, allocation: null };
      if (cell[from] == null) return;
      if (cell[to] === cell[from]) return;
      if (!r.months[key]) r.months[key] = { demand: null, allocation: null };
      r.months[key][to] = cell[from];
      n++;
    });
  });
  if (!n) {
    toast('No editable cells in selection to fill');
    return;
  }
  refreshAnalysis();
  setDirty(true);
  softRefreshTables();
  toast((to === 'demand' ? 'Fit demand to allocation: updated ' : 'Updated ') + n + ' cell(s)');
}

function levelSelectedResources(mode) {
  var sel = selectedRangeMeta(mode || 'allocation');
  if (!sel || !sel.rowIds.length) {
    toast('Select cells to level');
    return;
  }
  var monthList = sel.months.length ? sel.months.slice() : state.months.map(ym);
  var selectedPair = {};
  sel.rowIds.forEach(function (id) {
    monthList.forEach(function (mk) { selectedPair[String(id) + '|' + ym(mk)] = true; });
  });

  var capacity = state.capacity;
  var changed = 0;

  monthList.forEach(function (mk) {
    var m = ym(mk);
    var byEmp = {};
    // Include planning rows for totals when status counts toward ∑ Alloc;
    // selected rows can still be leveled even if their status is currently excluded.
    state.rows.forEach(function (r) {
      if (isAvail(r) || isHeader(r)) return;
      var emp = empKey(r.employee_id);
      if (!emp) return;
      var included = countsTowardTotalAlloc(r);
      var isSel = !!selectedPair[String(r.id) + '|' + m];
      if (!included && !isSel) return;
      var key = monthKey(m);
      var cell = r.months && (r.months[key] || r.months[m]);
      var a = monthAllocValue(cell);
      var d = monthDemandValue(cell);
      if (!byEmp[emp]) byEmp[emp] = { sumIncluded: 0, selected: [] };
      if (included) byEmp[emp].sumIncluded += (a == null ? 0 : a);
      if (isSel) {
        byEmp[emp].selected.push({
          row: r,
          month: key,
          alloc: a == null ? 0 : a,
          demand: d,
          included: included
        });
      }
    });

    Object.keys(byEmp).forEach(function (emp) {
      var pack = byEmp[emp];
      var selected = pack.selected.filter(function (x) {
        return canEditMonth(state.role, 'allocation', x.row);
      });
      if (!selected.length) return;

      var selectedIncludedAlloc = selected.reduce(function (s, x) {
        return s + (x.included ? x.alloc : 0);
      }, 0);
      var selectedDemand = selected.reduce(function (s, x) {
        return s + (x.demand != null && !isNaN(x.demand) ? x.demand : 0);
      }, 0);
      if (!(selectedDemand > 1e-9)) return;

      var totalCapacity = capacity[emp + '|' + m];
      if (totalCapacity == null || totalCapacity === '') totalCapacity = 1;
      totalCapacity = Number(totalCapacity);
      if (isNaN(totalCapacity) || totalCapacity < 0) totalCapacity = 1;

      // Reserve non-selected allocations that count toward ∑ Alloc; selected cells share remaining capacity
      // weighted by selected demand (works for under- and over-allocation):
      //   target = totalCapacity - (sumIncluded - selectedIncludedAlloc)
      //   scale  = target / selectedDemand
      //   newAlloc = demand * scale
      var nonSelected = pack.sumIncluded - selectedIncludedAlloc;
      var target = totalCapacity - nonSelected;
      if (target < 0) target = 0;
      var scale = target / selectedDemand;

      selected.forEach(function (x) {
        var demand = x.demand != null && !isNaN(x.demand) ? x.demand : 0;
        var next = Math.round(demand * scale * 100) / 100;
        var cell = ensureMonthCell(x.row, x.month);
        if (cell.allocation !== next) {
          cell.allocation = next;
          changed++;
        }
      });
    });
  });

  refreshAnalysis();
  if (!changed) {
    toast('Nothing to level in the selected cells');
    return;
  }
  setDirty(true);
  softRefreshTables();
  toast('Leveled ' + changed + ' allocation cell(s)');
}

function resolveProjectContext(anchor) {
  if (!anchor) {
    return {
      project_id: null,
      project_topic: null,
      alternative_financing: null,
      alternative_financing_topic: null
    };
  }
  var project_id = anchor.project_id || null;
  var project_topic = anchor.project_topic || null;
  var alternative_financing = anchor.alternative_financing || null;
  var alternative_financing_topic = anchor.alternative_financing_topic || null;
  var gk = anchor.group_key || anchor._groupKey || '';
  if (!project_id && String(gk).indexOf('p:') === 0) {
    project_id = String(gk).slice(2) || null;
  }
  if (!project_id && isGroup(anchor) && String(anchor.id || '').indexOf('__project_root__p:') === 0) {
    project_id = String(anchor.id).replace('__project_root__p:', '') || null;
  }
  if (!project_topic && anchor.group_label) project_topic = String(anchor.group_label).trim() || null;
  if (project_id && !project_topic && state.projectById[project_id]) {
    project_topic = state.projectById[project_id].project_topic || null;
  }
  if (alternative_financing && !alternative_financing_topic && state.projectById[alternative_financing]) {
    alternative_financing_topic = state.projectById[alternative_financing].project_topic || null;
  }
  return {
    project_id: project_id,
    project_topic: project_topic,
    alternative_financing: alternative_financing,
    alternative_financing_topic: alternative_financing_topic
  };
}

function resolveAllocationEmployeeContext(anchor) {
  if (!anchor) return { employee_id: null, name: null, role: null };
  if (anchor.employee_id) {
    var emp = state.employeeById[anchor.employee_id];
    return {
      employee_id: anchor.employee_id,
      name: (emp && emp.name) || anchor.name || null,
      role: anchor.role || (emp && emp.role) || null
    };
  }
  var name = String(anchor.name || '').trim();
  var role = String(anchor.role || '').trim();
  if (name) {
    var avail = state.rows.find(function (r) {
      return isAvail(r) &&
        String(r.name || '').trim() === name &&
        (String(r.role || '').trim() || '(no role)') === (role || '(no role)');
    });
    if (avail && avail.employee_id) {
      return {
        employee_id: avail.employee_id,
        name: avail.name || name,
        role: avail.role || anchor.role || null
      };
    }
    var byName = state.employees.find(function (e) { return e.name === name; });
    if (byName) {
      return { employee_id: byName.id, name: byName.name, role: anchor.role || byName.role || null };
    }
  }
  // Allocation tree root is often the availability row itself
  if (isAvail(anchor) && anchor.employee_id) {
    return { employee_id: anchor.employee_id, name: anchor.name, role: anchor.role };
  }
  return { employee_id: anchor.employee_id || null, name: anchor.name || null, role: anchor.role || null };
}

function demandGroupKey(row) {
  if (!row) return 't:none';
  if (row.project_id) return 'p:' + row.project_id;
  return 't:' + (row.project_topic || 'none');
}

function allocationGroupKey(row) {
  if (!row) return 'n:|';
  if (row.employee_id) return 'e:' + row.employee_id;
  return 'n:' + (String(row.name || '').trim() || '') + '|' + (String(row.role || '').trim() || '');
}

function rowGroupKeyForMode(row, mode) {
  return mode === 'allocation' ? allocationGroupKey(row) : demandGroupKey(row);
}

function orderedGroupMembers(rows, mode, gk) {
  return rows.filter(function (r) {
    return rowGroupKeyForMode(r, mode) === gk;
  }).slice().sort(function (a, b) {
    if (mode === 'allocation' && a.is_availability !== b.is_availability) {
      return a.is_availability ? -1 : 1;
    }
    return (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0) ||
      String(a.id).localeCompare(String(b.id));
  });
}

function resolveInsertAfterId(anchor, mode) {
  if (!anchor) return null;
  // Tree chrome (project folder / section): place after last row in that group
  if (isGroup(anchor) || isSection(anchor) || isEphemeral(anchor.id)) {
    var gk = anchor.group_key || anchor._groupKey || rowGroupKeyForMode(anchor, mode);
    var members = orderedGroupMembers(state.rows, mode, gk);
    if (!members.length) return null;
    return members[members.length - 1].id;
  }
  if (findRow(anchor.id)) return anchor.id;
  return null;
}

function nextSortOrderInGroup(rows, mode, gk) {
  var max = 0;
  orderedGroupMembers(rows, mode, gk).forEach(function (r) {
    max = Math.max(max, Math.trunc(Number(r.sort_order) || 0));
  });
  return max + 1;
}

/** Insert row directly below `afterId` and renumber sort_order within the tree group. */
function insertRowBelow(afterId, newRow, mode) {
  var after = findRow(afterId);
  var flatIdx = -1;
  for (var i = 0; i < state.rows.length; i++) {
    if (state.rows[i].id === afterId) { flatIdx = i; break; }
  }
  if (!after || flatIdx < 0) {
    newRow.sort_order = nextSortOrderInGroup(state.rows, mode, rowGroupKeyForMode(newRow, mode));
    state.rows.push(newRow);
    return;
  }

  var afterGk = rowGroupKeyForMode(after, mode);
  var newGk = rowGroupKeyForMode(newRow, mode);
  if (newGk !== afterGk) {
    // Keep visual adjacency under the selection; tree grouping uses fields, not array order
    newRow.sort_order = nextSortOrderInGroup(state.rows, mode, newGk);
    state.rows.splice(flatIdx + 1, 0, newRow);
    return;
  }

  var groupMembers = orderedGroupMembers(state.rows, mode, afterGk);
  var idx = -1;
  for (var j = 0; j < groupMembers.length; j++) {
    if (groupMembers[j].id === afterId) { idx = j; break; }
  }
  if (idx < 0) {
    state.rows.splice(flatIdx + 1, 0, newRow);
    return;
  }

  var merged = groupMembers.slice(0, idx + 1).concat([newRow], groupMembers.slice(idx + 1));
  merged.forEach(function (r, n) { r.sort_order = n + 1; });

  var memberIds = {};
  groupMembers.forEach(function (r) { memberIds[r.id] = 1; });
  var out = [];
  var placed = false;
  state.rows.forEach(function (r) {
    if (memberIds[r.id]) {
      if (!placed) {
        out.push.apply(out, merged);
        placed = true;
      }
      return;
    }
    out.push(r);
  });
  if (!placed) out.push.apply(out, merged);
  state.rows = out;
}

function getAddAnchor(mode) {
  var table = state.tables[mode];
  if (table) {
    var ranges = tableRanges(table);
    if (ranges[0] && ranges[0].getRows) {
      var picked = ranges[0].getRows()[0];
      if (picked) {
        var pd = picked.getData();
        if (pd) {
          if (isGroup(pd) || isSection(pd)) return pd;
          return findRow(pd.id) || pd;
        }
      }
    }
  }
  if (state.selectedId) {
    var row = findRow(state.selectedId);
    if (row) return row;
  }
  return null;
}

function buildRowFromAnchor(mode, source, anchor) {
  var row = {
    id: newRowId(),
    sort_order: 0,
    source: source,
    version: 'Cur',
    project_id: null,
    project_topic: null,
    alternative_financing: null,
    alternative_financing_topic: null,
    workpackage: null,
    role: null,
    employee_id: null,
    name: null,
    notes_project_lead: null,
    notes_people_lead: null,
    notes_employee: null,
    comments: null,
    changed_by: null,
    updated_at: null,
    change_history: [],
    is_availability: source === 'Availability',
    is_header: source === 'Timeline/Header',
    months: {},
    phases: {}
  };

  if (source === 'Timeline/Header') {
    Object.assign(row, resolveProjectContext(anchor));
    row.role = null;
    row.employee_id = null;
    row.name = null;
    return row;
  }

  if (source === 'Demand/Allocation' && mode === 'demand') {
    Object.assign(row, resolveProjectContext(anchor));
    row.role = null;
    row.employee_id = null;
    row.name = 'NN';
    if (anchor && anchor.role) {
      row.role = anchor.role;
      ensureNnEmployeeForRole(row, anchor.role);
    }
    return row;
  }

  if (source === 'Demand/Allocation' && mode === 'allocation') {
    Object.assign(row, resolveAllocationEmployeeContext(anchor));
    row.project_id = null;
    row.project_topic = null;
    row.alternative_financing = null;
    row.alternative_financing_topic = null;
    return row;
  }

  if (source === 'Availability' && anchor) {
    Object.assign(row, resolveAllocationEmployeeContext(anchor));
  }
  return row;
}

function placeNewRowAfter(row, anchor, mode) {
  mode = mode || 'demand';
  if (!anchor) {
    row.sort_order = nextSortOrderInGroup(state.rows, mode, rowGroupKeyForMode(row, mode));
    state.rows.push(row);
    return;
  }
  var afterId = resolveInsertAfterId(anchor, mode);
  if (!afterId) {
    row.sort_order = nextSortOrderInGroup(state.rows, mode, rowGroupKeyForMode(row, mode));
    state.rows.push(row);
    return;
  }
  insertRowBelow(afterId, row, mode);
}

function addRow(mode, source) {
