  var unit = ($('budgetUnit') && $('budgetUnit').value) || 'fte';
  var edit = canEditBudgetFinance();
  applyFinanceBudgetToRows();
  var tree = buildBudgetTree(year);
  // Cap Plan-style tree: pair roots with underarching resource rows
  var data = tree.map(function (p) {
    var root = Object.assign({}, p);
    ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].forEach(function (mm) {
      root['b_' + mm] = p.budget ? p.budget[mm] : null;
      root['d_' + mm] = p.demand ? p.demand[mm] : null;
    });
    root.unit = '';
    root.department = '';
    root.group = '';
    root.role = '';
    root.name = '';
    root.project_topic = '';
    root._children = (p._children || []).map(function (c) {
      var ch = Object.assign({}, c);
      ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].forEach(function (mm) {
        ch['b_' + mm] = c.budget ? c.budget[mm] : null;
        ch['d_' + mm] = c.demand ? c.demand[mm] : null;
      });
      return ch;
    });
    return root;
  });
  if (state.tables.budget) {
    try { state.tables.budget.destroy(); } catch (e) {}
    state.tables.budget = null;
    host.innerHTML = '';
  }
  var cols = [
    { title: 'Cost center → Project CC', field: 'label', minWidth: 200, frozen: 1, formatter: function (cell) {
      var d = cell.getData();
      var t = cell.getValue() || '';
      var miss = d.missing ? ' <span class="ppm-budget-low">missing</span>' : '';
      var man = d.manual ? ' <span class="meta">· manual</span>' : '';
      return esc(t) + miss + man;
    } },
    { title: 'Unit', field: 'unit', width: 70 },
    { title: 'Department', field: 'department', width: 100 },
    { title: 'Group', field: 'group', width: 90 },
    { title: 'Role', field: 'role', width: 110 },
    { title: 'Name', field: 'name', width: 110 },
    { title: 'Project / Topic', field: 'project_topic', minWidth: 120 },
    { title: 'Internal CC', field: 'cost_center', width: 95 },
    { title: 'Activity', field: 'activity_type', width: 85 },
    { title: 'Project CC', field: 'project_cost_center', width: 95 }
  ].concat(financeMonthColumns('b_', unit, {
    year: year,
    editable: function (cell) {
      if (!edit) return false;
      var d = cell.getData();
      if (d.pair_locked && !d._isPair) return false;
      return true;
    },
    compareField: 'd_',
    onEdit: function (cell) {
      onBudgetCellEdited(cell, year);
    }
  }));
  state.tables.budget = new Tabulator(host, {
    data: data,
    height: '100%',
    layout: 'fitDataStretch',
    index: 'id',
    dataTree: true,
    dataTreeChildField: '_children',
    dataTreeStartExpanded: true,
    dataTreeElementColumn: 'label',
    columns: cols,
    rowDblClick: function (e, row) {
      var d = row.getData();
      if (d && d.row_id) {
        state._focusRowId = d.row_id;
        showTab('demand');
      }
    }
  });
  host.classList.add('ppm');
}

function onBudgetCellEdited(cell, year) {
  if (!canEditBudgetFinance()) return;
  var d = cell.getData();
  var field = cell.getField();
  if (field.indexOf('b_') !== 0) return;
  var mm = field.slice(2);
  var val = cell.getValue();
  val = val === '' || val == null ? null : Number(val);
  if (d._isPair) {
    var rec = ensurePairBudgetRecord(d.cost_center, d.activity_type, d.project_cost_center, year);
    rec.months = rec.months || emptyFinanceMonths();
    rec.months[mm] = val;
    rec.manual = true;
    upsertFinanceRecord('budgetRecords', rec);
  } else {
    var rec2 = findFinanceRecord(state.budgetRecords, 'row', { year: year, row_id: d.row_id });
    if (!rec2) {
      rec2 = {
        kind: 'row', row_id: String(d.row_id), cost_center: d.cost_center || '',
        activity_type: d.activity_type || '', project_cost_center: d.project_cost_center || '',
        year: Number(year), manual: true, months: emptyFinanceMonths()
      };
    }
    rec2.months = rec2.months || emptyFinanceMonths();
    rec2.months[mm] = val;
    rec2.manual = true;
    upsertFinanceRecord('budgetRecords', rec2);
  }
  markFinanceDirty('budget');
  applyFinanceBudgetToRows();
  setTimeout(function () { renderBudget(); }, 0);
}

function renderBooking() {
