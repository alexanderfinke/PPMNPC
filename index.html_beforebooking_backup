function getSelectedMasterData(tableKey, selectedId) {
  var table = state.tables[tableKey];
  if (table) {
    try {
      var rows = table.getSelectedRows && table.getSelectedRows();
      if (rows && rows.length) return rows[0].getData();
    } catch (e) {}
  }
  if (selectedId == null || selectedId === '') return null;
  if (tableKey === 'topics') {
    for (var i = 0; i < state.projects.length; i++) {
      if (state.projects[i].id === selectedId) return state.projects[i];
    }
  } else if (tableKey === 'employees') {
    for (var j = 0; j < state.employees.length; j++) {
      if (state.employees[j].id === selectedId) return state.employees[j];
    }
  } else if (tableKey === 'access') {
    for (var k = 0; k < state.access.length; k++) {
      if (state.access[k].id === selectedId) return state.access[k];
    }
  }
  return null;
}

