function staleDaysSinceLoad() {
  var at = readLastLoadAt();
  if (!at) return 0;
  var ms = Date.now() - at;
  if (ms < 24 * 60 * 60 * 1000) return 0;
  return Math.max(1, Math.floor(ms / (24 * 60 * 60 * 1000)));
}

