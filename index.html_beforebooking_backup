  } else {
    var rec2 = findFinanceRecord(state.bookingRecords, 'row', { year: year, row_id: d.row_id });
    if (!rec2) {
      rec2 = {
        kind: 'row', row_id: String(d.row_id), cost_center: d.cost_center || '',
        activity_type: d.activity_type || '', project_cost_center: d.project_cost_center || '',
        year: Number(year), manual: true, months: emptyFinanceMonths(),
        auto_months: d.original_auto || d.auto || emptyFinanceMonths(),
        transfer_type: normalizeTransferType(d.transfer_type)
      };
    }
    rec2.months = rec2.months || emptyFinanceMonths();
    rec2.auto_months = d.original_auto || d.auto || rec2.auto_months || emptyFinanceMonths();
    rec2.months[mm] = val;
    rec2.manual = true;
    upsertFinanceRecord('bookingRecords', rec2);
  }
  markFinanceDirty('booking');
  setTimeout(function () { renderBooking(); }, 0);
}

function buildTransferRows(year, unit, split99, typeFilter) {
  var tree = buildBookingTree(year);
  var out = [];
  tree.forEach(function (pair) {
    var tt = normalizeTransferType(pair.transfer_type);
    if (tt === 'finance' || tt === 'none') return;
    if (typeFilter && typeFilter !== 'all' && tt !== typeFilter) return;
    if (pair.missing) return;

    function pushLine(cc, act, pcc, months, transferType, note) {
      var vals = {};
      var any = false;
      Object.keys(months || {}).forEach(function (mm) {
        var fte = months[mm];
        if (fte == null || fte === '') return;
        var v = unit === 'hours' ? Number(fte) * FTE_HOURS : Number(fte);
        vals[mm] = roundFte(v);
        if (Math.abs(v) > 1e-9) any = true;
      });
      if (!any) return;
      if (split99 && unit === 'hours') {
        // Split each month independently into chunks of 99
        var chunks = [emptyFinanceMonths()];
        Object.keys(vals).forEach(function (mm) {
          var left = Number(vals[mm] || 0);
          var idx = 0;
          while (left > TRANSFER_SPLIT_HOURS + 1e-9) {
            if (!chunks[idx]) chunks[idx] = emptyFinanceMonths();
            chunks[idx][mm] = TRANSFER_SPLIT_HOURS;
            left = roundFte(left - TRANSFER_SPLIT_HOURS);
            idx++;
          }
          if (!chunks[idx]) chunks[idx] = emptyFinanceMonths();
          chunks[idx][mm] = left;
        });
        chunks.forEach(function (m, i) {
          out.push({
            id: pair.id + '|' + transferType + '|' + cc + '|' + act + '|' + i + (note || ''),
            transfer_type: transferType,
            cost_center: cc,
            activity_type: act,
            project_cost_center: pcc,
            months: m,
            note: note || ''
          });
        });
      } else {
        out.push({
          id: pair.id + '|' + transferType + '|' + cc + '|' + act + (note || ''),
          transfer_type: transferType,
          cost_center: cc,
          activity_type: act,
          project_cost_center: pcc,
          months: vals,
          note: note || ''
        });
      }
    }

    if (tt === 'direct') {
      pushLine(pair.cost_center, pair.activity_type, pair.project_cost_center, pair.booking, 'direct');
    } else if (tt === 'indirect') {
      // Internal → external (same dept pair), then external → project CC
      pushLine(pair.cost_center, pair.activity_type, pair.external_cost_center, pair.booking, 'indirect', '|leg1');
      pushLine(pair.external_cost_center, pair.external_activity_type, pair.project_cost_center, pair.booking, 'indirect', '|leg2');
    }
  });
  return out;
}

function renderTransfer() {
  var host = $('grid-transfer');
  if (!host) return;
  fillFinanceYearSelects();
  var year = Number(($('transferYear') && $('transferYear').value) || financeYearOptions()[0]);
  var unit = ($('transferUnit') && $('transferUnit').value) || 'hours';
  var split99 = !!($('transferSplit99') && $('transferSplit99').checked);
  var typeFilter = ($('transferTypeFilter') && $('transferTypeFilter').value) || 'all';
  var rows = buildTransferRows(year, unit, split99, typeFilter);
  var data = rows.map(function (r) {
    var o = {
      id: r.id,
      transfer_type: r.transfer_type,
      cost_center: r.cost_center,
      activity_type: r.activity_type,
      project_cost_center: r.project_cost_center
    };
    ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].forEach(function (mm) {
      o['t_' + mm] = r.months[mm];
    });
    return o;
  });
  if (state.tables.transfer) {
    try { state.tables.transfer.destroy(); } catch (e) {}
    state.tables.transfer = null;
    host.innerHTML = '';
  }
  var monthCols = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'].map(function (mm) {
    var label = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][Number(mm) - 1];
    return { title: label, field: 't_' + mm, width: 70, hozAlign: 'right', headerSort: false };
  });
  state.tables.transfer = new Tabulator(host, {
    data: data,
    height: '100%',
    layout: 'fitDataStretch',
    index: 'id',
    columns: [
      { title: 'Transfer Type', field: 'transfer_type', width: 110 },
      { title: 'Cost Center', field: 'cost_center', width: 120 },
      { title: 'Activity Type', field: 'activity_type', width: 120 },
      { title: 'Project Cost Center', field: 'project_cost_center', width: 140 }
    ].concat(monthCols)
  });
  host.classList.add('ppm');
}

function wireFinanceUi() {
  if ($('btnAddCostCenter')) {
    $('btnAddCostCenter').onclick = function () {
      if (!canEditCostCentersFinance()) { toast('People Lead / Admin only'); return; }
      var id = 'CC_' + Math.random().toString(36).slice(2, 10);
      state.costCenters = state.costCenters || [];
      state.costCenters.push({
        id: id, level: 'role', level_value: '',
        internal_cost_center: '', internal_activity_type: '',
        external_cost_center: '', external_activity_type: '',
        rbs_skill_name: '', hourly_cost: ''
      });
      state.selectedCostCenterId = id;
      markFinanceDirty('costCenters');
      renderCostCenters();
    };
  }
  if ($('btnDeleteCostCenter')) {
    $('btnDeleteCostCenter').onclick = function () {
      if (!canEditCostCentersFinance()) { toast('People Lead / Admin only'); return; }
      var id = state.selectedCostCenterId;
      if (!id) { toast('Select a row'); return; }
      state.costCenters = (state.costCenters || []).filter(function (c) { return String(c.id) !== String(id); });
      state.selectedCostCenterId = null;
      markFinanceDirty('costCenters');
      renderCostCenters();
    };
  }
  ['budgetYear', 'budgetUnit'].forEach(function (id) {
    if ($(id)) $(id).onchange = function () { renderBudget(); };
  });
  ['bookingYear', 'bookingUnit'].forEach(function (id) {
    if ($(id)) $(id).onchange = function () { renderBooking(); };
  });
  ['transferYear', 'transferUnit', 'transferTypeFilter'].forEach(function (id) {
    if ($(id)) $(id).onchange = function () { renderTransfer(); };
  });
  if ($('transferSplit99')) $('transferSplit99').onchange = function () { renderTransfer(); };
  if ($('btnBudgetRecalc')) {
    $('btnBudgetRecalc').onclick = function () {
      applyFinanceBudgetToRows();
      renderBudget();
      toast('Budget split recalculated');
    };
  }
  if ($('btnBookingRecalc')) {
    $('btnBookingRecalc').onclick = function () {
      // Drop non-manual auto rows so next render refreshes from allocation
      state.bookingRecords = (state.bookingRecords || []).filter(function (r) {
        return !!r.manual;
      });
      markFinanceDirty('booking');
      renderBooking();
      toast('Auto booking recalculated (manual kept)');
    };
  }
  document.querySelectorAll('[data-act="gotoDemand"]').forEach(function (btn) {
    btn.onclick = function () { showTab('demand'); };
  });
  document.querySelectorAll('[data-act="gotoAllocation"]').forEach(function (btn) {
    btn.onclick = function () { showTab('allocation'); };
  });
}

wireFinanceUi();
/* END FINANCE */

if (typeof Tabulator === 'undefined') {
  $('boot').textContent = 'Tabulator failed to load from CDN. Allow jsdelivr.net in your network, then reload.';
} else {
  boot();
}
})();
