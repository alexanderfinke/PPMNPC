<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cap Plan</title>
  <link href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/css/tabulator.min.css" rel="stylesheet">
  <style>
:root {
  --bg: #f4f4f5;
  --card: #ffffff;
  --border: #d4d4d8;
  --text: #18181b;
  --muted: #71717a;
  --accent: #2563eb;
  --danger: #dc2626;
  --under: #0284c7;
  --overassigned: #ea580c;
  --yellow: #fef08a;
  --yellow-regular-even: #fef3c7;
  --yellow-regular-odd: #fffbeb;
  --avail: #d4d4d8;
  --header: #c4c4c9;
  --section: #3f3f46;
  --banner-h: 0px;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  height: 100%;
  overflow: hidden;
  font-family: "Segoe UI", system-ui, sans-serif;
  background: linear-gradient(160deg, #eef2ff 0%, #f4f4f5 40%, #ecfeff 100%);
  color: var(--text);
}

#local-banner { flex-shrink: 0; }
body:has(#local-banner) {
  --banner-h: 32px;
}

.app-shell {
  height: calc(100vh - var(--banner-h));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

header {
  background: var(--card);
  border-bottom: 1px solid var(--border);
  padding: 10px 16px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  flex-shrink: 0;
}
header h1 { margin: 0; font-size: 1.25rem; letter-spacing: -0.02em; }
header p { margin: 0; font-size: 12px; color: var(--muted); }
.grow { flex: 1; }

.btn {
  border: 1px solid var(--border);
  background: var(--card);
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 13px;
  cursor: pointer;
}
.btn:hover { background: #f4f4f5; }
.btn.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
.btn.danger { color: var(--danger); border-color: #fecaca; }
.btn.primary:disabled, .btn:disabled { opacity: 0.45; cursor: default; }

.tabs {
  display: flex;
  gap: 4px;
  padding: 6px 16px 0;
  flex-wrap: wrap;
  flex-shrink: 0;
}
.tab {
  border: 1px solid transparent;
  background: transparent;
  padding: 8px 12px;
  border-radius: 8px 8px 0 0;
  cursor: pointer;
  font-size: 13px;
  color: var(--muted);
}
.tab.active {
  background: var(--card);
  border-color: var(--border);
  border-bottom-color: var(--card);
  color: var(--text);
  font-weight: 600;
}
.tab[hidden] { display: none !important; }

.view-mode-label {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--muted);
  margin-left: 12px;
  white-space: nowrap;
}
.view-mode-label select {
  font-size: 13px;
  padding: 6px 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--card);
  color: var(--text);
  min-width: 160px;
}

.wave-status {
  font-size: 12px;
  color: var(--muted);
  padding: 6px 4px 0;
}

.boot-screen,
.intention-screen {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(165deg, #e0f2fe 0%, #7dd3fc 42%, #38bdf8 100%);
  padding: 24px;
}
.boot-screen[hidden],
.intention-screen[hidden] { display: none !important; }
.boot-card,
.intention-card {
  width: min(920px, 100%);
  background: rgba(255,255,255,0.92);
  border: 1px solid rgba(14,165,233,0.35);
  border-radius: 20px;
  padding: 36px 32px;
  color: #0c4a6e;
  box-shadow: 0 18px 50px rgba(2,132,199,0.22);
}
.boot-card h1,
.intention-card h1 {
  margin: 0 0 10px;
  font-size: 2rem;
  color: #0369a1;
}
.boot-msg {
  margin: 0;
  color: #075985;
  font-size: 1.05rem;
}
.boot-progress {
  margin-top: 22px;
  height: 6px;
  border-radius: 999px;
  background: rgba(14,165,233,0.25);
  overflow: hidden;
}
.boot-progress-bar {
  height: 100%;
  width: 12%;
  background: linear-gradient(90deg, #0284c7, #0ea5e9);
  transition: width 0.35s ease;
}
.intention-sub {
  margin: 0 0 24px;
  color: #0369a1;
}
.intention-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
@media (max-width: 900px) {
  .intention-grid { grid-template-columns: 1fr; }
}
.intention-btn {
  text-align: left;
  border: 1px solid rgba(14,165,233,0.4);
  background: #fff;
  color: #0c4a6e;
  border-radius: 16px;
  padding: 22px 18px;
  cursor: pointer;
  transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
}
.intention-btn:hover {
  border-color: #0284c7;
  background: #f0f9ff;
  box-shadow: 0 8px 24px rgba(2,132,199,0.18);
  transform: translateY(-2px);
}
.intention-title {
  display: block;
  font-size: 1.15rem;
  font-weight: 700;
  margin-bottom: 8px;
  color: #0c4a6e;
}
.intention-desc {
  display: block;
  font-size: 0.92rem;
  color: #0369a1;
  line-height: 1.4;
}

.stale-banner {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 8px 16px;
  background: #fef08a;
  border-bottom: 2px solid #eab308;
  color: #713f12;
  font-size: 13px;
  font-weight: 600;
}
.stale-banner[hidden] { display: none !important; }
.stale-banner .stale-reload {
  margin-left: auto;
  background: #fff;
  border-color: #ca8a04;
  color: #713f12;
  font-weight: 700;
}
.stale-banner .stale-reload:hover {
  background: #fefce8;
}

main {
  flex: 1;
  min-height: 0;
  padding: 0 16px 12px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.panel {
  display: none;
  flex: 1;
  min-height: 0;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 0 12px 12px 12px;
  padding: 10px;
  flex-direction: column;
  overflow: hidden;
}
.panel.active { display: flex; }

.toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  margin-bottom: 8px;
  flex-shrink: 0;
}
.toolbar .meta { color: var(--muted); font-size: 12px; margin-right: auto; }
.toggle { font-size: 12px; color: var(--muted); display: inline-flex; gap: 6px; align-items: center; }
#btnFilters.active {
  background: #e8eef7;
  border-color: #93b4d8;
  color: #1e3a5f;
}

.filters-slot:empty { display: none; }
.filters-bar {
  flex-shrink: 0;
  margin: 0 0 10px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: linear-gradient(180deg, #f7f8fa 0%, #f3f4f6 100%);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
}
.filters-bar[hidden] { display: none !important; }
.filters-bar-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 4px;
}
.filters-bar-title {
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: var(--muted);
}

.ppm-outline-start { color: #18181b; font-weight: 600; }
.ppm-outline-repeat-edit { color: #a1a1aa; font-weight: 400; }
.ppm-outline-repeat-link,
.ppm-outline-repeat-link .ppm-filter-link {
  color: #60a5fa;
  font-weight: 400;
}
.ppm-outline-repeat-link .ppm-filter-link:hover { color: #3b82f6; }

select, input[type="text"], input[type="number"] {
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 5px 8px;
  font-size: 13px;
  background: #fff;
}

.grid-host {
  flex: 1;
  min-height: 0;
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
}
.overview-grid { min-height: 180px; }
.overview-toolbar {
  flex-wrap: wrap;
  gap: 8px 12px;
  align-items: flex-end;
}
.overview-toolbar label {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 11px;
  color: #71717a;
}
.overview-toolbar select {
  font-size: 12px;
  min-width: 0;
}
.overview-levels {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 10px;
  padding: 6px 10px;
  margin-bottom: 8px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #fafafa;
  font-size: 12px;
}
.overview-levels .ov-levels-label {
  color: #71717a;
  margin-right: 4px;
}
.overview-levels .ov-level-sep {
  color: #a1a1aa;
  user-select: none;
}
.overview-levels label.ov-level {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  color: #3f3f46;
}
.overview-levels label.ov-level input { margin: 0; }
.overview-delta-neg { color: #b91c1c; }
.overview-delta-pos { color: #15803d; }
.gaps-grid { min-height: 220px; }
.gaps-toolbar {
  flex-wrap: wrap;
  gap: 8px 12px;
  align-items: center;
}
.gap-type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.gap-chip {
  border: 1px solid var(--border);
  background: #fff;
  border-radius: 8px;
  padding: 4px 10px;
  font-size: 12px;
  cursor: pointer;
  color: #3f3f46;
}
.gap-chip:hover { background: #f4f4f5; }
.gap-chip.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
}
.gap-type-tag {
  display: inline-block;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
}
.gap-type-unfilled { background: #fee2e2; color: #991b1b; }
.gap-type-overassign { background: #ffedd5; color: #9a3412; }
.gap-type-capacity { background: #fce7f3; color: #9d174d; }
.gap-type-unattended { background: #e0e7ff; color: #3730a3; }
.gap-score { font-variant-numeric: tabular-nums; font-weight: 600; }
.chart-host {
  flex: 0 0 240px;
  position: relative;
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 8px;
  padding: 8px 10px;
  background: #fafafa;
  overflow: hidden;
}
.chart-host svg { width: 100%; height: 100%; display: block; }

.gantt-host {
  flex: 0 0 auto;
  max-height: 280px;
  position: relative;
  border: 1px solid var(--border);
  border-radius: 8px;
  margin-bottom: 8px;
  padding: 8px 10px;
  background: #fafafa;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.gantt-host[hidden] { display: none !important; }
.ov-gantt-head {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 6px;
}
.ov-gantt-title {
  font-weight: 600;
  font-size: 13px;
  color: #27272a;
}
.ov-gantt-scroll {
  overflow: auto;
  flex: 1 1 auto;
  min-height: 0;
}
.ov-gantt-axis,
.ov-gantt-row {
  display: flex;
  align-items: stretch;
  min-width: 520px;
}
.ov-gantt-axis {
  border-bottom: 1px solid #e4e4e7;
  margin-bottom: 4px;
  padding-bottom: 4px;
}
.ov-gantt-label-col {
  flex: 0 0 160px;
  width: 160px;
  padding-right: 8px;
  font-size: 12px;
  color: #3f3f46;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1px;
  overflow: hidden;
}
.ov-gantt-program {
  font-size: 10px;
  color: #71717a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ov-gantt-project {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 500;
}
.ov-gantt-track-col {
  flex: 1 1 auto;
  position: relative;
  display: flex;
  min-height: 28px;
  background-image: repeating-linear-gradient(
    to right,
    transparent,
    transparent calc(100% / var(--ov-gantt-n, 12) - 1px),
    #ececef calc(100% / var(--ov-gantt-n, 12) - 1px),
    #ececef calc(100% / var(--ov-gantt-n, 12))
  );
}
.ov-gantt-tick {
  flex: 0 0 auto;
  text-align: center;
  font-size: 10px;
  color: #71717a;
  box-sizing: border-box;
  padding: 0 2px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ov-gantt-row {
  margin: 3px 0;
}
.ov-gantt-row .ov-gantt-track-col {
  background: #f4f4f5;
  border-radius: 4px;
  min-height: 26px;
}
.ov-gantt-bar {
  position: absolute;
  top: 3px;
  bottom: 3px;
  border-radius: 4px;
  padding: 0 6px;
  display: flex;
  align-items: center;
  overflow: hidden;
  font-size: 11px;
  font-weight: 500;
  color: #27272a;
  box-sizing: border-box;
  min-width: 4px;
}
.ov-gantt-bar span {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.toast {
  position: fixed;
  bottom: 16px;
  right: 16px;
  background: #18181b;
  color: #fff;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  display: none;
  z-index: 50;
  max-width: 360px;
}
.busy-overlay {
  position: fixed;
  inset: 0;
  background: rgba(24, 24, 27, 0.45);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.busy-overlay[hidden] { display: none !important; }
.busy-card {
  background: #fff;
  border-radius: 12px;
  padding: 20px 28px;
  min-width: 220px;
  text-align: center;
  box-shadow: 0 16px 40px rgba(0,0,0,.2);
}
.busy-card p { margin: 12px 0 0; font-size: 14px; color: #3f3f46; }
.busy-spinner {
  width: 28px;
  height: 28px;
  margin: 0 auto;
  border: 3px solid #e4e4e7;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: busy-spin 0.8s linear infinite;
}
@keyframes busy-spin { to { transform: rotate(360deg); } }
.kpi {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 10px;
  margin-bottom: 8px;
  flex-shrink: 0;
}
.kpi .card {
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 10px 12px;
  background: #fafafa;
}
.kpi .card b { display: block; font-size: 1.2rem; }
.kpi .card span { font-size: 12px; color: var(--muted); }
.hint { font-size: 12px; color: var(--muted); margin: 4px 0 8px; }
.loading { padding: 40px; text-align: center; color: var(--muted); }

.settings-dialog {
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0;
  width: min(880px, 96vw);
  max-height: 90vh;
  box-shadow: 0 20px 50px rgba(0,0,0,.18);
}
.ov-view-dialog {
  width: min(420px, 94vw);
  max-height: none;
}
.ov-view-name-label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: #71717a;
}
.ov-view-name-label input {
  font-size: 14px;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  color: #18181b;
  background: #fff;
}
.ov-view-overwrite { color: #b45309; }
.settings-dialog::backdrop { background: rgba(24, 24, 27, 0.35); }
.register-dialog {
  max-width: 440px;
}
.register-dialog .reg-user-label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
}
.register-dialog .reg-user-label input {
  font: inherit;
  font-weight: 400;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
}
#regError {
  color: #b91c1c;
}
.notify-dialog {
  max-width: 640px;
  width: min(640px, 96vw);
}
.notify-dialog h3 {
  margin: 14px 0 6px;
  font-size: 13px;
  font-weight: 600;
}
.notify-roles {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 16px;
  margin-bottom: 10px;
}
.notify-roles label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
}
.notify-extra-label,
.notify-comment-label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  margin: 8px 0;
}
.notify-extra-row {
  display: flex;
  gap: 8px;
  align-items: center;
}
.notify-extra-row input {
  flex: 1;
  font: inherit;
  font-weight: 400;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
}
.notify-comment-label textarea {
  font: inherit;
  font-weight: 400;
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  resize: vertical;
  min-height: 100px;
  line-height: 1.4;
}
.notify-rows {
  max-height: 120px;
  overflow: auto;
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 6px 8px;
  background: #fafafa;
  font-size: 12px;
  margin-bottom: 8px;
}
.notify-rows div {
  padding: 2px 0;
  border-bottom: 1px solid #eee;
}
.notify-rows div:last-child { border-bottom: none; }
.notify-recipients {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 200px;
  overflow: auto;
  margin-bottom: 8px;
}
.notify-recip {
  display: grid;
  grid-template-columns: 1fr minmax(180px, 1.2fr) auto;
  gap: 8px;
  align-items: center;
  padding: 6px 8px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #fff;
  font-size: 12px;
}
.notify-recip .role-tag {
  color: var(--muted);
  font-size: 11px;
}
.notify-recip input[type="email"],
.notify-recip input[type="text"] {
  width: 100%;
  font: inherit;
  padding: 5px 8px;
  border: 1px solid var(--border);
  border-radius: 6px;
}
.notify-recip.missing {
  border-color: #f59e0b;
  background: #fffbeb;
}
#notifyEmailError {
  color: #b91c1c;
}
.dialog-head, .dialog-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
}
.dialog-foot { border-bottom: none; border-top: 1px solid var(--border); justify-content: space-between; }
.dialog-head h2 { margin: 0; font-size: 1rem; }
.dialog-body {
  padding: 12px 16px 16px;
  overflow: auto;
  max-height: calc(90vh - 120px);
}
.dialog-body section { margin-bottom: 18px; }
.dialog-body h3 { margin: 0 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
.settings-grid, .filters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
}
.filters-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: flex-start;
}
.settings-grid label, .filters-grid label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12px;
  color: var(--muted);
}
/* Multi-select options: checkbox left of text (do not inherit column layout). */
.filters-grid .ms-option {
  display: flex !important;
  flex-direction: row !important;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text);
  margin: 0;
  white-space: nowrap;
}
.filters-grid .ms-option input {
  flex: 0 0 auto;
  margin: 0;
}
.filters-grid .ms-option span {
  flex: 1 1 auto;
  min-width: 0;
}
.settings-checkgroup {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 8px 0 2px;
  border-top: 1px solid var(--border);
  margin-top: 4px;
}
.settings-checkgroup-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
}
.settings-checkboxes {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 14px;
}
.settings-checkboxes label {
  flex-direction: row;
  align-items: center;
  gap: 6px;
  color: var(--text);
  font-size: 12px;
}

.ms-filter { position: relative; }
.ms-trigger {
  height: 32px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: #fff;
  padding: 0 10px;
  font-size: 12px;
  color: var(--muted);
  cursor: pointer;
}
.ms-trigger:hover { background: #f4f4f5; color: var(--text); }
.ms-trigger.active {
  border-color: var(--accent);
  background: #eff6ff;
  color: var(--accent);
  font-weight: 600;
}
.ms-panel {
  position: absolute;
  z-index: 40;
  top: calc(100% + 4px);
  left: 0;
  width: 240px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 10px;
  box-shadow: 0 12px 28px rgba(0,0,0,.12);
  padding: 8px;
}
.ms-panel[hidden] { display: none !important; }
.ms-search {
  width: 100%;
  margin-bottom: 6px;
  font-size: 12px;
}
.ms-options {
  max-height: 200px;
  overflow: auto;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 4px;
}
.ms-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  padding: 3px 4px;
  font-size: 12px;
  color: var(--text);
  border-radius: 4px;
}
.ms-option.ms-option-hidden {
  display: none !important;
}
.ms-option:hover { background: #f4f4f5; }
.ms-option span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ms-actions {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 8px;
}

.col-picker {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 6px 12px;
  font-size: 12px;
}
.col-picker label { display: flex; gap: 6px; align-items: center; color: var(--text); }

/* Tabulator theme */
.ppm.tabulator {
  font-size: 12px;
  border: none;
  background: #fff;
  height: 100% !important;
}
.ppm.tabulator .tabulator-header {
  background: #f4f4f5;
  border-bottom: 1px solid var(--border);
  font-weight: 600;
}
.ppm.tabulator .tabulator-col.tabulator-col-group > .tabulator-col-content {
  background: #e4e4e7;
  text-align: center;
}
.ppm.tabulator .tabulator-row { min-height: 28px; }
.ppm.tabulator .tabulator-row.tabulator-row-even { background: #f4f4f5; }
.ppm.tabulator .tabulator-cell {
  padding: 2px 6px;
  border-right: 1px solid #e4e4e7;
}
.ppm.tabulator .tabulator-row.ppm-avail { background: var(--avail) !important; font-weight: 700; }
.ppm.tabulator .tabulator-row.ppm-header { background: var(--header) !important; font-weight: 700; }
.ppm.tabulator .tabulator-row.ppm-group { font-weight: 700; }
.ppm.tabulator .tabulator-row.ppm-section {
  background: var(--section) !important;
  color: #fff !important;
  font-weight: 700;
  pointer-events: none;
}
.ppm.tabulator .tabulator-row.ppm-section .tabulator-cell {
  background: var(--section) !important;
  color: #fff !important;
  border-color: #52525b;
}
.ppm.tabulator .tabulator-row.ppm-row-deleted {
  opacity: 0.72;
}
.ppm.tabulator .tabulator-row.ppm-row-deleted .tabulator-cell {
  text-decoration: line-through;
  color: #71717a !important;
}
.ppm.tabulator .tabulator-row.tabulator-selected { background: #dbeafe !important; }
.ppm.tabulator .tabulator-row.tabulator-selected .tabulator-cell {
  background: #dbeafe !important;
}

.ppm.tabulator .ppm-cell-editable-special {
  background: var(--yellow) !important;
  cursor: text;
}
.ppm.tabulator .tabulator-row-even .ppm-cell-editable-regular {
  background: var(--yellow-regular-even) !important;
  cursor: text;
}
.ppm.tabulator .tabulator-row:not(.tabulator-row-even) .ppm-cell-editable-regular {
  background: var(--yellow-regular-odd) !important;
  cursor: text;
}
.ppm.tabulator .ppm-diff {
  box-shadow: inset 0 0 0 2px #fb923c;
}
.ppm .val-over, .ppm .val-unfilled { color: var(--danger); font-weight: 700; }
.ppm .val-under { color: var(--under); font-weight: 700; }
.ppm .val-overassigned { color: var(--overassigned); font-weight: 700; }

.ppm-cell-current {
  font-weight: 600;
  color: inherit;
}

/* Cell-level hint colors (match reference) — text inherits via .ppm-cell-current */
.ppm.tabulator .tabulator-cell.ppm-cell-over {
  color: var(--danger) !important;
  font-weight: 700;
}
.ppm.tabulator .tabulator-cell.ppm-cell-under {
  color: var(--under) !important;
  font-weight: 700;
}
.ppm.tabulator .tabulator-cell.ppm-cell-unfilled {
  color: var(--danger) !important;
  font-weight: 700;
}
.ppm.tabulator .tabulator-cell.ppm-cell-overassigned {
  color: var(--overassigned) !important;
  font-weight: 700;
}
.ppm.tabulator .tabulator-cell.ppm-cell-unfilled .ppm-cell-current,
.ppm.tabulator .tabulator-cell.ppm-cell-overassigned .ppm-cell-current,
.ppm.tabulator .tabulator-cell.ppm-cell-over .ppm-cell-current,
.ppm.tabulator .tabulator-cell.ppm-cell-under .ppm-cell-current,
.ppm.tabulator .tabulator-cell .val-unfilled,
.ppm.tabulator .tabulator-cell .val-over,
.ppm.tabulator .tabulator-cell .val-under,
.ppm.tabulator .tabulator-cell .val-overassigned {
  color: inherit;
}

.ppm.tabulator .tabulator-row.ppm-row-deleted .tabulator-cell,
.ppm.tabulator .tabulator-row.ppm-row-deleted .tabulator-cell .ppm-cell-current,
.ppm.tabulator .tabulator-row.ppm-row-deleted .tabulator-cell .val-unfilled,
.ppm.tabulator .tabulator-row.ppm-row-deleted .tabulator-cell .val-over,
.ppm.tabulator .tabulator-row.ppm-row-deleted .tabulator-cell .val-under,
.ppm.tabulator .tabulator-row.ppm-row-deleted .tabulator-cell .val-overassigned {
  text-decoration: line-through !important;
  color: #71717a !important;
  font-weight: 400 !important;
}

/* Month baselines: grey = snapshot compare; black = unsaved initial */
.ppm-cell-with-baseline {
  display: inline-flex;
  align-items: baseline;
  gap: 0.35em;
  white-space: nowrap;
  max-width: 100%;
  box-sizing: border-box;
}
.ppm-cell-with-baseline--end {
  justify-content: flex-end;
  width: 100%;
}
.ppm-cell-with-baseline--start {
  justify-content: flex-start;
  width: 100%;
}
.ppm.tabulator .tabulator-cell.ppm-month-demand {
  text-align: right;
}
.ppm.tabulator .tabulator-cell.ppm-month-alloc {
  text-align: left;
}
.ppm-cell-baseline {
  color: #6b7280 !important;
  font-size: 0.8em;
  font-weight: 400;
}
.ppm-cell-dirty {
  color: #111827 !important;
  font-size: 0.8em;
  font-weight: 500;
}

/* List / dropdown affordance */
.ppm-list-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
  width: 100%;
  min-width: 0;
}
.ppm-list-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.ppm-cell-truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}
.ppm-list-chevron {
  flex: 0 0 auto;
  color: #71717a;
  font-size: 10px;
  line-height: 1;
  opacity: 0.85;
  pointer-events: none;
}

.ppm-filter-link {
  color: var(--accent);
  text-decoration: underline;
  cursor: pointer;
}
.ppm-filter-link:hover { color: #1d4ed8; }
.ppm.tabulator .tabulator-data-tree-control {
  margin-right: 4px;
  border: 1px solid #a1a1aa;
  background: #e4e4e7;
  border-radius: 3px;
  width: 16px;
  height: 16px;
}

/* Range selection: opaque blue so content never shows through a translucent wash.
   Keep z-index low so frozen panes always stack above scrolling selected cells. */
.ppm.tabulator .tabulator-range-highlight,
.ppm.tabulator .tabulator-cell.tabulator-range-selected,
.ppm.tabulator .tabulator-col.tabulator-range-selected {
  background: #dbeafe !important;
  background-color: #dbeafe !important;
  z-index: 1;
}
.ppm.tabulator .tabulator-range-cell-active {
  outline: 2px solid #2563eb;
  outline-offset: -2px;
}

/* Frozen left pane: solid backgrounds + elevated z-index so scrolling cells
   (including selected blue) cannot paint through or over the freeze. */
.ppm.tabulator .tabulator-row .tabulator-cell.tabulator-frozen {
  background: #ffffff !important;
  background-color: #ffffff !important;
  z-index: 20 !important;
}
.ppm.tabulator .tabulator-row.tabulator-row-even .tabulator-cell.tabulator-frozen {
  background: #f4f4f5 !important;
  background-color: #f4f4f5 !important;
}
.ppm.tabulator .tabulator-row.ppm-avail .tabulator-cell.tabulator-frozen {
  background: var(--avail) !important;
  background-color: var(--avail) !important;
}
.ppm.tabulator .tabulator-row.ppm-header .tabulator-cell.tabulator-frozen {
  background: var(--header) !important;
  background-color: var(--header) !important;
}
.ppm.tabulator .tabulator-row.ppm-section .tabulator-cell.tabulator-frozen {
  background: var(--section) !important;
  background-color: var(--section) !important;
  color: #fff !important;
}
.ppm.tabulator .tabulator-row.ppm-group .tabulator-cell.tabulator-frozen {
  background: #ffffff !important;
  background-color: #ffffff !important;
}
.ppm.tabulator .tabulator-row.tabulator-row-even.ppm-group .tabulator-cell.tabulator-frozen {
  background: #f4f4f5 !important;
  background-color: #f4f4f5 !important;
}

/* Editable yellow still wins on frozen identity cells */
.ppm.tabulator .tabulator-row .tabulator-cell.tabulator-frozen.ppm-cell-editable-special {
  background: var(--yellow) !important;
  background-color: var(--yellow) !important;
}
.ppm.tabulator .tabulator-row-even .tabulator-cell.tabulator-frozen.ppm-cell-editable-regular {
  background: var(--yellow-regular-even) !important;
  background-color: var(--yellow-regular-even) !important;
}
.ppm.tabulator .tabulator-row:not(.tabulator-row-even) .tabulator-cell.tabulator-frozen.ppm-cell-editable-regular {
  background: var(--yellow-regular-odd) !important;
  background-color: var(--yellow-regular-odd) !important;
}

/* If a frozen cell itself is range-selected, keep opaque selection (still above scroll) */
.ppm.tabulator .tabulator-row .tabulator-cell.tabulator-frozen.tabulator-range-selected,
.ppm.tabulator .tabulator-row .tabulator-cell.tabulator-frozen.tabulator-range-highlight {
  background: #bfdbfe !important;
  background-color: #bfdbfe !important;
  z-index: 21 !important;
}
.ppm.tabulator .tabulator-row .tabulator-cell.tabulator-frozen.ppm-cell-editable-special.tabulator-range-selected,
.ppm.tabulator .tabulator-row .tabulator-cell.tabulator-frozen.ppm-cell-editable-regular.tabulator-range-selected {
  box-shadow: inset 0 0 0 2px #2563eb;
}

.ppm.tabulator .tabulator-header .tabulator-col.tabulator-frozen,
.ppm.tabulator .tabulator-header .tabulator-col.tabulator-frozen .tabulator-col-content {
  background: #f4f4f5 !important;
  background-color: #f4f4f5 !important;
  z-index: 22 !important;
}

/* Freeze edge marker when Tabulator adds frozen-right */
.ppm.tabulator .tabulator-col.tabulator-frozen.tabulator-frozen-right,
.ppm.tabulator .tabulator-cell.tabulator-frozen.tabulator-frozen-right {
  box-shadow: 2px 0 0 #a1a1aa;
}

.ppm.tabulator .ppm-row-drag {
  cursor: grab;
  text-align: center;
  color: #a1a1aa;
  user-select: none;
}
.ppm.tabulator .ppm-row-drag:active { cursor: grabbing; }
.ppm.tabulator .ppm-drag-grip {
  display: inline-block;
  letter-spacing: -1px;
  font-size: 12px;
  line-height: 1;
  pointer-events: auto;
  cursor: grab;
  padding: 4px 6px;
}
.ppm.tabulator .tabulator-row.ppm-drag-over {
  outline: 2px solid #2563eb;
  outline-offset: -2px;
}
.ppm.tabulator .tabulator-row.tabulator-row-moving {
  opacity: 0.85;
}

/* Milestone span colours on timeline header month cells */
.ppm.tabulator .tabulator-row.ppm-header .tabulator-cell.ppm-month-demand {
  font-weight: 600;
}
.ppm.tabulator .tabulator-cell.ppm-milestone-span {
  cursor: text;
  /* background comes from inline style (pastel span colour) */
}
.ppm.tabulator .tabulator-cell.ppm-milestone-span.ppm-cell-editable-special,
.ppm.tabulator .tabulator-cell.ppm-milestone-span.ppm-cell-editable-regular {
  background: unset;
}
.ppm-milestone-label {
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 11px;
}

.ppm-month-extra .ppm-cell-extra,
.ppm-cell-extra {
  color: #71717a;
  font-size: 0.85em;
}

.overview-chart-legend {
  display: flex;
  gap: 14px;
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 4px;
}
.overview-chart-legend i {
  display: inline-block;
  width: 10px;
  height: 10px;
  margin-right: 4px;
  border-radius: 2px;
  vertical-align: middle;
}
.overview-chart-legend .lg-demand { background: #2563eb; }
.overview-chart-legend .lg-alloc { background: #0891b2; }
.overview-chart-legend .lg-other { background: #a855f7; }
.overview-chart-legend .lg-a { background: #2563eb; }
.overview-chart-legend .lg-b { background: #0891b2; }
.overview-chart-tip {
  position: absolute;
  z-index: 5;
  background: #18181b;
  color: #fff;
  font-size: 11px;
  padding: 4px 8px;
  border-radius: 6px;
  pointer-events: none;
  white-space: nowrap;
  max-width: 280px;
}
.overview-chart-svg .ov-bar:hover,
.overview-chart-svg .ov-gap-dot:hover {
  opacity: 1;
  filter: brightness(1.08);
}

/* Finance: budget vs demand */
.ppm-budget-low { color: #dc2626; font-weight: 600; }
.ppm-budget-high { color: #2563eb; font-weight: 600; }
.panel .grid-host { min-height: 320px; }
  </style>
</head>
<body>
<div id="bootScreen" class="boot-screen">
  <div class="boot-card">
    <h1>Cap Plan</h1>
    <p id="boot" class="boot-msg">Detecting Google account…</p>
    <div class="boot-progress" id="bootProgress" hidden>
      <div class="boot-progress-bar" id="bootProgressBar"></div>
    </div>
  </div>
</div>

<div id="intentionScreen" class="intention-screen" hidden>
  <div class="intention-card">
    <h1>What do you want to work on?</h1>
    <p class="intention-sub" id="intentionHello">Choose your starting view. You can switch anytime from the header.</p>
    <div class="intention-grid">
      <button type="button" class="intention-btn" data-view-mode="resource">
        <span class="intention-title">Demand/Allocation</span>
        <span class="intention-desc">Plan capacity demand and staff resources across projects.</span>
      </button>
      <button type="button" class="intention-btn" data-view-mode="cost">
        <span class="intention-title">Budget/Booking</span>
        <span class="intention-desc">Distribute budget, control booking, and prepare transfers.</span>
      </button>
      <button type="button" class="intention-btn" data-view-mode="master">
        <span class="intention-title">Master Data</span>
        <span class="intention-desc">Maintain projects, people, access rights, and cost centers.</span>
      </button>
    </div>
  </div>
</div>

<div class="app-shell" id="appShell" hidden>
  <div id="staleBanner" class="stale-banner" hidden>
    <span id="staleBannerText">Data may be outdated.</span>
    <button type="button" class="btn stale-reload" id="btnStaleReload">Reload data</button>
  </div>
  <header>
    <div>
      <h1>Cap Plan</h1>
      <p id="appSubtitle">Resource management — demand, allocation, cost centers, budget &amp; booking</p>
    </div>
    <label class="view-mode-label">Resource Management View
      <select id="viewModeSelect" title="Switch Cap Plan workspace">
        <option value="resource">Demand/Allocation</option>
        <option value="cost">Budget/Booking</option>
        <option value="master">Master Data</option>
      </select>
    </label>
    <div class="grow"></div>
    <span class="meta" id="registeredBadge" title="Registered user for access rights and Changed-by">—</span>
    <button class="btn" id="btnFilters" type="button">Filters</button>
    <button class="btn" id="btnSettings" type="button">Settings</button>
    <button class="btn" id="btnSnapshot" type="button">Create snapshot</button>
    <button class="btn primary" id="btnSave" type="button" disabled>Saved</button>
  </header>

  <div class="tabs" id="tabs">
    <button class="tab active" data-tab="topics" type="button">Projects/Topics</button>
    <button class="tab" data-tab="employees" type="button">Employees</button>
    <button class="tab" data-tab="access" type="button">User Access</button>
    <button class="tab" data-tab="costcenters" type="button">Cost Centers</button>
    <button class="tab" data-tab="budget" type="button">Budget Allocation</button>
    <button class="tab" data-tab="booking" type="button">Booking Control</button>
    <button class="tab" data-tab="transfer" type="button">Transfer</button>
    <button class="tab" data-tab="overview" type="button">Overview</button>
    <button class="tab" data-tab="gaps" type="button">Gaps</button>
    <button class="tab" data-tab="demand" type="button">Capacity Demand</button>
    <button class="tab" data-tab="allocation" type="button">Resource Allocation</button>
  </div>

  <main>
    <div id="waveStatus" class="wave-status" hidden></div>

    <section class="panel active" id="panel-topics">
      <div class="toolbar">
        <span class="meta">Project / topic master data</span>
        <label class="toggle"><input type="checkbox" id="topicsEditToggle"> Edit mode</label>
        <button class="btn" id="btnAddTopic" type="button">Add Topic</button>
        <button class="btn danger" id="btnDeleteTopic" type="button">Delete</button>
      </div>
      <div class="filters-slot"></div>
      <div class="grid-host" id="grid-topics"></div>
    </section>

    <section class="panel" id="panel-employees">
      <div class="toolbar">
        <span class="meta">Employee / people master data</span>
        <label class="toggle"><input type="checkbox" id="employeesEditToggle"> Edit mode</label>
        <button class="btn" id="btnAddEmployee" type="button">Add Employee</button>
        <button class="btn danger" id="btnDeleteEmployee" type="button">Delete</button>
      </div>
      <div class="filters-slot"></div>
      <div class="grid-host" id="grid-employees"></div>
    </section>

    <section class="panel" id="panel-access">
      <div class="toolbar">
        <span class="meta">User roles &amp; scope (Admin edits; Project Lead project rights come from Topics)</span>
        <button class="btn" id="btnAddAccess" type="button">Add access</button>
        <button class="btn danger" id="btnDeleteAccess" type="button">Delete</button>
        <button class="btn" id="btnUndo" type="button" title="Ctrl+Z">Undo</button>
        <button class="btn" id="btnRedo" type="button" title="Ctrl+Y">Redo</button>
      </div>
      <div class="filters-slot"></div>
      <div class="grid-host" id="grid-access"></div>
    </section>

    <section class="panel" id="panel-costcenters">
      <div class="toolbar">
        <span class="meta">Unit → Department → Group → Role → Name · most-specific field wins</span>
        <button class="btn" id="btnAddCostCenter" type="button">Add attribution</button>
        <button class="btn danger" id="btnDeleteCostCenter" type="button">Delete</button>
      </div>
      <div class="filters-slot"></div>
      <div class="grid-host" id="grid-costcenters"></div>
    </section>

    <section class="panel" id="panel-budget">
      <div class="toolbar">
        <span class="meta">Same portfolio filters as Demand · project-allocated rows · FTE budget vs demand</span>
        <label>Year
          <select id="budgetYear"></select>
        </label>
        <label>Unit
          <select id="budgetUnit">
            <option value="fte">FTE</option>
            <option value="hours">Hours (×133)</option>
            <option value="cur">CUR (hourly cost)</option>
          </select>
        </label>
        <button class="btn" id="btnBudgetRecalc" type="button">Recalculate split</button>
        <button class="btn" data-act="gotoDemand" type="button">Open Demand</button>
      </div>
      <div class="filters-slot"></div>
      <div class="grid-host" id="grid-budget"></div>
    </section>

    <section class="panel" id="panel-booking">
      <div class="toolbar">
        <span class="meta">Same portfolio filters as Allocation · auto from allocation/availability</span>
        <label>Year
          <select id="bookingYear"></select>
        </label>
        <label>Unit
          <select id="bookingUnit">
            <option value="fte">FTE</option>
            <option value="hours">Hours (×133)</option>
            <option value="cur">CUR (hourly cost)</option>
          </select>
        </label>
        <button class="btn" id="btnBookingRecalc" type="button">Recalculate auto</button>
        <button class="btn" data-act="gotoAllocation" type="button">Open Allocation</button>
      </div>
      <div class="filters-slot"></div>
      <div class="grid-host" id="grid-booking"></div>
    </section>

    <section class="panel" id="panel-transfer">
      <div class="toolbar">
        <span class="meta">SAP transfer view · live from booking · finance &amp; none excluded</span>
        <label>Year
          <select id="transferYear"></select>
        </label>
        <label>Show
          <select id="transferUnit">
            <option value="fte">FTE</option>
            <option value="hours" selected>Hours (×133)</option>
          </select>
        </label>
        <label class="toggle"><input type="checkbox" id="transferSplit99"> Split rows at 99h</label>
        <label>Type
          <select id="transferTypeFilter">
            <option value="all">All transferable</option>
            <option value="direct">Direct</option>
            <option value="indirect">Indirect</option>
          </select>
        </label>
      </div>
      <div class="filters-slot"></div>
      <div class="grid-host" id="grid-transfer"></div>
    </section>

    <section class="panel" id="panel-overview">
      <div class="toolbar overview-toolbar">
        <span class="meta">Compare &amp; roll-up</span>
        <label>Grain
          <select id="ovGranularity">
            <option value="Month">Monthly</option>
            <option value="Quarter" selected>Quarterly</option>
            <option value="Year">Yearly</option>
          </select>
        </label>
        <label>Hierarchy
          <select id="ovDirection">
            <option value="demand_to_alloc">Demand → Allocation</option>
            <option value="alloc_to_demand">Allocation → Demand</option>
          </select>
        </label>
        <label>Series A (current)
          <select id="ovSeriesA">
            <option value="demand">Demand</option>
            <option value="allocation">Allocation</option>
            <option value="budget">Budget</option>
            <option value="employee">Employee</option>
          </select>
        </label>
        <label>Series B
