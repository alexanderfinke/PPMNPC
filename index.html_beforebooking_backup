function toggleFiltersBar() {
  state.filtersVisible = !state.filtersVisible;
  if (state.filtersVisible) renderGlobalFiltersForm();
  persistUserSettings();
  syncFiltersBarPlacement();
  updateFiltersButtonLabel();
}

function updateFiltersButtonLabel() {
  var n = activeFilterCount();
  var btn = $('btnFilters');
  if (!btn) return;
  var base = n ? ('Filters (' + n + ')') : 'Filters';
  btn.textContent = base;
  btn.classList.toggle('active', !!state.filtersVisible);
