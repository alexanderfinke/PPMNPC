function syncFiltersBarPlacement() {
  var bar = $('filtersBar');
  if (!bar) return;
  var panel = document.querySelector('.panel.active');
  var slot = panel && panel.querySelector('.filters-slot');
  if (slot && bar.parentElement !== slot) slot.appendChild(bar);
  if (state.filtersVisible) {
    bar.removeAttribute('hidden');
    if (!$('globalFiltersForm').innerHTML) renderGlobalFiltersForm();
  } else {
    bar.setAttribute('hidden', '');
    closeMsPanelsApplyingFilters();
