      r.emailTyped = val;
      r.email = val;
      r.missing = !looksLikeEmailClient(val);
    });
  });
  var missing = n.recipients.filter(function (r) { return r.missing || !looksLikeEmailClient(r.email); });
  if (missing.length) {
    if (err) {
      err.hidden = false;
      err.textContent = 'Enter email for: ' + missing.map(function (r) { return r.name; }).join(', ');
    }
    renderNotifyRecipients();
    toast('Email required for unregistered recipients');
    return;
  }
  if (!n.recipients.length) {
    if (err) { err.hidden = false; err.textContent = 'Select at least one recipient.'; }
    return;
  }

  var registerEmails = n.recipients.filter(function (r) {
    return r.emailTyped && looksLikeEmailClient(r.emailTyped) && !looksLikeEmailClient(r.name);
  }).map(function (r) {
    return { name: r.name, email: r.emailTyped || r.email };
  });

  var payload = {
    senderName: registeredDisplayName(),
    senderRole: roleDisplayLabel(state.role),
    comment: $('notifyComment') ? String($('notifyComment').value || '').trim() : '',
    recipients: n.recipients.map(function (r) {
      return {
        name: r.name,
        email: r.emailTyped || r.email,
        roleLabel: r.roleLabel || ''
      };
    }),
    rows: n.rows.map(function (r) {
      return {
        id: r.id,
        tab: r.tab || (r.is_availability ? 'allocation' : 'demand'),
        type: r.type,
        project: r.project,
        role: r.role,
        name: r.name,
        columns: r.columns || n.columns || [],
        cells: r.cells || {},
        cellColors: r.cellColors || {},
        is_availability: !!r.is_availability
      };
    }),
    columns: n.columns || (n.rows[0] && n.rows[0].columns) || [],
    registerEmails: registerEmails
  };

  var btn = $('btnNotifySend');
  if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
  google.script.run
    .withSuccessHandler(function (res) {
      if (btn) { btn.disabled = false; btn.textContent = 'Send email'; }
      closeNotifyDialog();
      toast('Notification sent to ' + ((res && res.sent) || payload.recipients.length) + ' recipient(s)');
    })
    .withFailureHandler(function (e) {
      if (btn) { btn.disabled = false; btn.textContent = 'Send email'; }
      if (err) { err.hidden = false; err.textContent = e.message || String(e); }
      toast('Notify failed: ' + (e.message || e));
    })
    .sendCapPlanNotification(payload);
}

