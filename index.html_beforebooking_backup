/* ----- tree data ----- */
function staffingBand(row) {
  var employee = row.employee_id ? state.employeeById[row.employee_id] : null;
  var name = ((employee && employee.name) || row.name || '').trim();
  var role = (row.role || (employee && employee.role) || '').trim();
  var type = ((employee && employee.fte_type) || '') + ' ' + ((employee && employee.group_name) || '') + ' ' + role;
  var blob = name + ' ' + type;
  if (!name || NN_RE.test(name)) return 'NN';
  if (NEW_HIRE_RE.test(blob)) return 'New Hire';
  if (/extern|contractor|supplier|agency|indy/i.test(blob) || /extern/i.test(name)) return 'External';
  if (/intern|inhouse|staff|\bma\b/i.test(type)) return 'Internal';
  return 'Named Resources';
}

function lookupField(row, meta) {
  if (meta.lookup === 'project') {
    var p = row.project_id ? state.projectById[row.project_id] : null;
    return p ? String(p[meta.lookupField] || '') : '';
  }
  if (meta.lookup === 'employee') {
    var e = row.employee_id ? state.employeeById[row.employee_id] : null;
    if (meta.lookupField === 'department') {
      return roleDepartmentFromRole((e && e.role) || row.role || '') ||
        (e && e.department) || '';
    }
    return e ? String(e[meta.lookupField] || '') : '';
  }
  if (meta.lookup === 'finance') {
    if (typeof resolveCostCenterAttrs !== 'function') return '';
    var empF = row.employee_id ? state.employeeById[row.employee_id] : null;
    var projF = row.project_id ? state.projectById[row.project_id] : null;
    var hier = hierarchyForEmployee(empF, row);
    var attrs = resolveCostCenterAttrs(hier);
    if (meta.lookupField === 'project_cost_center') {
      var pcc = projectCostCenterForContext(projF, empF && empF.people_location);
      return pcc.missing ? 'missing' : (pcc.cc || '');
    }
    var v = attrs[meta.lookupField];
    if (!v && (meta.lookupField === 'internal_cost_center' || meta.lookupField === 'internal_activity_type')) {
      return attrs.missing ? 'missing' : '';
    }
    return v || '';
  }
  return '';
}

function flattenRow(r, meta) {
  var o = clone(r);
  if ((!o.name || o.name === '') && o.employee_id && state.employeeById[o.employee_id]) {
    o.name = state.employeeById[o.employee_id].name || o.name;
  }
  if ((!o.role || o.role === '') && o.employee_id && state.employeeById[o.employee_id]) {
    o.role = state.employeeById[o.employee_id].role || o.role;
  }
  o.displayName = o.name || o.project_topic || '—';
  o.dataTypeLabel = meta && meta.data_type != null ? meta.data_type : dataType(o);
  o.data_type = o.dataTypeLabel;
  o.is_group_root = !!(meta && meta.is_group_root);
  o.group_key = meta && meta.group_key;
  o.group_label = meta && meta.group_label;
  if (o.is_group_root && !o.name) o.displayName = o.group_label || o.project_topic || '—';
  Object.keys(COLUMN_META).forEach(function (id) {
    var m = COLUMN_META[id];
    if (m.lookup) o['lk_' + id] = lookupField(o, m);
  });
  if (o.project_id && state.projectById[o.project_id]) {
    o.project_topic = o.project_topic || state.projectById[o.project_id].project_topic;
  }
  state.months.forEach(function (m) {
    var key = monthKey(m);
    var mk = ym(m);
    if (isHeader(o)) {
      o['ph_' + mk] = (o.phases && (o.phases[key] || o.phases[m])) || '';
      o['d_' + mk] = o['ph_' + mk];
      o['a_' + mk] = o['ph_' + mk];
    } else {
      var cell = (o.months && (o.months[key] || o.months[m])) || {};
      var demand = cell.demand;
      var alloc = cell.allocation;
      if (isAvail(o)) {
        var emp = empKey(o.employee_id);
        var asg = emp ? state.assigned[emp + '|' + mk] : undefined;
        if (asg !== undefined) alloc = roundFte(asg);
        if ((demand == null || demand === '') && state.capacity[emp + '|' + mk] != null) {
          demand = state.capacity[emp + '|' + mk];
        }
      }
      o['d_' + mk] = demand == null || demand === '' ? null : Number(demand);
      o['a_' + mk] = alloc == null || alloc === '' ? null : Number(alloc);
      var empVal = cell.employee;
      var budVal = cell.budget;
      o['e_' + mk] = empVal == null || empVal === '' ? null : Number(empVal);
      o['b_' + mk] = budVal == null || budVal === '' ? null : Number(budVal);
    }
  });
  return o;
}

function buildTreeData(mode) {
  var rows = filteredRows(mode);
  var groups = {};
  rows.forEach(function (r) {
    var key = mode === 'demand'
      ? (r.project_id ? ('p:' + r.project_id) : ('t:' + (r.project_topic || 'none')))
      : (r.employee_id ? ('e:' + r.employee_id) : ('n:' + (r.name || '') + '|' + (r.role || '')));
    if (!groups[key]) groups[key] = [];
    groups[key].push(r);
  });
  var roots = [];
  Object.keys(groups).forEach(function (key) {
    var list = groups[key].slice().sort(function (a, b) {
      if (mode === 'allocation' && a.is_availability !== b.is_availability) return a.is_availability ? -1 : 1;
      return (a.sort_order || 0) - (b.sort_order || 0);
    });
    if (mode === 'allocation') {
      var avail = list.filter(isAvail)[0] || list[0];
      var children = list.filter(function (r) { return r.id !== avail.id; }).map(function (r) {
        return flattenRow(r, { data_type: dataType(r), group_key: key, group_label: avail.name || '', is_group_root: false });
      });
      var root = flattenRow(avail, { data_type: dataType(avail), group_key: key, group_label: avail.name || '', is_group_root: false });
      root._children = children;
      roots.push(root);
    } else {
      var sample = list[0];
      var label = sample.project_topic || 'Untitled project';
      roots.push({
        id: '__project_root__' + key,
        _isGroup: true,
        is_group_root: true,
        _groupKey: key,
        group_key: key,
        group_label: label,
        project_topic: sample.project_topic,
        project_id: sample.project_id,
        name: label,
        displayName: label,
        dataTypeLabel: '',
        data_type: '',
        _children: list.map(function (r) {
          return flattenRow(r, { data_type: dataType(r), group_key: key, group_label: label, is_group_root: false });
        })
      });
    }
  });

  roots.sort(function (a, b) {
    if (mode === 'demand') {
      var pa = a.project_id ? state.projectById[a.project_id] : null;
      var pb = b.project_id ? state.projectById[b.project_id] : null;
      var ka = [(pa && pa.portfolio) || '', (pa && pa.category) || '', (pa && pa.program) || '', a.project_topic || ''];
      var kb = [(pb && pb.portfolio) || '', (pb && pb.category) || '', (pb && pb.program) || '', b.project_topic || ''];
      return ka.join('|').localeCompare(kb.join('|'));
    }
    var ea = a.employee_id ? state.employeeById[a.employee_id] : null;
    var eb = b.employee_id ? state.employeeById[b.employee_id] : null;
    var ka2 = [(ea && ea.group_name) || '', (ea && ea.people_location) || '', (ea && ea.fte_type) || '', a.name || '', a.role || ''];
    var kb2 = [(eb && eb.group_name) || '', (eb && eb.people_location) || '', (eb && eb.fte_type) || '', b.name || '', b.role || ''];
    return ka2.join('|').localeCompare(kb2.join('|'));
  });

  if (mode !== 'allocation') return roots;

  var byBand = {};
  STAFFING_BAND_ORDER.forEach(function (b) { byBand[b] = []; });
  roots.forEach(function (root) {
    byBand[staffingBand(root)].push(root);
  });
  var withSections = [];
  STAFFING_BAND_ORDER.forEach(function (band) {
    var list = byBand[band] || [];
    if (!list.length) return;
    withSections.push({
      id: '__section__' + band,
      is_section: true,
      section_label: band,
      displayName: band,
      name: band,
      dataTypeLabel: '',
      data_type: '',
      role: '',
      workpackage: ''
    });
    withSections.push.apply(withSections, list);
  });
  return withSections;
}

