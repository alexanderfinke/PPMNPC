/* ----- save / snapshot ----- */
function clientRowIdentityDirty(row, orig) {
  if (!orig) return true;
  var fields = [
    'source', 'version', 'project_id', 'alternative_financing', 'employee_id',
    'workpackage', 'role', 'notes_project_lead', 'notes_people_lead', 'notes_employee', 'comments'
  ];
  for (var i = 0; i < fields.length; i++) {
    var a = row[fields[i]] == null || String(row[fields[i]]).trim() === '' ? '' : String(row[fields[i]]).trim();
    var b = orig[fields[i]] == null || String(orig[fields[i]]).trim() === '' ? '' : String(orig[fields[i]]).trim();
    if (a !== b) return true;
  }
  if (Math.trunc(row.sort_order || 0) !== Math.trunc(orig.sort_order || 0)) return true;
  return false;
}

function clientMonthCellsDirty(row, orig) {
  var cur = (row && row.months) || {};
  var base = (orig && orig.months) || {};
  var keys = {};
  Object.keys(cur).forEach(function (k) { keys[k] = 1; });
  Object.keys(base).forEach(function (k) { keys[k] = 1; });
  return Object.keys(keys).some(function (key) {
    var a = cur[key] || {};
    var b = base[key] || {};
    function num(v) { return v == null || v === '' ? null : Number(v); }
    return num(a.demand) !== num(b.demand) || num(a.allocation) !== num(b.allocation) ||
      num(a.employee) !== num(b.employee) || num(a.budget) !== num(b.budget);
  });
}

function clientPhasesDirty(row, orig) {
  var cur = (row && row.phases) || {};
  var base = (orig && orig.phases) || {};
  var keys = {};
  Object.keys(cur).forEach(function (k) { keys[k] = 1; });
  Object.keys(base).forEach(function (k) { keys[k] = 1; });
  return Object.keys(keys).some(function (key) {
    var a = cur[key] == null ? '' : String(cur[key]);
    var b = base[key] == null ? '' : String(base[key]);
    return a !== b;
  });
}

function collectDirtySavePayload() {
  var origById = {};
  (state.originalRows || []).forEach(function (r) {
    if (r && r.id != null) origById[String(r.id)] = r;
  });
  var dirty = [];
  var baselines = [];
  var sortTouched = state._sortOrderTouched || {};
  (state.rows || []).forEach(function (row) {
    if (!row || row.id == null) return;
    if (String(row.id).indexOf('__') === 0) return;
    var orig = origById[String(row.id)];
    var forceSort = !!sortTouched[String(row.id)];
    if (forceSort || !orig || clientRowIdentityDirty(row, orig) || clientMonthCellsDirty(row, orig) || clientPhasesDirty(row, orig)) {
      dirty.push(row);
      baselines.push(orig || {
        id: row.id, months: {}, phases: {}, source: row.source, version: row.version
      });
    }
  });
  return {
    rows: dirty,
    originalRows: baselines,
    deletedIds: (state._deleted || []).slice(),
    dirtyOnly: true
  };
}

function applyCompareSnapshot(data) {
  if (!data) return;
  state.compare = indexCompare(data.compare || []);
  state.rowSnapshots = {};
  Object.keys(data.rowSnapshots || {}).forEach(function (k) {
    state.rowSnapshots[k] = data.rowSnapshots[k];
    state.rowSnapshots[String(k)] = data.rowSnapshots[k];
  });
  if (state.boot) {
    state.boot.compareSnapshotDate = data.compareSnapshotDate;
    state.boot.snapshotLabel = data.snapshotLabel || '';
  }
  if (data.settings) {
    state.settings = Object.assign({}, state.settings, data.settings);
  }
  renderAll();
}

function applyLightSaveSuccess(data) {
  if (data && data.stampedRowIds && data.stampedRowIds.length) {
    var by = data.stampedBy || currentActingIdentity() || '';
    var at = data.stampedAt || data.savedAt || '';
    var histMap = data.changeHistoryById || {};
    data.stampedRowIds.forEach(function (id) {
      var row = findRow(id);
      if (!row) return;
      row.changed_by = by || row.changed_by;
      row.updated_at = at || row.updated_at;
      if (histMap[id]) row.change_history = histMap[id];
      else if (by || at) {
        var hist = (row.change_history || []).slice();
        if (!(hist[0] && hist[0].by === by && hist[0].at === at)) {
          hist.unshift({ by: by, at: at });
        }
        row.change_history = hist.slice(0, 3);
      }
    });
  }
  state.originalRows = clone(state.rows);
  state._deleted = [];
  state._sortOrderTouched = {};
  seedSessionOrigin(state.rows);
  if (data && data.saveStats && data.saveStats.masters) {
    applyMastersSaveSuccess();
  }
  if (data && data.settings) {
    state.settings = Object.assign({}, state.settings, data.settings);
  }
  setDirty(false);
  var ms = data && data.elapsedMs != null ? Number(data.elapsedMs) : null;
  var bits = [];
  if (data && data.saveStats) {
    var s = data.saveStats;
    bits.push((s.rowsUpserted || 0) + ' rows');
    bits.push((s.yearsUpserted || 0) + ' year-series');
    if (s.rowsDeleted) bits.push(s.rowsDeleted + ' deleted');
  }
  if (ms != null) bits.push((ms / 1000).toFixed(1) + 's');
  toast('Saved' + (bits.length ? (' · ' + bits.join(' · ')) : ''));
  softRefreshTables(true);
}

