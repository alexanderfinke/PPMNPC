function renderOverviewChart(series, labelA, labelB) {
  var host = $('overview-chart');
  if (!series.length) { host.innerHTML = '<p class="hint">No data</p>'; return; }
  var w = Math.max(host.clientWidth || 600, 400);
  var h = 220;
  var pad = { t: 16, r: 12, b: 40, l: 40 };
  var max = 0;
  series.forEach(function (s) {
    max = Math.max(max, s.a, s.b);
  });
  if (max < 1e-6) max = 1;
  var n = series.length;
  var groupW = (w - pad.l - pad.r) / n;
  var barCount = 2;
  var barW = Math.max(3, Math.min(18, groupW * (0.72 / barCount)));
  var gapBars = 2;
  var clusterW = barCount * barW + (barCount - 1) * gapBars;
  var plotH = h - pad.t - pad.b;
  var yScale = function (v) { return pad.t + plotH * (1 - Math.max(0, v) / max); };
  var parts = [];
  parts.push('<div class="overview-chart-legend">' +
    '<span><i class="lg-a"></i>' + esc(labelA) + '</span>' +
    '<span><i class="lg-b"></i>' + esc(labelB) + '</span>' +
    '</div>');
  parts.push('<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="xMidYMid meet" class="overview-chart-svg">');
  parts.push('<line x1="' + pad.l + '" y1="' + (h - pad.b) + '" x2="' + (w - pad.r) + '" y2="' + (h - pad.b) + '" stroke="#d4d4d8"/>');
  for (var g = 1; g <= 3; g++) {
    var gy = yScale(max * g / 4);
    parts.push('<line x1="' + pad.l + '" y1="' + gy + '" x2="' + (w - pad.r) + '" y2="' + gy + '" stroke="#f4f4f5"/>');
  }
  series.forEach(function (s, i) {
    var xCluster = pad.l + i * groupW + (groupW - clusterW) / 2;
    var base = h - pad.b;
    var tip = esc(s.label) + ' · ' + labelA + ' ' + s.a.toFixed(1) +
      ' · ' + labelB + ' ' + s.b.toFixed(1) +
      ' · Δ ' + s.delta.toFixed(1);
    var bars = [
      { v: s.a, cls: 'ov-a', fill: '#2563eb' },
      { v: s.b, cls: 'ov-b', fill: '#0891b2' }
    ];
    bars.forEach(function (bar, bi) {
      var x = xCluster + bi * (barW + gapBars);
      var y = yScale(bar.v);
      parts.push('<rect class="ov-bar ' + bar.cls + '" data-tip="' + tip + '" x="' + x + '" y="' + y +
        '" width="' + barW + '" height="' + Math.max(0, base - y) + '" fill="' + bar.fill +
        '" rx="1"><title>' + tip + '</title></rect>');
    });
    parts.push('<text x="' + (xCluster + clusterW / 2) + '" y="' + (h - 12) +
      '" text-anchor="middle" font-size="10" fill="#71717a">' + esc(s.label) + '</text>');
  });
  parts.push('</svg>');
  parts.push('<div class="overview-chart-tip" id="overview-chart-tip" hidden></div>');
  host.innerHTML = parts.join('');
  var tipEl = host.querySelector('#overview-chart-tip');
  host.onmousemove = function (e) {
    var t = e.target.closest('[data-tip]');
    if (!t || !tipEl) { if (tipEl) tipEl.hidden = true; return; }
    tipEl.hidden = false;
    tipEl.textContent = t.getAttribute('data-tip');
    var rect = host.getBoundingClientRect();
    tipEl.style.left = Math.min(rect.width - 180, Math.max(8, e.clientX - rect.left + 12)) + 'px';
    tipEl.style.top = Math.max(8, e.clientY - rect.top - 28) + 'px';
  };
  host.onmouseleave = function () { if (tipEl) tipEl.hidden = true; };
}

/** Timeline roadmap / Gantt for Overview — only when filtered header rows have phase month data. */
function timelineHasPhaseData(row, months) {
  if (!isHeader(row) || !row.phases) return false;
  return (months || []).some(function (m) {
    var key = monthKey(m);
    var v = row.phases[key] || row.phases[m] || row.phases[ym(m)];
    return v != null && String(v).trim() !== '';
  });
}

function timelineBarsForGrain(row, months, granularity) {
  var marks = [];
  for (var i = 0; i < months.length; i++) {
    var month = months[i];
    var text = String((row.phases && (row.phases[monthKey(month)] || row.phases[month] || row.phases[ym(month)])) || '').trim();
    if (text) marks.push({ index: i, month: month, text: text });
  }
  if (!marks.length) return [];
  var buckets = bucketsList(months, granularity);
  var bucketIndex = {};
  buckets.forEach(function (b, i) { bucketIndex[b] = i; });
  return marks.map(function (cur, k) {
    var next = marks[k + 1];
    var lastIndex = next ? next.index - 1 : cur.index;
    var startB = bucketOf(months[cur.index], granularity);
    var endB = bucketOf(months[lastIndex], granularity);
    var start = bucketIndex[startB];
    var end = bucketIndex[endB];
    if (start == null || end == null) return null;
    var color = milestoneColor(cur.text);
    return {
      label: cur.text,
      start: start,
      end: end,
      background: color.background,
      boxShadow: color.boxShadow
    };
  }).filter(Boolean);
}

function renderOverviewTimelineGantt(rows, months, granularity) {
  var host = $('overview-gantt');
  if (!host) return;
  var headers = (rows || []).filter(function (r) {
    return timelineHasPhaseData(r, months);
  });
  if (!headers.length || !(months || []).length) {
    host.hidden = true;
    host.innerHTML = '';
    return;
  }
  var buckets = bucketsList(months, granularity);
  if (!buckets.length) {
    host.hidden = true;
    host.innerHTML = '';
    return;
  }

  // One lane per project (collapse multiple timeline rows under same project)
  var byProject = {};
  headers.forEach(function (r) {
    var pid = r.project_id || ('t:' + (r.project_topic || r.id));
    if (!byProject[pid]) {
      var proj = r.project_id ? state.projectById[r.project_id] : null;
      byProject[pid] = {
        id: pid,
        label: (proj && proj.project_topic) || r.project_topic || r.workpackage || String(pid),
        program: (proj && proj.program) || '',
        rows: []
      };
    }
    byProject[pid].rows.push(r);
  });
  var lanes = Object.keys(byProject).map(function (k) { return byProject[k]; });
  lanes.sort(function (a, b) {
    return String(a.program + '|' + a.label).localeCompare(String(b.program + '|' + b.label));
  });

  var n = buckets.length;
  var parts = [];
  parts.push('<div class="ov-gantt-head"><span class="ov-gantt-title">Timeline roadmap</span>' +
    '<span class="meta">' + lanes.length + ' project' + (lanes.length === 1 ? '' : 's') +
    ' · ' + esc(granularity || 'Month') + '</span></div>');
  parts.push('<div class="ov-gantt-scroll">');
  parts.push('<div class="ov-gantt-axis"><div class="ov-gantt-label-col"></div><div class="ov-gantt-track-col" style="--ov-gantt-n:' + n + '">');
  buckets.forEach(function (b) {
    parts.push('<div class="ov-gantt-tick" style="width:' + (100 / n) + '%">' + esc(bucketLabel(b, granularity)) + '</div>');
  });
  parts.push('</div></div>');

  lanes.forEach(function (lane) {
    var bars = [];
    lane.rows.forEach(function (r) {
      bars = bars.concat(timelineBarsForGrain(r, months, granularity));
    });
    if (!bars.length) return;
    parts.push('<div class="ov-gantt-row">');
    parts.push('<div class="ov-gantt-label-col" title="' + esc(lane.label) + '">' +
      (lane.program ? ('<span class="ov-gantt-program">' + esc(lane.program) + '</span>') : '') +
      '<span class="ov-gantt-project">' + esc(lane.label) + '</span></div>');
    parts.push('<div class="ov-gantt-track-col" style="--ov-gantt-n:' + n + '">');
    bars.forEach(function (bar) {
      var left = (bar.start / n) * 100;
      var width = ((bar.end - bar.start + 1) / n) * 100;
      parts.push('<div class="ov-gantt-bar" style="left:' + left + '%;width:' + width +
        '%;background:' + bar.background + ';box-shadow:' + bar.boxShadow +
        '" title="' + esc(bar.label) + '"><span>' + esc(bar.label) + '</span></div>');
    });
    parts.push('</div></div>');
  });
  parts.push('</div>');
  host.innerHTML = parts.join('');
  host.hidden = false;
}

function readOverviewFromControls() {
  var prev = state.overview || defaultOverviewState();
  var levels = prev.levels && typeof prev.levels === 'object' ? prev.levels : defaultOverviewLevels();
  return {
    granularity: ($('ovGranularity') && $('ovGranularity').value) || prev.granularity || 'Quarter',
    direction: ($('ovDirection') && $('ovDirection').value) || prev.direction || 'demand_to_alloc',
    levels: levels,
    seriesA: ($('ovSeriesA') && $('ovSeriesA').value) || prev.seriesA || 'demand',
    seriesB: ($('ovSeriesB') && $('ovSeriesB').value) || prev.seriesB || 'allocation',
    seriesBSource: ($('ovSeriesBSource') && $('ovSeriesBSource').value) || prev.seriesBSource || 'current'
  };
}

function renderOverview() {
  state.overview = readOverviewFromControls();
  var granularity = state.overview.granularity;
  var direction = state.overview.direction;
  var seriesA = state.overview.seriesA;
  var seriesB = state.overview.seriesB;
  var seriesBSource = state.overview.seriesBSource;
  var dims = overviewActiveDims(direction, state.overview.levels || defaultOverviewLevels());
  var labelA = overviewMetricLabel(seriesA, 'current');
  var labelB = overviewMetricLabel(seriesB, seriesBSource);

  var rows = applyGlobalFilters(state.rows);
  var series = aggregateCompareSeries(rows, state.months, granularity, seriesA, seriesB, seriesBSource);
  var ta = 0, tb = 0;
  if (granularity === 'Month') {
    rows.forEach(function (r) {
      if (isAvail(r) || isHeader(r)) return;
      state.months.forEach(function (m) {
        ta += overviewMetricValue(r, m, seriesA, 'current');
        tb += overviewMetricValue(r, m, seriesB, seriesBSource);
      });
    });
  } else {
    series.forEach(function (s) {
      ta += s.a;
      tb += s.b;
    });
    if (series.length) {
      ta /= series.length;
      tb /= series.length;
    }
  }
