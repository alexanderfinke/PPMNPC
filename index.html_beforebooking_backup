/** People Lead areas via User Access; null = all (Admin / global). */
function peopleLeadScopedAreas() {
  if (state.role === 'Admin') return null;
  if (!roleHasPeopleLead(state.role)) return { departments: [], units: [] };
  var me = currentActingIdentity().toLowerCase();
  if (!me) return { departments: [], units: [] };
  var list = normalizeAccessList(state.access && state.access.length
    ? state.access
    : ((state.boot && state.boot.access) || []));
  var depts = [];
  var units = [];
  var hasGlobal = false;
  var matchedUser = false;
  list.forEach(function (a) {
    if (a.role_type !== 'people_lead') return;
    var un = String(a.user_name || '').trim().toLowerCase();
    if (un !== me) return;
    matchedUser = true;
    if (a.scope_type === 'global') hasGlobal = true;
    if (a.scope_type === 'department' && a.scope_value) depts.push(String(a.scope_value).trim());
    if (a.scope_type === 'unit' && a.scope_value) units.push(String(a.scope_value).trim());
  });
  if (!matchedUser) return { departments: [], units: [] };
  if (hasGlobal) return null;
  return { departments: unique(depts.filter(Boolean)), units: unique(units.filter(Boolean)) };
}

function peopleLeadScopedDepartments() {
  var areas = peopleLeadScopedAreas();
  if (areas === null) return null;
  return areas.departments || [];
}

function peopleLeadDepartment() {
  var depts = peopleLeadScopedDepartments();
  if (depts == null) return null;
  return depts[0] || null;
}

function employeeDepartmentKeys(emp) {
  return unique([
    emp && emp.group_name,
    emp && emp.department,
    emp && roleDepartmentFromRole(emp.role)
  ].map(function (v) { return String(v || '').trim(); }).filter(function (v) {
    return v && v !== '—';
  }));
}

function employeeUnitKeys(emp) {
  return unique([
    emp && emp.unit,
    emp && roleUnitFromRole(emp.role)
  ].map(function (v) { return String(v || '').trim(); }).filter(function (v) {
    return v && v !== '—';
  }));
}

function employeeMatchesPeopleLeadScope(emp) {
  var areas = peopleLeadScopedAreas();
  if (areas === null) return true;
  var depts = areas.departments || [];
  var units = areas.units || [];
  if (!depts.length && !units.length) return false;
  var deptKeys = employeeDepartmentKeys(emp).map(function (k) { return k.toLowerCase(); });
  var unitKeys = employeeUnitKeys(emp).map(function (k) { return k.toLowerCase(); });
  if (depts.some(function (d) { return deptKeys.indexOf(String(d).toLowerCase()) >= 0; })) return true;
  if (units.some(function (u) { return unitKeys.indexOf(String(u).toLowerCase()) >= 0; })) return true;
  return false;
}

/** Sensitive Comments: Admin (all) or People Lead for assigned department/unit only. */
function canSeeEmployeeComments(emp) {
