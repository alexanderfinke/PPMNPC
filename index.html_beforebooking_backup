          transfer_type: normalizeTransferType(cell.getValue())
        };
      } else {
        rec.transfer_type = normalizeTransferType(cell.getValue());
      }
      upsertFinanceRecord('bookingRecords', rec);
      markFinanceDirty('booking');
    }
  });
  host.classList.add('ppm');
}

function onBookingCellEdited(cell, year) {
  if (!canEditBookingFinance()) return;
  var d = cell.getData();
  var field = cell.getField();
  if (field.indexOf('k_') !== 0) return;
  var mm = field.slice(2);
  var val = cell.getValue();
  val = val === '' || val == null ? null : Number(val);
  if (d._isPair) {
    var rec = findFinanceRecord(state.bookingRecords, 'pair', {
