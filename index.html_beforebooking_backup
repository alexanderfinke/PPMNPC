function commitFiltersFromDraft(opts) {
  opts = opts || {};
  state.globalFilters = clone(state.filterDraft || {});
  state._filterMsDirty = false;
  persistUserSettings();
  renderAll();
  // Keep open filter popups intact while ticking checkboxes
  if (!opts.keepForm && state.filtersVisible) renderGlobalFiltersForm();
  else updateFiltersButtonLabel();
