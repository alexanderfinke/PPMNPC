      formatter: function (cell) {
        var d = cell.getData();
        var raw = d[prefix + mm];
        var hourly = d.hourly_cost || '';
        var shown = financeDisplayValue(raw, hourly, unit);
        var txt = shown == null || shown === '' ? '' : String(shown);
        if (d.missing) txt = txt ? (txt + ' !') : 'missing';
        var dem = compareField ? d[compareField + mm] : null;
        var cls = '';
        if (compareField && raw != null && dem != null) {
          if (Number(raw) + 1e-9 < Number(dem)) cls = 'ppm-budget-low';
          else if (Number(raw) > Number(dem) + 1e-9) cls = 'ppm-budget-high';
        }
        var tip = raw == null ? '' : (raw + ' FTE');
        if (d.manual) tip += ' · manual';
        if (d.pair_locked) tip += ' · locked by pair';
        if (d.auto && d.auto[mm] != null && d.manual) tip += ' · auto was ' + d.auto[mm];
        var html = '<span class="' + cls + '">' + esc(txt) + '</span>';
        return withCellTooltip(cell, tip, html);
      },
      cellEdited: onEdit
    };
  });
}

function flattenFinanceTree(tree) {
  var out = [];
  tree.forEach(function (p) {
    out.push(p);
    (p._children || []).forEach(function (c) {
      c._parent = p.id;
      out.push(c);
    });
  });
  return out;
}

