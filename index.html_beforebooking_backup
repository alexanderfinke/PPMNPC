function overviewTreeExpandAll(expand) {
  var ot = state.tables.overview;
  if (!ot) return;
  function walk(rows) {
    (rows || []).forEach(function (row) {
      if (expand) {
        try { row.treeExpand(); } catch (e) {}
        var kids = [];
        try { kids = row.getTreeChildren() || []; } catch (e2) { kids = []; }
        if (kids.length) walk(kids);
      } else {
        try { row.treeCollapse(); } catch (e3) {}
      }
    });
  }
  walk(ot.getRows());
}

