document.body.addEventListener('click', function (e) {
  var toggle = e.target.closest('[data-ms-toggle]');
  if (toggle) {
    e.preventDefault();
    var root = toggle.closest('.ms-filter');
    var panel = root && root.querySelector('.ms-panel');
    var open = panel && !panel.hasAttribute('hidden');
    var closingOther = false;
    document.querySelectorAll('.ms-panel').forEach(function (p) {
      if (p !== panel && !p.hasAttribute('hidden')) closingOther = true;
      if (p !== panel) p.setAttribute('hidden', '');
    });
    if (closingOther && state._filterMsDirty) commitFiltersFromDraft();
    if (panel && !open) {
      panel.removeAttribute('hidden');
    } else if (panel && open) {
      panel.setAttribute('hidden', '');
      if (state._filterMsDirty) commitFiltersFromDraft();
    }
    return;
  }
  if (e.target.closest('.ms-panel')) return;
  if (!e.target.closest('.ms-filter')) {
    closeMsPanelsApplyingFilters();
  }
});
