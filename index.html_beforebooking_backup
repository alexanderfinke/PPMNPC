    var emp = empKey(r.employee_id);
    if (!emp) return;
    Object.keys(r.months || {}).forEach(function (m) {
      var d = r.months[m] && r.months[m].demand;
      if (d == null || d === '') return;
      map[emp + '|' + ym(m)] = (map[emp + '|' + ym(m)] || 0) + Number(d);
    });
  });
  return map;
}

function accumulateAssigned(rows) {
  var map = {};
  rows.forEach(function (r) {
    if (!countsTowardTotalAlloc(r)) return;
    var emp = empKey(r.employee_id);
    if (!emp) return;
    Object.keys(r.months || {}).forEach(function (m) {
      var a = r.months[m] && r.months[m].allocation;
      if (a == null || a === '') return;
      map[emp + '|' + ym(m)] = (map[emp + '|' + ym(m)] || 0) + Number(a);
    });
  });
  return map;
}

function buildAssigned(rows) {
  return accumulateAssigned(rows);
}

function monthHints(row, m, field) {
  if (field === 'employee' || field === 'budget') return '';
  var capacity = state.capacity;
  var assigned = state.assigned;
  var delta = Number(state.settings.colorDelta) || 0;
  var key = monthKey(m);
  var mk = ym(m);
  // Timeline/Header: no load coloring (phase text / milestones only)
  if (isHeader(row) || isSection(row) || isGroup(row)) return '';

  if (isAvail(row)) {
    // Color only (∑) Alloc vs Avail/Dmnd. Avail/Dmnd stays neutral.
    if (field !== 'allocation') return '';
    var cellA = (row.months && (row.months[key] || row.months[m] || row.months[mk])) || {};
    var capRaw = cellA.demand;
    if (capRaw == null || capRaw === '') {
      var capFallback = capacity[empKey(row.employee_id) + '|' + mk];
      if (capFallback == null) return '';
      capRaw = capFallback;
    }
    var asg = cellA.allocation;
    if (asg == null || asg === '') {
      asg = assigned[empKey(row.employee_id) + '|' + mk];
      if (asg == null) asg = 0;
    }
    if (greaterByDelta(Number(asg), Number(capRaw), delta)) return 'over';
    if (greaterByDelta(Number(capRaw), Number(asg), delta)) return 'under';
    return '';
  }

  var cell = (row.months && (row.months[key] || row.months[m] || row.months[mk])) || {};
  var dem = cell.demand == null || cell.demand === '' ? null : Number(cell.demand);
  var allo = cell.allocation == null || cell.allocation === '' ? null : Number(cell.allocation);
  var unfilled = dem != null && greaterByDelta(dem, allo == null ? 0 : allo, delta);
  var overassigned = allo != null && greaterByDelta(allo, dem == null ? 0 : dem, delta);
  var emp = empKey(row.employee_id);
  var cap = emp ? capacity[emp + '|' + mk] : undefined;
  var sum = emp ? (assigned[emp + '|' + mk] || 0) : 0;

  // Demand column: red when demand not fully covered by this row's allocation
  if (field === 'demand') return unfilled ? 'unfilled' : '';

  // Allocation column: person over capacity, under+unfilled, or row overassigned
  if (cap !== undefined && greaterByDelta(sum, cap, delta)) return 'over';
  if (cap !== undefined && greaterByDelta(cap, sum, delta) && unfilled) return 'under';
  if (overassigned) return 'overassigned';
  return '';
}

function applyMonthHintClass(el, hint) {
  if (!el) return;
  el.classList.remove('ppm-cell-unfilled', 'ppm-cell-over', 'ppm-cell-under', 'ppm-cell-overassigned');
  if (hint === 'unfilled' || hint === 'over' || hint === 'under' || hint === 'overassigned') {
    el.classList.add('ppm-cell-' + hint);
  }
}

function projectLeadScopedProjects() {
  if (state.role === 'Admin') return null;
  if (!roleHasProjectLead(state.role)) return { projectIds: [], programs: [] };
  var me = currentActingIdentity().toLowerCase();
  if (!me) return { projectIds: [], programs: [] };
  var list = normalizeAccessList(state.access && state.access.length
    ? state.access
    : ((state.boot && state.boot.access) || []));
  var projectIds = [];
  var programs = [];
  var hasGlobal = false;
  var matchedUser = false;
  list.forEach(function (a) {
    if (a.is_auto) return;
    if (a.role_type !== 'project_lead') return;
    var un = String(a.user_name || '').trim().toLowerCase();
    if (un !== me) return;
    matchedUser = true;
    if (a.scope_type === 'global') hasGlobal = true;
    if (a.scope_type === 'project' && a.scope_value) projectIds.push(String(a.scope_value));
    if (a.scope_type === 'program' && a.scope_value) programs.push(String(a.scope_value));
  });
  state.projects.forEach(function (p) {
    var lead = String(p.project_lead || '').trim().toLowerCase();
    if (lead && lead === me) {
      projectIds.push(String(p.id));
      matchedUser = true;
    }
  });
  if (!matchedUser) return { projectIds: [], programs: [] };
  if (hasGlobal) return null;
  return { projectIds: unique(projectIds), programs: unique(programs) };
}

function rowInProjectLeadScope(row) {
  var scope = projectLeadScopedProjects();
  if (scope === null) return true;
  var r = (row && row.id != null && findRow(row.id)) || row;
  if (isAvail(r)) return true;
  var projectId = r.project_id;
  if (!projectId) return false;
  if (scope.projectIds.indexOf(String(projectId)) >= 0) return true;
  var proj = state.projectById[projectId];
  if (proj && proj.program && scope.programs.indexOf(String(proj.program)) >= 0) return true;
  return false;
}

function rowInPeopleLeadScope(row) {
  var r = (row && row.id != null && findRow(row.id)) || row;
  if (isAvail(r)) {
    var availEmp = r.employee_id ? state.employeeById[r.employee_id] : null;
    return employeeMatchesPeopleLeadScope(availEmp || r);
  }
  var emp = r.employee_id ? state.employeeById[r.employee_id] : null;
  return employeeMatchesPeopleLeadScope(emp || r);
}

function canEditMonth(role, field, row) {
  // Prefer portfolio row — tree copies can carry stale flags / id types.
  var r = (row && row.id != null && findRow(row.id)) || row;
  if (isPendingDelete(r) || isPendingDelete(row)) return false;
  if (isGroup(r) || isSection(r)) return false;
  if (roleIsViewerOnly(role)) return false;
  if (isHeader(r)) {
    if (!roleHasProjectLead(role) || field !== 'demand') return false;
    return rowInProjectLeadScope(r);
  }
  if (isAvail(r)) {
    // Avail/Dmnd = capacity (Admin / People Lead). (∑) Alloc is computed — never edit.
    // Project Lead must not change Avail / ∑ Alloc month cells.
    if (field !== 'demand') return false;
    if (role === 'Project Lead') return false;
    return roleHasPeopleLead(role) && rowInPeopleLeadScope(r);
  }
  if (field === 'budget') {
    return roleHasProjectLead(role) && rowInProjectLeadScope(r);
  }
  if (field === 'employee') {
    // Employee role: only placeholder names (incl. NN) — not named colleagues.
    if (role === 'Employee') {
      return isEmployeeEditablePlaceholderName(rowDisplayStaffName(r));
    }
    // Project Lead must not edit Employee month columns.
    if (role === 'Project Lead') return false;
    if (!rowHasNamedEmployee(r)) return false;
    if (roleHasPeopleLead(role) && rowInPeopleLeadScope(r)) return true;
    return role === 'Admin';
  }
  if (role === 'Employee') return false;
  if (role === 'Project Lead') return field === 'demand' && rowInProjectLeadScope(r);
  if (role === 'People Lead') return field === 'allocation' && rowInPeopleLeadScope(r);
  if (role === 'People+Project Lead') {
    if (field === 'demand' || field === 'budget') return rowInProjectLeadScope(r);
    if (field === 'allocation') return rowInPeopleLeadScope(r);
    return false;
  }
  return field === 'demand' || field === 'allocation';
}
function canEditText(role, prop, row) {
  if (isPendingDelete(row)) return false;
  if (isGroup(row) || isSection(row)) return false;
  if (roleIsViewerOnly(role)) return false;
  if (employeeMasterEditable(role, row)) {
    if (['name', 'employee_id', 'role', 'group', 'department', 'fte_type', 'people_location', 'comments'].indexOf(prop) >= 0) {
      return true;
    }
  }
  if (role === 'Admin') return true;
  if (role === 'Employee') {
    // Only NN / External Employee / Internal Employee — not other people on the same role.
    if (!isEmployeeEditablePlaceholderName(rowDisplayStaffName(row))) return false;
    return prop === 'notes_employee' || prop === 'project_id' || prop === 'project_topic';
  }
  if (role === 'Project Lead') {
    // No identity / notes / attrs on Avail / ∑ Alloc rows.
    if (isAvail(row)) return false;
    if (['project_id', 'alternative_financing', 'role', 'workpackage', 'notes_project_lead'].indexOf(prop) >= 0) {
      if (prop === 'role' && isFixedRoleStaffName(rowDisplayStaffName(row))) {
        // Named person: role cell stays editable only as locked single-value dropdown.
        return rowInProjectLeadScope(row);
      }
      return rowInProjectLeadScope(row);
    }
    return false;
  }
  if (role === 'People Lead') {
    if (['employee_id', 'role', 'project_id', 'alternative_financing', 'notes_people_lead'].indexOf(prop) >= 0) {
      return rowInPeopleLeadScope(row);
    }
    return isAvail(row) && (prop === 'name' || prop === 'role') && rowInPeopleLeadScope(row);
  }
  if (role === 'People+Project Lead') {
    if (isAvail(row)) {
      return (prop === 'name' || prop === 'role') && rowInPeopleLeadScope(row);
    }
    if (['project_id', 'alternative_financing', 'role', 'workpackage', 'notes_project_lead'].indexOf(prop) >= 0) {
      return rowInProjectLeadScope(row);
    }
    if (['employee_id', 'notes_people_lead'].indexOf(prop) >= 0) {
      return rowInPeopleLeadScope(row);
    }
    return false;
  }
  return false;
}

/* ----- global filters ----- */
function rowFilterValue(row, dim) {
  var project = row.project_id ? state.projectById[row.project_id] : null;
  var employee = row.employee_id ? state.employeeById[row.employee_id] : null;
  switch (dim) {
    case 'Data Type': return dataType(row);
    case 'Project / Topic': return row.project_topic || (project && project.project_topic) || '';
    case 'Program': return (project && project.program) || '';
    case 'Portfolio': return (project && project.portfolio) || '';
    case 'Category': return (project && project.category) || '';
    case 'WBS MA': return (project && project.wbs_ma) || '';
    case 'WBS Indy': return (project && project.wbs_indy) || '';
    case 'Project Lead': return (project && project.project_lead) || '';
    case 'Status': return (project && project.status) || '';
    case 'Department':
      return roleDepartmentFromRole((employee && employee.role) || row.role || '') ||
        (employee && employee.department) || '';
    case 'Group': return (employee && employee.group_name) || '';
    case 'FTE Type': return (employee && employee.fte_type) || '';
    case 'Location': return (employee && employee.people_location) || (project && project.project_location) || '';
    case 'Role': return row.role || '';
    case 'Name': return row.name || '';
    default: return '';
  }
}

function dimensionValues() {
  var out = {};
  FILTER_DIMENSIONS.forEach(function (dim) {
    var set = {};
    if (dim === 'Data Type') {
      ['Dmnd/Alloc', 'Timeline/Header', 'Avail/∑ Alloc'].forEach(function (t) { set[t] = 1; });
    } else {
      state.rows.forEach(function (r) {
        var v = rowFilterValue(r, dim);
        if (v) set[v] = 1;
      });
      state.projects.forEach(function (p) {
        ['Project / Topic', 'Program', 'Portfolio', 'Category', 'WBS MA', 'WBS Indy', 'Project Lead', 'Status', 'Location'].forEach(function (d) {
          if (d !== dim) return;
          var v = d === 'Project / Topic' ? p.project_topic
            : d === 'Location' ? p.project_location
            : p[d === 'Project Lead' ? 'project_lead' : d.toLowerCase().replace(/ /g, '_')] || p[d.toLowerCase().replace(' ', '_')] || '';
          if (d === 'Program') v = p.program;
          if (d === 'Portfolio') v = p.portfolio;
          if (d === 'Category') v = p.category;
          if (d === 'WBS MA') v = p.wbs_ma;
          if (d === 'WBS Indy') v = p.wbs_indy;
          if (d === 'Project Lead') v = p.project_lead;
          if (d === 'Status') v = p.status;
          if (v) set[v] = 1;
        });
      });
      state.employees.forEach(function (e) {
        if (dim === 'Name' && e.name) set[e.name] = 1;
        if (dim === 'Role' && e.role) set[e.role] = 1;
        if (dim === 'Department') {
          var dep = roleDepartmentFromRole(e.role) || e.department;
          if (dep) set[dep] = 1;
        }
        if (dim === 'Group' && e.group_name) set[e.group_name] = 1;
        if (dim === 'FTE Type' && e.fte_type) set[e.fte_type] = 1;
        if (dim === 'Location' && e.people_location) set[e.people_location] = 1;
      });
    }
    out[dim] = Object.keys(set).sort();
  });
  return out;
}

var PROJECT_FILTER_DIMS = [
  'Project / Topic', 'Program', 'Portfolio', 'Category',
  'WBS MA', 'WBS Indy', 'Project Lead', 'Status'
];

function applyGlobalFilters(rows, mode) {
  var active = FILTER_DIMENSIONS.filter(function (d) {
    return (state.globalFilters[d] || []).length > 0;
  });
  if (!active.length) return rows;

  var hasProjectFilter = active.some(function (d) {
    return PROJECT_FILTER_DIMS.indexOf(d) >= 0;
  });

  // Resource Allocation: keep Avail/∑ Alloc parents when project filters would
  // otherwise drop them (they have no project/topic). Only keep those whose
  // employee still has at least one matching assignment row.
  if (mode === 'allocation' && hasProjectFilter) {
    var matchedEmp = {};
    var assignments = [];
    rows.forEach(function (r) {
      if (isAvail(r) || isHeader(r)) return;
      var ok = active.every(function (dim) {
        return state.globalFilters[dim].indexOf(rowFilterValue(r, dim)) >= 0;
      });
      if (!ok) return;
      assignments.push(r);
      var emp = empKey(r.employee_id);
      if (emp) matchedEmp[emp] = 1;
    });
    var avails = [];
    rows.forEach(function (r) {
      if (!isAvail(r)) return;
      var peopleOk = active.every(function (dim) {
        if (PROJECT_FILTER_DIMS.indexOf(dim) >= 0) return true;
        return state.globalFilters[dim].indexOf(rowFilterValue(r, dim)) >= 0;
      });
      if (!peopleOk) return;
      var emp = empKey(r.employee_id);
      if (emp && matchedEmp[emp]) avails.push(r);
    });
    return assignments.concat(avails);
  }

  return rows.filter(function (r) {
    return active.every(function (dim) {
      return state.globalFilters[dim].indexOf(rowFilterValue(r, dim)) >= 0;
    });
  });
}

function projectMatchesFilters(p) {
  var active = FILTER_DIMENSIONS.filter(function (d) {
    return (state.globalFilters[d] || []).length > 0;
  });
  if (!active.length) return true;
  var fake = {
    project_id: p.id,
    project_topic: p.project_topic,
    role: '',
    name: '',
    employee_id: null,
    is_header: false,
    is_availability: false,
    source: 'Demand/Allocation'
  };
  return active.every(function (dim) {
    var employeeDims = ['Department', 'FTE Type', 'Name', 'Group', 'Role', 'Data Type'];
    if (employeeDims.indexOf(dim) >= 0 && dim !== 'Data Type') return true;
    return state.globalFilters[dim].indexOf(rowFilterValue(fake, dim)) >= 0
      || (dim === 'Location' && state.globalFilters[dim].indexOf(p.project_location || '') >= 0);
  });
}

function employeeMatchesFilters(e) {
  var active = FILTER_DIMENSIONS.filter(function (d) {
    return (state.globalFilters[d] || []).length > 0;
  });
  if (!active.length) return true;
  var fake = {
    project_id: null,
    project_topic: '',
    role: e.role,
    name: e.name,
    employee_id: e.id,
    is_header: false,
    is_availability: true,
    source: 'Availability'
  };
  return active.every(function (dim) {
    var projectDims = ['Project / Topic', 'Program', 'Portfolio', 'Category', 'WBS MA', 'WBS Indy', 'Project Lead', 'Status'];
    if (projectDims.indexOf(dim) >= 0) return true;
    return state.globalFilters[dim].indexOf(rowFilterValue(fake, dim)) >= 0;
  });
}

function focusFilter(dim, value, tab) {
  state.globalFilters = {};
  if (value) state.globalFilters[dim] = [String(value)];
  persistUserSettings();
  showTab(tab || 'demand');
  renderAll();
  toast('Filtered by ' + dim + ': ' + value);
}

function rowVisibleForActingRole(r, mode) {
  if (state.role === 'Employee') {
    var me = currentEmployeeRecord();
    if (isHeader(r)) return false;
    if (isAvail(r)) {
      if (!me) return false;
      if (r.employee_id && String(r.employee_id) === String(me.id)) return true;
      return String(r.name || '').trim().toLowerCase() === String(me.name || '').trim().toLowerCase();
    }
    var myRole = (me && me.role) ? String(me.role).trim() : currentUserStaffRole();
    if (!myRole) return false;
    return String(r.role || '').trim() === myRole;
  }
  // Admin / Viewer / Project Lead / People Lead: see all portfolio (edit stays scoped)
  return true;
}

function filteredRows(mode) {
  var showDel = state.settings.showDeletedRows !== false;
  var rows = applyGlobalFilters(state.rows, mode);
  return rows.filter(function (r) {
    if (isPendingDelete(r) && !showDel) return false;
    if (mode === 'demand' && isAvail(r)) return false;
    if (mode === 'allocation' && isHeader(r)) return false;
    return rowVisibleForActingRole(r, mode);
  });
}

function selectionInProjectLeadScope(mode) {
  if (!roleHasProjectLead(state.role) || state.role === 'Admin') return true;
  if (state.role === 'People Lead') return true;
  var ids = collectSelectedRowIds(mode || 'demand');
  var id = ids[0] || state.selectedId;
  if (!id) {
    var anchor = getAddAnchor(mode || 'demand');
    if (!anchor) return false;
    if (isGroup(anchor) || isSection(anchor)) {
      return rowInProjectLeadScope({ project_id: anchor.project_id });
    }
    return rowInProjectLeadScope(anchor);
  }
  var row = findRow(id);
  if (!row) {
    var trow = findTableRow(state.tables[mode || 'demand'], id);
    var d = trow && trow.getData();
    if (d && (isGroup(d) || isSection(d))) return rowInProjectLeadScope({ project_id: d.project_id });
    return false;
  }
  return rowInProjectLeadScope(row);
}

function guardProjectLeadAction(mode, act) {
  if (roleIsViewerOnly(state.role)) {
    var vMut = ['addRow', 'addTimeline', 'addPerson', 'dup', 'del', 'delTopic', 'fillDA', 'fillAD', 'level'].indexOf(act) >= 0;
    if (vMut) {
      toast('Viewer is read-only');
      return false;
    }
    return true;
  }
  if (!roleHasProjectLead(state.role) || state.role === 'Admin') return true;
  if (state.role === 'People Lead') return true;
  var mutating = ['addRow', 'addTimeline', 'dup', 'del', 'delTopic', 'fillDA', 'fillAD', 'level'].indexOf(act) >= 0;
  if (!mutating) return true;
  if (!selectionInProjectLeadScope(mode)) {
    toast('Only allowed for your own projects');
    return false;
  }
  return true;
}

function activeFilterCount() {
  return FILTER_DIMENSIONS.filter(function (d) {
    return (state.globalFilters[d] || []).length > 0;
  }).length;
}

/* ----- tabs ----- */
function showTab(name) {
  state.activeTab = name || 'topics';
  document.querySelectorAll('.tab').forEach(function (t) {
    t.classList.toggle('active', t.getAttribute('data-tab') === name);
  });
  document.querySelectorAll('.panel').forEach(function (p) {
    p.classList.toggle('active', p.id === 'panel-' + name);
  });
  if (name === 'overview') {
    syncOverviewControls();
    refreshOverviewViewsSelect();
    applyFinanceBudgetToRows();
    renderOverview();
  }
  if (name === 'gaps') renderGaps();
  if (name === 'topics') renderTopics();
  if (name === 'employees') renderEmployees();
  if (name === 'access') renderAccess();
  if (name === 'costcenters') renderCostCenters();
  if (name === 'budget') renderBudget();
  if (name === 'booking') renderBooking();
  if (name === 'transfer') renderTransfer();
  if (name === 'demand' || name === 'allocation') {
    var t = state.tables[name];
    if (t) setTimeout(function () { t.redraw(true); }, 30);
  }
  syncFiltersBarPlacement();
  persistUserSettings();
}
$('tabs').onclick = function (e) {
  var t = e.target.closest('.tab');
  if (!t) return;
  showTab(t.getAttribute('data-tab'));
};

/* ----- settings / filters ----- */
function openSettingsDialog() {
  renderGridSettingsForm();
  renderColumnPicker();
  renderWorkspaceSettingsForm();
