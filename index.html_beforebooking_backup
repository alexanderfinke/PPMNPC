/* ----- notify ----- */
function notifyMonthColumnLabel(field) {
  var kind = monthFieldKind(field);
  var ym = String(field || '').slice(2);
  var kindLabel = kind === 'demand' ? 'Dmnd'
    : (kind === 'allocation' ? 'Alloc'
      : (kind === 'employee' ? 'Emp'
        : (kind === 'budget' ? 'Bud' : String(kind || ''))));
  var month = monthLabel(ym.length === 7 ? ym + '-01' : ym);
  return kindLabel + ' ' + month;
}

function notifyHintColor(hint) {
  if (hint === 'unfilled' || hint === 'over') return '#dc2626';
  if (hint === 'under') return '#0284c7';
  if (hint === 'overassigned') return '#ea580c';
  return '';
}

function visibleNotifyColumnDefs(mode) {
  var cols = [];
  var seen = {};
  function add(field, label) {
    if (!field || seen[field]) return;
    seen[field] = 1;
    cols.push({ field: field, label: label || field });
  }
  buildIdentityColumns(mode).forEach(function (c) {
    add(c.field, c.title);
  });
  var table = state.tables[mode];
  if (table && table.getColumns) {
    table.getColumns().forEach(function (col) {
      var f = col.getField && col.getField();
      if (!f || f === '_drag') return;
      if (isMonthField(f)) {
        add(f, notifyMonthColumnLabel(f));
        return;
      }
      var def = col.getDefinition ? col.getDefinition() : {};
      add(f, def.title || f);
    });
  } else {
    var flags = colViewFlags(state.settings.colView, state.role);
    (state.months || []).forEach(function (ym) {
      var key = ym.length === 7 ? ym : String(ym).slice(0, 7);
      if (flags.demand) add('d_' + key, notifyMonthColumnLabel('d_' + key));
      if (flags.allocation) add('a_' + key, notifyMonthColumnLabel('a_' + key));
      if (flags.employee) add('e_' + key, notifyMonthColumnLabel('e_' + key));
      if (flags.budget) add('b_' + key, notifyMonthColumnLabel('b_' + key));
    });
  }
  return cols;
}

function notifyCellValue(row, field) {
  if (!row || !field) return '';
  if (isMonthField(field)) {
    var kind = monthFieldKind(field);
    var ym = field.slice(2);
    var m = row.months && (row.months[ym] || row.months[ym + '-01'] ||
      (ym.length === 7 ? row.months[ym + '-01'] : row.months[String(ym).slice(0, 7)]));
    if (!m) return '';
    var v = m[kind];
    return v == null || v === '' ? '' : String(v);
  }
  if (field === 'dataTypeLabel' || field === 'data_type') {
    if (isAvail(row)) return 'Avail/∑ Alloc';
    if (isHeader(row)) return 'Timeline/Header';
    return 'Dmnd/Alloc';
  }
  if (field === 'project_topic') {
    var p = row.project_id ? state.projectById[row.project_id] : null;
    return String(row.project_topic || (p && p.project_topic) || '');
  }
  if (field === 'name') return rowDisplayStaffName(row);
  if (field === 'changed_by') return formatChangedByOn(row);
  if (field.indexOf('lk_') === 0) {
    var id = field.slice(3);
    var meta = COLUMN_META[id];
    if (meta) return String(lookupField(row, meta) || '');
  }
  if (row[field] != null && row[field] !== '') return String(row[field]);
  return '';
}

function notifyCellColor(row, field) {
  if (!row || !isMonthField(field)) return '';
  var kind = monthFieldKind(field);
  var ym = field.slice(2);
  var monthKey = ym.length === 7 ? ym + '-01' : ym;
  return notifyHintColor(monthHints(row, monthKey, kind));
}

function collectNotifyRowPayloads(modeHint) {
  var mode = modeHint === 'allocation' || modeHint === 'demand'
    ? modeHint
    : (state.activeTab === 'allocation' ? 'allocation'
      : (state.activeTab === 'demand' ? 'demand' : 'demand'));
  var columns = visibleNotifyColumnDefs(mode);
  var ids = collectSelectedRowIds(mode);
  if (!ids.length && state.selectedId && !isEphemeral(state.selectedId)) {
    ids = [state.selectedId];
  }
  var out = [];
  ids.forEach(function (id) {
    var row = findRow(id);
    if (!row || isGroup(row) || isSection(row) || isPendingDelete(row)) return;
    var project = row.project_id ? state.projectById[row.project_id] : null;
    var emp = row.employee_id ? state.employeeById[row.employee_id] : null;
    var type = isAvail(row) ? 'Avail/∑ Alloc' : (isHeader(row) ? 'Timeline/Header' : 'Dmnd/Alloc');
    var cells = {};
    var cellColors = {};
    columns.forEach(function (c) {
      cells[c.label] = notifyCellValue(row, c.field);
      var color = notifyCellColor(row, c.field);
      if (color) cellColors[c.label] = color;
    });
    out.push({
      id: row.id,
      tab: isAvail(row) ? 'allocation' : mode,
      type: type,
      project: row.project_topic || (project && project.project_topic) || '',
      project_id: row.project_id || '',
      role: row.role || (emp && emp.role) || '',
      name: rowDisplayStaffName(row) || '',
      employee_id: row.employee_id || '',
      columns: columns.map(function (c) { return c.label; }),
      cells: cells,
      cellColors: cellColors,
      is_availability: !!isAvail(row),
      is_header: !!isHeader(row)
    });
  });
  return out;
}

function peopleLeadNamesForNotifyRow(row) {
  var list = normalizeAccessList(state.access && state.access.length
    ? state.access
    : ((state.boot && state.boot.access) || []));
  var emp = row.employee_id ? state.employeeById[row.employee_id] : null;
  var scopeSrc = emp || {
    role: row.role,
    group_name: row.group_name,
    department: row.department,
    unit: row.unit
  };
  var names = [];
  list.forEach(function (a) {
    if (a.is_auto) return;
    if (a.role_type !== 'people_lead') return;
    var un = String(a.user_name || a.userName || '').trim();
    if (!un) return;
    if (a.scope_type === 'global') {
      names.push(un);
      return;
    }
    if (a.scope_type === 'department' && a.scope_value) {
      var depts = employeeDepartmentKeys(scopeSrc).map(function (k) { return k.toLowerCase(); });
      if (depts.indexOf(String(a.scope_value).trim().toLowerCase()) >= 0) names.push(un);
    }
    if (a.scope_type === 'unit' && a.scope_value) {
      var units = employeeUnitKeys(scopeSrc).map(function (k) { return k.toLowerCase(); });
      if (units.indexOf(String(a.scope_value).trim().toLowerCase()) >= 0) names.push(un);
    }
  });
  return unique(names);
}

function projectLeadNamesForNotifyRow(row) {
  var project = row.project_id ? state.projectById[row.project_id] : null;
  var lead = String((project && project.project_lead) || '').trim();
  return lead ? [lead] : [];
}

function employeeNamesForNotifyRow(row) {
  var name = rowDisplayStaffName(row);
  if (!name) return [];
  if (isEmployeeEditablePlaceholderName(name)) return [];
  if (NEW_HIRE_RE.test(name)) return [];
  return [name];
}

function looksLikeEmailClient(v) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v || '').trim());
}

function ensureNotifyState() {
  if (!state._notify) {
    state._notify = {
      rows: [],
      extras: [],
      directory: {},
      recipients: []
    };
  }
  return state._notify;
}

function buildNotifyRecipientDraft() {
  var n = ensureNotifyState();
  var wantPL = $('notifyPeopleLead') && $('notifyPeopleLead').checked;
  var wantProj = $('notifyProjectLead') && $('notifyProjectLead').checked;
  var wantEmp = $('notifyEmployee') && $('notifyEmployee').checked;
  var byKey = {};
  function add(name, roleLabel) {
    var raw = String(name || '').trim();
    if (!raw) return;
    var key = looksLikeEmailClient(raw) ? raw.toLowerCase() : raw.toLowerCase();
    if (!byKey[key]) {
      byKey[key] = {
        key: key,
        name: raw,
        roleLabels: [],
        email: '',
        source: 'pending'
      };
    }
    if (roleLabel && byKey[key].roleLabels.indexOf(roleLabel) < 0) {
      byKey[key].roleLabels.push(roleLabel);
    }
  }
  (n.rows || []).forEach(function (row) {
    if (wantPL) peopleLeadNamesForNotifyRow(row).forEach(function (nm) { add(nm, 'People Lead'); });
    if (wantProj) projectLeadNamesForNotifyRow(row).forEach(function (nm) { add(nm, 'Project Lead'); });
    if (wantEmp) employeeNamesForNotifyRow(row).forEach(function (nm) { add(nm, 'Employee'); });
  });
  (n.extras || []).forEach(function (ex) { add(ex, 'Additional'); });
  return Object.keys(byKey).map(function (k) { return byKey[k]; }).sort(function (a, b) {
    return a.name.toLowerCase().localeCompare(b.name.toLowerCase());
  });
}

function applyDirectoryToRecipients(draft, directory) {
  directory = directory || {};
  return draft.map(function (r) {
    var hit = directory[r.name] || directory[r.key];
    if (!hit) {
      // try case-insensitive scan
      Object.keys(directory).forEach(function (k) {
        if (String(k).toLowerCase() === r.key) hit = directory[k];
      });
    }
    var email = '';
    var source = 'missing';
    if (looksLikeEmailClient(r.name)) {
      email = String(r.name).trim();
      source = 'direct';
    } else if (hit && hit.email) {
      email = String(hit.email).trim();
      source = hit.source || 'activity_logger';
    }
    // Preserve user-typed email if already entered for this key
    var prev = (ensureNotifyState().recipients || []).find(function (p) {
      return p.key === r.key;
    });
    if (prev && prev.emailTyped) email = prev.emailTyped;
    return {
      key: r.key,
      name: (hit && hit.name) || r.name,
      roleLabel: (r.roleLabels || []).join(', '),
      email: email,
      emailTyped: prev && prev.emailTyped ? prev.emailTyped : '',
      source: source,
      missing: !looksLikeEmailClient(email)
    };
  });
}

function renderNotifyRowsList() {
  var n = ensureNotifyState();
  var host = $('notifyRowsList');
  var hint = $('notifyRowsHint');
  if (!host) return;
  if (!n.rows.length) {
    host.innerHTML = '';
    if (hint) hint.textContent = 'No rows selected. Select cells/rows in Capacity Demand or Resource Allocation first.';
    return;
  }
  if (hint) hint.textContent = n.rows.length + ' selected row' + (n.rows.length === 1 ? '' : 's') + ':';
  host.innerHTML = n.rows.map(function (r) {
    return '<div>' + esc(r.type) + ' · <b>' + esc(r.project || '—') + '</b> · ' +
      esc(r.role || '—') + ' · ' + esc(r.name || '—') +
      ' <span class="meta">(' + ((r.columns && r.columns.length) || 0) + ' cols)</span></div>';
  }).join('');
}

function renderNotifyRecipients() {
  var n = ensureNotifyState();
  var host = $('notifyRecipients');
  var meta = $('notifyRecipMeta');
  var err = $('notifyEmailError');
  if (!host) return;
  if (err) { err.hidden = true; err.textContent = ''; }
  if (!n.recipients.length) {
    host.innerHTML = '<p class="hint">No recipients for the current selection / options.</p>';
    if (meta) meta.textContent = '';
    return;
  }
  var missing = n.recipients.filter(function (r) { return r.missing; }).length;
  if (meta) {
    meta.textContent = '(' + n.recipients.length +
      (missing ? (', ' + missing + ' need email') : '') + ')';
  }
  host.innerHTML = n.recipients.map(function (r) {
    var emailVal = r.emailTyped || r.email || '';
    return '<div class="notify-recip' + (r.missing ? ' missing' : '') + '" data-recip-key="' + esc(r.key) + '">' +
      '<div><b>' + esc(r.name) + '</b>' +
      (r.roleLabel ? ('<div class="role-tag">' + esc(r.roleLabel) + '</div>') : '') +
      '</div>' +
      '<input type="email" data-recip-email="' + esc(r.key) + '" value="' + esc(emailVal) +
      '" placeholder="email@company.com">' +
      '<button type="button" class="btn" data-recip-remove="' + esc(r.key) + '" title="Remove">×</button>' +
      '</div>';
  }).join('');

  host.querySelectorAll('[data-recip-email]').forEach(function (input) {
    input.addEventListener('input', function () {
      var key = input.getAttribute('data-recip-email');
      var val = String(input.value || '').trim();
      n.recipients.forEach(function (r) {
        if (r.key !== key) return;
        r.emailTyped = val;
        r.email = val;
        r.missing = !looksLikeEmailClient(val);
        input.closest('.notify-recip').classList.toggle('missing', r.missing);
      });
    });
  });
  host.querySelectorAll('[data-recip-remove]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-recip-remove');
      n.recipients = n.recipients.filter(function (r) { return r.key !== key; });
      n.extras = (n.extras || []).filter(function (ex) {
        return String(ex).trim().toLowerCase() !== key;
      });
