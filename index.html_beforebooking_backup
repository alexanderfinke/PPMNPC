  });
}

function refreshNotifyRecipientsFromOptions(done) {
  var draft = buildNotifyRecipientDraft();
  var names = draft.map(function (r) { return r.name; });
  if (!names.length) {
    ensureNotifyState().recipients = [];
    renderNotifyRecipients();
    if (done) done();
    return;
  }
  var btn = $('btnNotifySend');
  if (btn) { btn.disabled = true; btn.textContent = 'Looking up emails…'; }
  google.script.run
    .withSuccessHandler(function (res) {
      var dir = (res && res.directory) || {};
      ensureNotifyState().directory = dir;
      ensureNotifyState().recipients = applyDirectoryToRecipients(draft, dir);
      renderNotifyRecipients();
      if (btn) { btn.disabled = false; btn.textContent = 'Send email'; }
      if (done) done();
    })
    .withFailureHandler(function (e) {
      ensureNotifyState().recipients = applyDirectoryToRecipients(draft, {});
      renderNotifyRecipients();
      if (btn) { btn.disabled = false; btn.textContent = 'Send email'; }
