function closeMsPanelsApplyingFilters() {
  var hadOpen = false;
  document.querySelectorAll('.ms-panel').forEach(function (p) {
    if (!p.hasAttribute('hidden')) hadOpen = true;
    p.setAttribute('hidden', '');
  });
  if (hadOpen && state._filterMsDirty) commitFiltersFromDraft();
  return hadOpen;
}

function renderGlobalFiltersForm() {
  state.filterDraft = clone(state.globalFilters || {});
  state._filterMsDirty = false;
  var host = $('globalFiltersForm');
  if (!host) return;
  var vals = dimensionValues();
  host.innerHTML = FILTER_DIMENSIONS.map(function (dim) {
    var selected = state.filterDraft[dim] || [];
    var active = selected.length > 0;
    var options = vals[dim] || [];
    var checks = options.map(function (v) {
      var on = selected.indexOf(v) >= 0;
      return '<label class="ms-option"><input type="checkbox" data-ms-dim="' + esc(dim) + '" value="' + esc(v) + '"' +
        (on ? ' checked' : '') + '> <span>' + esc(v) + '</span></label>';
    }).join('');
    return '<div class="ms-filter" data-ms-root="' + esc(dim) + '">' +
      '<button type="button" class="ms-trigger' + (active ? ' active' : '') + '" data-ms-toggle="' + esc(dim) + '">' +
      esc(dim) + (active ? (' · ' + selected.length) : '') + ' ▾</button>' +
      '<div class="ms-panel" hidden>' +
      '<input type="search" class="ms-search" placeholder="Search…" data-ms-search="' + esc(dim) + '">' +
