function sendNotifyEmail() {
  var n = ensureNotifyState();
  var err = $('notifyEmailError');
  if (!n.rows.length) {
    if (err) { err.hidden = false; err.textContent = 'No rows selected.'; }
    return;
  }
  // Sync typed emails from DOM
  document.querySelectorAll('[data-recip-email]').forEach(function (input) {
