function buildIdentityColumns(mode) {
  var order = mode === 'demand' ? DEMAND_COLUMN_ORDER : ALLOCATION_COLUMN_ORDER;
  var hidden = state.settings.hiddenColumns || [];
  var frozenCount = Number(state.settings.frozenCols) || 0;
  var roleValues = unique((state.meta.Role || []).concat(state.rows.map(function (r) { return r.role; })).concat(state.employees.map(function (e) { return e.role; })));
  var nameValues = unique(state.employees.map(function (e) { return e.name; }));
  var projectValues = unique(state.projects.filter(function (p) {
    if (!roleHasProjectLead(state.role) || state.role === 'Admin') return true;
    return rowInProjectLeadScope({ project_id: p.id });
  }).map(function (p) { return p.project_topic; }));
  if (state.role === 'Employee') {
    nameValues = [];
    var meEmp = currentEmployeeRecord();
    if (meEmp && meEmp.name) nameValues = [meEmp.name];
  }
  var groupValues = unique((state.meta.Group || state.meta.Department || []).concat(state.employees.map(function (e) { return e.group_name; })));
  var fteValues = unique((state.meta['FTE Type'] || []).concat(state.employees.map(function (e) { return e.fte_type; })));
  var locValues = unique((state.meta.Location || []).concat(state.employees.map(function (e) { return e.people_location; })));
  var visible = order.filter(function (id) {
    return COLUMN_META[id] && (COLUMN_META[id].hideable === false || hidden.indexOf(id) < 0);
  });
  return visible.map(function (id, idx) {
    var m = COLUMN_META[id];
    var field = m.lookup ? ('lk_' + id) : (id === 'data_type' ? 'dataTypeLabel' : (m.prop === 'project_id' ? 'project_topic' : m.prop === 'employee_id' ? 'name' : (m.prop || id)));
    var col = {
      title: m.label,
      field: field,
      width: m.width,
      headerSort: false,
      frozen: idx < frozenCount,
      cssClass: id === 'data_type' ? 'ppm-data-type' : ''
    };
    var peopleLookup = m.lookup === 'employee' && PEOPLE_MASTER_FIELDS[id];
    if (id === 'changed_by' || id === 'data_type') {
      col.editor = false;
      col.editable = false;
      col.formatter = function (cell) {
        var d = cell.getData();
        var src = (d && d.id != null && findRow(d.id)) || d;
        if (id === 'changed_by') {
          var text = formatChangedByOn(src || d);
          var tip = changeHistoryTooltip(src || d);
          return withCellTooltip(cell, tip, esc(text));
        }
        var text2 = cell.getValue() == null ? '' : String(cell.getValue());
        return withCellTooltip(cell, text2, esc(text2));
      };
    } else if (m.lookup && !peopleLookup) {
      col.editor = false;
      col.editable = false;
      col.formatter = function (cell) {
        var text = cell.getValue() == null ? '' : String(cell.getValue());
        return withCellTooltip(cell, text, esc(text));
      };
    } else if (peopleLookup || m.prop) {
      var editProp = peopleLookup
        ? (id === 'group' || id === 'department' ? 'group' : id === 'name' ? 'employee_id' : id)
        : (m.prop === 'project_id' ? 'project_id' : m.prop === 'employee_id' ? 'employee_id' : m.prop);
      var listValues = null;
      if (field === 'role' || id === 'role') listValues = roleValues;
      else if (field === 'name' || id === 'name') listValues = nameValues;
      else if (field === 'project_topic' || field === 'alternative_financing') listValues = projectValues;
      else if (id === 'group' || id === 'department') listValues = groupValues;
      else if (id === 'fte_type') listValues = fteValues;
      else if (id === 'people_location') listValues = locValues;
      if (listValues && listValues.length) {
        col.editor = 'list';
        col.editorParams = function (cell) {
          var row = cell.getData();
          var values = listValues;
          var roleLocked = (field === 'role' || id === 'role') && isFixedRoleStaffName(rowDisplayStaffName(row));
          if (roleLocked) {
            var curRole = String(row.role || '').trim();
            values = curRole ? [curRole] : [];
          } else if ((field === 'name' || id === 'name') && row.role) {
            var filtered = state.employees.filter(function (e) {
              return !e.role || e.role === row.role || e.id === row.employee_id;
            }).map(function (e) { return e.name; });
            if (row.name && filtered.indexOf(row.name) < 0) filtered = [row.name].concat(filtered);
            values = unique(filtered.length ? filtered : listValues);
          }
          return {
            values: values,
            autocomplete: true,
            listOnEmpty: true,
            freetext: !roleLocked,
            allowEmpty: !roleLocked
          };
        };
      } else {
        col.editor = textEditor;
      }
      col.editable = function (cell) {
        var row = cell.getData();
        if (peopleLookup) return employeeMasterEditable(state.role, row);
        return canEditText(state.role, editProp, row);
      };
      var isList = col.editor === 'list';
      col.formatter = function (cell) {
        var row = cell.getData();
        var el = cell.getElement();
        var editable = peopleLookup
          ? employeeMasterEditable(state.role, row)
          : canEditText(state.role, editProp, row);
        el.classList.toggle('ppm-cell-editable-regular', editable && !isAvail(row) && !isHeader(row));
        el.classList.toggle('ppm-cell-editable-special', editable && (isAvail(row) || isHeader(row)));
        var text = cell.getValue() == null ? '' : String(cell.getValue());
        var reference = (!isGroup(row) && !isSection(row) && !isAvail(row) && !isHeader(row))
          ? fieldReferenceLabel(row, id, editProp, text)
          : undefined;
        var tip = reference !== undefined ? (reference + ' → ' + text) : text;
        if (isList && editable && !isGroup(row) && !isSection(row)) {
          var inner = reference !== undefined ? formatTextWithBaseline(text, reference) : esc(text);
          el.classList.toggle('ppm-diff', reference !== undefined);
          return withCellTooltip(cell, tip,
            '<span class="ppm-list-cell"><span class="ppm-list-text">' + inner +
            '</span><span class="ppm-list-chevron" aria-hidden="true">▾</span></span>');
        }
        return decorateIdentityCell(cell, text, reference, tip);
      };
    }
    if (id === 'project_topic' || id === 'name') {
      col.formatter = function (cell) {
        var d = cell.getData();
        var el = cell.getElement();
        var editProp2 = id === 'project_topic' ? 'project_id' : 'employee_id';
        var editable = canEditText(state.role, editProp2, d) || (id === 'name' && employeeMasterEditable(state.role, d));
        el.classList.toggle('ppm-cell-editable-regular', editable && !isAvail(d) && !isHeader(d));
        el.classList.toggle('ppm-cell-editable-special', editable && (isAvail(d) || isHeader(d)));
        if (isSection(d)) {
          var sectionText = d.section_label || d.displayName || '';
          return withCellTooltip(cell, sectionText, esc(sectionText));
        }
        if (isGroup(d) && mode === 'demand') {
          var groupText = d.displayName || '';
          return withCellTooltip(cell, groupText, esc(groupText));
        }
        // Do not cross-fill name ↔ project_topic via displayName fallback
        var raw = cell.getValue();
        var text = raw == null || raw === '' ? '' : String(raw);
        var reference = (!isGroup(d) && !isSection(d) && !isAvail(d) && !isHeader(d))
          ? fieldReferenceLabel(d, id, editProp2, text)
          : undefined;
        var tip = reference !== undefined ? (reference + ' → ' + text) : text;
        var useList = col.editor === 'list' && editable;
        if (useList) {
          el.classList.toggle('ppm-diff', reference !== undefined);
          var inner2 = reference !== undefined ? formatTextWithBaseline(text, reference) : esc(text);
          return withCellTooltip(cell, tip,
            '<span class="ppm-list-cell"><span class="ppm-list-text">' + inner2 +
            '</span><span class="ppm-list-chevron" aria-hidden="true">▾</span></span>');
        }
        return decorateIdentityCell(cell, text, reference, tip);
      };
    }
    return col;
  });
}

function buildColumns(mode) {
  var flags = colViewFlags(state.settings.colView, state.role);
  var showD = flags.demand;
  var showA = flags.allocation;
  var showE = flags.employee;
  var showB = flags.budget;
  var cols = [];
  if (mode === 'demand') {
    cols.push({
      title: '',
      field: '_drag',
      width: 28,
      minWidth: 28,
      maxWidth: 28,
      headerSort: false,
      resizable: false,
      frozen: true,
      clipboard: false,
      cssClass: 'ppm-row-drag',
      formatter: function (cell) {
        var d = cell.getData();
        if (isSection(d) || isGroup(d) || isEphemeral(d.id)) return '';
        if (state.role === 'Employee' || roleIsViewerOnly(state.role)) return '';
        if (roleHasProjectLead(state.role) && state.role !== 'Admin' && !rowInProjectLeadScope(d)) return '';
        return '<span class="ppm-drag-grip" draggable="true" data-row-id="' + esc(String(d.id)) +
          '" title="Drag to reorder">⋮⋮</span>';
      }
    });
  }
  cols = cols.concat(buildIdentityColumns(mode));
  if (cols.length <= (mode === 'demand' ? 1 : 0)) {
    cols.push({
      title: mode === 'demand' ? 'Name / Topic' : 'Name',
      field: 'displayName',
      width: 200,
      frozen: true,
      headerSort: false
    });
  }

  state.months.forEach(function (m) {
    var mk = ym(m);
    var children = [];
    if (showD) {
      children.push({
        title: mode === 'allocation' ? 'Avail/Dmnd' : 'Dmnd',
        field: 'd_' + mk,
        width: 72,
        hozAlign: 'right',
        headerSort: false,
        cssClass: 'ppm-month',
        formatter: monthFormatter(m, 'demand'),
        editor: monthEditor(m, 'demand'),
        editable: monthEditable(m, 'demand'),
        cellEdited: onMonthEdited
      });
    }
    if (showA) {
      children.push({
        title: mode === 'allocation' ? '(∑) Alloc' : 'Alloc',
        field: 'a_' + mk,
        width: 72,
        hozAlign: 'right',
        headerSort: false,
        cssClass: 'ppm-month',
        formatter: monthFormatter(m, 'allocation'),
        editor: monthEditor(m, 'allocation'),
        editable: monthEditable(m, 'allocation'),
        cellEdited: onMonthEdited
      });
    }
    if (showE) {
      children.push({
        title: 'Employee',
        field: 'e_' + mk,
        width: 80,
        hozAlign: 'right',
        headerSort: false,
        cssClass: 'ppm-month ppm-month-employee',
        formatter: monthFormatter(m, 'employee'),
        editor: monthEditor(m, 'employee'),
        editable: monthEditable(m, 'employee'),
        cellEdited: onMonthEdited
      });
    }
    if (showB) {
      children.push({
        title: 'Budget',
        field: 'b_' + mk,
        width: 80,
        hozAlign: 'right',
        headerSort: false,
        cssClass: 'ppm-month ppm-month-budget',
        formatter: monthFormatter(m, 'budget'),
        editor: monthEditor(m, 'budget'),
        editable: monthEditable(m, 'budget'),
        cellEdited: onMonthEdited
      });
    }
    if (children.length) {
      cols.push({ title: monthLabel(m), cssClass: 'ppm-month-group', columns: children });
    }
  });
  return cols;
}

function textEditable(prop) {
  return function (cell) {
    return canEditText(state.role, prop, cell.getData());
  };
}
function monthEditable(m, field) {
  return function (cell) {
    return canEditMonth(state.role, field, cell.getData());
  };
}

function textEditor(cell, onRendered, success, cancel) {
  var input = document.createElement('input');
  input.type = 'text';
  input.value = cell.getValue() == null ? '' : String(cell.getValue());
  input.style.width = '100%';
  input.style.boxSizing = 'border-box';
  onRendered(function () { input.focus(); input.select(); });
  function commit() {
    var next = input.value;
    // Apply to portfolio state immediately — tree rows are clones of state.rows.
    syncIdentityFromCell(cell, next);
    success(next);
  }
  input.addEventListener('blur', commit);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') commit();
    if (e.key === 'Escape') cancel();
  });
  return input;
}

/**
 * Tree/grid rows are clones. Persist identity-column edits onto state.rows and mark dirty.
 * valueOverride: when committing from a custom editor before Tabulator stores the value.
 */
function syncIdentityFromCell(cell, valueOverride) {
  if (!cell) return false;
  var field = cell.getField();
  if (!field || field === '_drag' || isMonthField(field)) return false;
  var d = cell.getData();
  if (!d || isGroup(d) || isSection(d)) return false;
  var src = findRow(d.id);
  if (!src) return false;

  var propMap = {
    project_topic: 'project_topic',
    name: 'name',
    role: 'role',
    workpackage: 'workpackage',
    notes_people_lead: 'notes_people_lead',
    notes_project_lead: 'notes_project_lead',
    notes_employee: 'notes_employee',
    comments: 'comments',
    alternative_financing: 'alternative_financing',
    lk_group: 'group',
    lk_department: 'department',
    lk_fte_type: 'fte_type',
    lk_people_location: 'people_location'
  };
  if (!propMap[field]) return false;
  var prop = propMap[field];
  var raw = valueOverride !== undefined ? valueOverride : cell.getValue();

  if (employeeMasterEditable(state.role, src) && PEOPLE_MASTER_FIELDS[prop]) {
    var empField = PEOPLE_MASTER_FIELDS[prop];
    var emp = src.employee_id ? state.employeeById[src.employee_id] : null;
    if (emp) {
      var patch = { id: emp.id };
      patch[empField] = raw || '';
      if (empField === 'group_name') {
        // Group only — department stays role-derived
        var empRec = state.employeeById[src.employee_id];
        if (empRec) patch.department = roleDepartmentFromRole(empRec.role || src.role);
      }
      if (empField === 'name') src.name = patch.name;
      if (empField === 'role') src.role = patch.role;
      upsertEmployeeMaster(Object.assign({}, emp, patch), empField === 'name' || empField === 'role');
      setDirty(true);
      return true;
    }
  }
  var editProp = prop === 'project_topic' ? 'project_id' : prop === 'name' ? 'employee_id' : prop;
  if (!canEditText(state.role, editProp, src)) return false;

  var text = raw == null ? '' : String(raw);
  if (prop === 'project_topic') {
    var match = state.projects.find(function (p) { return p.project_topic === text; });
    if (match) {
      if (roleHasProjectLead(state.role) && state.role !== 'Admin' && !rowInProjectLeadScope({ project_id: match.id })) {
        toast('Only allowed for your own projects');
        return false;
      }
      src.project_id = match.id; src.project_topic = match.project_topic;
    }
    else { src.project_topic = text || null; }
  } else if (prop === 'name') {
    var emp2 = state.employees.find(function (e) { return e.name === text; });
    if (emp2) {
      src.employee_id = emp2.id;
      src.name = emp2.name;
      if (emp2.role) src.role = emp2.role;
    } else {
      src.name = text || null;
    }
  } else if (prop === 'alternative_financing') {
    var alt = state.projects.find(function (p) { return p.project_topic === text; });
    src.alternative_financing = alt ? alt.id : (text || null);
    src.alternative_financing_topic = alt ? alt.project_topic : (text || null);
  } else {
    src[prop] = text || null;
  }
  if (prop === 'role') {
    // Named people: Project Lead (and combined) may not change role away from current.
    if (isFixedRoleStaffName(rowDisplayStaffName(src))) {
      var prevRole = String(src.role || '').trim();
      var nextRole = String(text || '').trim();
      if (prevRole && nextRole && prevRole.toLowerCase() !== nextRole.toLowerCase()) {
        if (state.role === 'Project Lead' || state.role === 'People+Project Lead') {
          toast('Role is locked for named resources');
          return false;
        }
      }
    }
    ensureNnEmployeeForRole(src, text);
  }
  setDirty(true);
  return true;
}

function monthEditor(m, field) {
  return function (cell, onRendered, success, cancel) {
    var row = cell.getData();
    var src = findRow(row.id) || row;
    if (!canEditMonth(state.role, field, src)) { cancel(); return; }
    var input = document.createElement('input');
    input.type = 'text';
    var v = cell.getValue();
    input.value = v == null || v === '' ? '' : String(v);
    input.style.width = '100%';
    input.style.boxSizing = 'border-box';
    onRendered(function () { input.focus(); input.select(); });
    function commit() {
      var raw = input.value.trim();
      if (isHeader(src) && field === 'demand') { success(raw); return; }
      if (raw === '') { success(null); return; }
      var num = Number(String(raw).replace(',', '.'));
      if (isNaN(num)) { toast('Enter a number'); cancel(); return; }
      success(num);
    }
    input.addEventListener('blur', commit);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') commit();
      if (e.key === 'Escape') cancel();
    });
    return input;
  };
}

function formatMonthCellHtml(current, snapVal, initialVal, field, hint) {
  var display = current == null || current === '' || (typeof current === 'number' && isNaN(current))
    ? ''
    : String(current);
  var curN = display === '' ? null : Number(display);
  var showSnap = snapVal !== undefined && valuesDiffer(curN, snapVal == null || snapVal === '' ? null : Number(snapVal));
  var initN = initialVal == null || initialVal === '' ? null : Number(initialVal);
  var showDirty = initialVal !== undefined && valuesDiffer(curN, initN);
  if (showDirty && showSnap && !valuesDiffer(initN, snapVal == null || snapVal === '' ? null : Number(snapVal))) {
    showDirty = false;
  }
  if (!showSnap && !showDirty) {
    if (display === '') return '';
    var aloneClass = hint ? ('ppm-cell-current val-' + hint) : 'ppm-cell-current';
    return '<span class="' + aloneClass + '">' + esc(display) + '</span>';
  }

  var refOnLeft = field === 'demand';
  var snapHtml = showSnap
    ? '<span class="ppm-cell-baseline">' + esc(snapVal == null || snapVal === '' ? '–' : String(snapVal)) + '</span>'
    : '';
  var dirtyHtml = showDirty
    ? '<span class="ppm-cell-dirty">' + esc(initN == null ? '–' : String(initN)) + '</span>'
    : '';
  var curClass = 'ppm-cell-current' + (hint ? (' val-' + hint) : '');
  var curHtml = '<span class="' + curClass + '">' + esc(display === '' ? '–' : display) + '</span>';
  var align = refOnLeft ? 'ppm-cell-with-baseline--end' : 'ppm-cell-with-baseline--start';
  var inner = refOnLeft ? (snapHtml + dirtyHtml + curHtml) : (curHtml + dirtyHtml + snapHtml);
  return '<span class="ppm-cell-with-baseline ' + align + '">' + inner + '</span>';
}

function formatPhaseCellHtml(phaseText, snapRef, sessionRef) {
  var cur = phaseText == null ? '' : String(phaseText);
  var showSnap = snapRef !== undefined;
  var showDirty = sessionRef !== undefined && String(sessionRef) !== cur &&
    !(showSnap && String(sessionRef) === String(snapRef === '–' ? '' : snapRef));
  if (!showSnap && !showDirty) {
    return cur ? ('<span class="ppm-milestone-label">' + esc(cur) + '</span>') : '';
  }
  var snapHtml = showSnap
    ? '<span class="ppm-cell-baseline">' + esc(snapRef === '' ? '–' : String(snapRef)) + '</span>'
    : '';
  var dirtyHtml = showDirty
    ? '<span class="ppm-cell-dirty">' + esc(sessionRef === '' ? '–' : String(sessionRef)) + '</span>'
    : '';
  var curHtml = '<span class="ppm-cell-current">' + esc(cur || '–') + '</span>';
  return '<span class="ppm-cell-with-baseline ppm-cell-with-baseline--end">' +
    snapHtml + dirtyHtml + curHtml + '</span>';
}

function monthFormatter(m, field) {
  return function (cell) {
    var row = cell.getData();
    if (isGroup(row) || isSection(row)) return '';
    // Timeline colors/labels on Demand and Allocation; other month fields stay blank
    if (isHeader(row) && field !== 'demand' && field !== 'allocation') return '';
    if (isAvail(row) && (field === 'employee' || field === 'budget')) return '';

    var key = monthKey(m);
    var mk = ym(m);
    var src = findRow(row.id) || row;
    var value = cell.getValue();
    // Availability parents: always prefer live portfolio months / assigned totals
    if ((isAvail(src) || isAvail(row)) && (field === 'demand' || field === 'allocation')) {
      var cellSrc = (src.months && (src.months[key] || src.months[m] || src.months[mk])) || {};
      if (field === 'demand') {
        value = cellSrc.demand;
        if (value == null || value === '') {
          var cap = state.capacity[empKey(src.employee_id) + '|' + mk];
          if (cap != null) value = cap;
        }
      } else {
        var asg = state.assigned[empKey(src.employee_id) + '|' + mk];
        value = asg !== undefined ? roundFte(asg) : cellSrc.allocation;
        if (value != null && value !== '') value = roundFte(value);
      }
    } else if (field === 'employee' || field === 'budget') {
      var cellEB = (src.months && (src.months[key] || src.months[m] || src.months[mk])) || {};
      value = cellEB[field];
    }
    var display = value == null || value === '' ? '' : String(value);
    var editable = canEditMonth(state.role, field, src);
    var hint = monthHints(src, m, field);
    var special = isAvail(src) || isHeader(src);

    var cmp = state.compare[src.id] || state.compare[row.id];
    var showDiffs = state.settings.showDiffs !== false;
    var snapVal = undefined;
    var isDiff = false;
    if (showDiffs && cmp && !isAvail(src) && !isHeader(src)) {
      var sc = cmp.months && (cmp.months[key] || cmp.months[m]);
      if (sc) {
        snapVal = sc[field] == null || sc[field] === '' ? null : Number(sc[field]);
      } else {
        snapVal = null;
      }
      var curN = display === '' ? null : Number(display);
      if (sc) isDiff = valuesDiffer(curN, snapVal);
      else if (curN != null && curN !== 0) isDiff = true;
      if (!isDiff) snapVal = undefined;
    }

    var initialVal = undefined;
    if (!isEphemeral(row.id) && !isHeader(src)) {
      var init = sessionMonthValue(src.id || row.id, m, field);
      if (init !== undefined) {
        var curN2 = display === '' ? null : Number(display);
        if (valuesDiffer(curN2, init)) initialVal = init;
      }
    }

    var el = cell.getElement();
    var span = null;
    if (isHeader(src) && (field === 'demand' || field === 'allocation')) {
      var spans = milestoneSpanStyles(src.phases || row.phases || {}, state.months);
      span = spans[ym(m)] || spans[monthKey(m)] || spans[m] || null;
    }
    // Milestone span months: no yellow editable fill (would hide pastel colours)
    el.classList.toggle('ppm-cell-editable-regular', editable && !special && !span);
    el.classList.toggle('ppm-cell-editable-special', editable && special && !span);
    el.classList.toggle('ppm-diff', isDiff);
    el.classList.toggle('ppm-month-demand', field === 'demand');
    el.classList.toggle('ppm-month-alloc', field === 'allocation');
    el.classList.toggle('ppm-milestone-span', !!span);
    applyMonthHintClass(el, isHeader(src) ? '' : hint);

    if (isHeader(src) && (field === 'demand' || field === 'allocation')) {
      var phases = src.phases || row.phases || {};
      var phaseText = span && span.label != null
        ? String(span.label)
        : String(phases[key] || phases[m] || phases[mk] || (field === 'demand' ? display : '') || '');
      var phaseRef = undefined;
      var phaseDiff = false;
      if (showDiffs && cmp) {
        var snapPhases = cmp.phases || {};
        var snapPhase = snapPhases[key] || snapPhases[m] || snapPhases[mk] || '';
        var curPhase = phaseText || '';
        if (String(snapPhase) !== String(curPhase)) {
          phaseDiff = true;
          phaseRef = snapPhase === '' ? '–' : String(snapPhase);
        } else if (!Object.keys(snapPhases).length && curPhase) {
          phaseDiff = true;
          phaseRef = '–';
        }
      }
      var phaseSession = undefined;
      if (!isEphemeral(row.id)) {
        var sess = sessionPhaseValue(src.id || row.id, m);
        if (sess !== undefined && String(sess) !== String(phaseText || '')) {
          phaseSession = sess;
        }
      }
      el.classList.toggle('ppm-diff', phaseDiff || phaseSession !== undefined);
      if (span) {
        el.style.setProperty('background', span.background, 'important');
        el.style.boxShadow = span.boxShadow;
      } else {
        el.style.removeProperty('background');
        el.style.boxShadow = '';
      }
      // Labels + baselines on demand; allocation shows color band (and label when demand col hidden)
      var flags = colViewFlags(state.settings.colView, state.role);
      var showPhaseText = field === 'demand' || !flags.demand;
      if (!showPhaseText && !span) {
        return '';
      }
      var html = showPhaseText
        ? formatPhaseCellHtml(phaseText, phaseRef, phaseSession)
        : '';
      return withCellTooltip(cell, phaseText || '', html);
    }

    el.classList.remove('ppm-milestone-span');
    el.style.removeProperty('background');
    el.style.boxShadow = '';

    return formatMonthCellHtml(
      display === '' ? null : Number(display),
      snapVal,
      initialVal,
      field,
      hint
    );
  };
}

function onMonthEdited(cell) {
  var row = cell.getData();
  if (isGroup(row) || isSection(row)) return;
  var fieldName = cell.getField();
  var field = monthFieldKind(fieldName);
  if (!field) return;
  var mk = fieldName.slice(2);
  var key = monthKey(mk);
  var src = findRow(row.id);
  if (!src) return;
  var val = cell.getValue();

  if (isHeader(src) && field === 'demand') {
    src.phases = src.phases || {};
    src.phases[key] = val == null ? '' : String(val);
    setDirty(true);
    softRefreshTables();
    return;
  }
  if (!canEditMonth(state.role, field, src)) return;
  src.months = src.months || {};
  if (!src.months[key]) src.months[key] = emptyMonthCell();
  src.months[key][field] = val == null || val === '' ? null : Number(val);
  if (field === 'demand' || field === 'allocation') refreshAnalysis();
  setDirty(true);
  softRefreshTables();
}

function findRow(id) {
  if (id == null || id === '') return null;
  var want = String(id);
  for (var i = 0; i < state.rows.length; i++) {
    if (String(state.rows[i].id) === want) return state.rows[i];
  }
  return null;
}

function rowFormatter(row) {
  var d = row.getData();
  var el = row.getElement();
  el.classList.toggle('ppm-avail', isAvail(d));
  el.classList.toggle('ppm-header', isHeader(d));
  el.classList.toggle('ppm-group', isGroup(d));
  el.classList.toggle('ppm-section', isSection(d));
  el.classList.toggle('ppm-row-deleted', isPendingDelete(d) || isPendingDelete(findRow(d.id)));
  if (d && d.id != null && !isGroup(d) && !isSection(d) && !isEphemeral(d.id)) {
    el.setAttribute('data-row-id', String(d.id));
  } else {
    el.removeAttribute('data-row-id');
  }
}

/* ----- paste / selection helpers ----- */
function tableRanges(table) {
  try { return table.getRanges() || []; } catch (e) { return []; }
}

function isEditingInTable(table) {
  try {
    return !!(table.modules && table.modules.edit && table.modules.edit.currentCell);
  } catch (e) { return false; }
}

function selectedRangeMeta(mode) {
  var table = state.tables[mode];
  if (!table) return null;
  var ranges = tableRanges(table);
  if (!ranges.length) return null;
  var rowIds = {};
  var monthYms = {};
  var hasMonthCol = false;
  ranges.forEach(function (range) {
    (range.getRows ? range.getRows() : []).forEach(function (row) {
      var d = row.getData();
      if (isGroup(d) || isSection(d) || isEphemeral(d.id)) return;
      rowIds[d.id] = true;
    });
    (range.getColumns ? range.getColumns() : []).forEach(function (col) {
      var f = col.getField && col.getField();
      if (!isMonthField(f)) return;
      hasMonthCol = true;
      monthYms[f.slice(2)] = true;
    });
  });
  return {
    table: table,
    ranges: ranges,
    rowIds: Object.keys(rowIds),
    months: Object.keys(monthYms),
    hasMonthCol: hasMonthCol
  };
}

function parseClipboardMatrix(text) {
  var pasteRows = String(text).replace(/\r/g, '').split('\n');
  if (pasteRows.length && pasteRows[pasteRows.length - 1] === '') pasteRows.pop();
  return pasteRows.map(function (line) { return line.split('\t'); });
}

/** Normalize paste payload to a dense string matrix (rows × cols). */
function normalizePasteMatrix(pasteRows, destFields) {
  if (!pasteRows || !pasteRows.length) return [['']];
  var matrix = pasteRows.map(function (row) {
    if (Array.isArray(row)) {
      return row.map(function (v) { return v == null ? '' : String(v); });
    }
    if (row && typeof row === 'object') {
      if (destFields && destFields.length) {
        return destFields.map(function (f) {
          return row[f] == null ? '' : String(row[f]);
        });
      }
      return Object.keys(row).map(function (k) {
        return row[k] == null ? '' : String(row[k]);
      });
    }
    return [row == null ? '' : String(row)];
  });
  var width = 1;
  matrix.forEach(function (row) {
    if (row.length > width) width = row.length;
  });
  matrix.forEach(function (row) {
    while (row.length < width) row.push('');
  });
  return matrix.length ? matrix : [['']];
}

function restoreTableRange(table, startId, startField, endId, endField) {
  try {
    var startRow = findTableRow(table, startId);
    var endRow = findTableRow(table, endId);
    if (!startRow || !endRow) return;
    var startCell = startRow.getCell(startField);
    var endCell = endRow.getCell(endField);
    if (!startCell || !endCell) return;
    var existing = tableRanges(table);
    existing.forEach(function (r) {
      try { if (r.remove) r.remove(); } catch (e) {}
    });
    if (typeof table.addRange === 'function') {
      table.addRange(startCell, endCell);
    } else if (table.modules && table.modules.selectRange && table.modules.selectRange.addRange) {
      table.modules.selectRange.addRange(startCell, endCell);
    }
  } catch (e) {}
}

/** Push month flat fields from state → live tree row data and reformat (no replaceData). */
function syncPastedRowsInTable(table, touchedIds) {
  var idSet = {};
  (touchedIds || []).forEach(function (id) { idSet[String(id)] = true; });
  var empIds = {};
  Object.keys(idSet).forEach(function (id) {
    var src = findRow(id);
    if (src && src.employee_id) empIds[String(src.employee_id)] = true;
  });

  function shouldSync(src) {
    if (!src) return false;
    if (idSet[String(src.id)]) return true;
    return !!(isAvail(src) && src.employee_id && empIds[String(src.employee_id)]);
  }

  function walk(rows) {
    (rows || []).forEach(function (row) {
      var kids = row.getTreeChildren ? row.getTreeChildren() : [];
      if (kids && kids.length) walk(kids);
      var d = row.getData();
      if (isGroup(d) || isSection(d) || isEphemeral(d.id)) return;
      var src = findRow(d.id);
      if (!shouldSync(src)) return;
      state.months.forEach(function (m) {
        var key = monthKey(m);
        var mk = ym(m);
        if (isHeader(src)) {
          d['d_' + mk] = (src.phases && (src.phases[key] || src.phases[m])) || '';
          d['a_' + mk] = '';
        } else {
          var cell = (src.months && (src.months[key] || src.months[m])) || {};
          d['d_' + mk] = cell.demand == null || cell.demand === '' ? null : Number(cell.demand);
          d['a_' + mk] = cell.allocation == null || cell.allocation === '' ? null : Number(cell.allocation);
          d['e_' + mk] = cell.employee == null || cell.employee === '' ? null : Number(cell.employee);
          d['b_' + mk] = cell.budget == null || cell.budget === '' ? null : Number(cell.budget);
        }
        ['d_', 'a_', 'e_', 'b_'].forEach(function (prefix) {
          try {
            var c = row.getCell(prefix + mk);
            if (c) c.reformat();
          } catch (e) {}
        });
      });
    });
  }
  try { walk(table.getRows()); } catch (e) {}
}

function writePastedMonth(src, data, field, raw) {
  var f = monthFieldKind(field);
  if (!f) return false;
  var mk = field.slice(2);
  if (!canEditMonth(state.role, f, data)) return false;
  var key = monthKey(mk);
  if (isHeader(src) && f === 'demand') {
    src.phases = src.phases || {};
    src.phases[key] = raw == null ? '' : String(raw);
    data[field] = raw == null ? '' : String(raw);
    return true;
  }
  if (isHeader(src)) return false;
  var num = raw === '' || raw == null ? null : Number(String(raw).replace(',', '.'));
  if (num != null && isNaN(num)) return false;
  src.months = src.months || {};
  if (!src.months[key]) src.months[key] = emptyMonthCell();
  // Always write — even when destination already equals clipboard (Excel-like).
  src.months[key][f] = num;
  data[field] = num;
  return true;
}

function writePastedText(src, data, field, raw) {
  var textProps = {
    role: 'role', workpackage: 'workpackage', project_topic: 'project_id', name: 'employee_id',
    notes_people_lead: 'notes_people_lead', notes_project_lead: 'notes_project_lead',
    notes_employee: 'notes_employee', comments: 'comments', alternative_financing: 'alternative_financing'
  };
  var prop = textProps[field];
  if (!prop) return false;
  if (!canEditText(state.role, prop, src)) return false;
  var text = raw == null ? '' : String(raw);
  if (field === 'project_topic') {
    var match = state.projects.find(function (p) { return p.project_topic === text; });
    if (match) { src.project_id = match.id; src.project_topic = match.project_topic; data.project_topic = match.project_topic; }
    else { src.project_topic = text || null; data.project_topic = text || null; }
  } else if (field === 'name') {
    var emp = state.employees.find(function (e) { return e.name === text; });
    if (emp) { src.employee_id = emp.id; src.name = emp.name; data.name = emp.name; }
    else { src.name = text || null; data.name = text || null; }
  } else {
    src[field] = text || null;
    data[field] = text || null;
  }
  return true;
}

function applyPasteToRange(table, pasteRows) {
  if (!pasteRows || !pasteRows.length) return;
  var ranges = tableRanges(table);
  if (!ranges.length) return;
  var range = ranges[0];
  var cells = range.getCells ? range.getCells() : [];
  if (!cells.length || !cells[0] || !cells[0].length) return;

  var selRows = cells.length;
  var selCols = cells[0].length;
  var destFields = cells[0].map(function (cell) { return cell.getField(); });
  var matrix = normalizePasteMatrix(pasteRows, destFields);
  var srcRows = matrix.length;
  var srcCols = matrix[0].length;

  var startCell = cells[0][0];
  var endCell = cells[selRows - 1][selCols - 1];
  var startId = startCell.getData().id;
  var startField = startCell.getField();
  var endId = endCell.getData().id;
  var endField = endCell.getField();

  var changed = 0;
  var touchedIds = [];
  var touchedMap = {};

  for (var r = 0; r < selRows; r++) {
    var rowCells = cells[r];
    if (!rowCells) break;
    for (var c = 0; c < selCols; c++) {
      var cell = rowCells[c];
      if (!cell) break;
      var field = cell.getField();
      if (!field || field === '_drag') continue;
      // Excel/Sheets tiling: clipboard[r % R][c % C]
      var raw = matrix[r % srcRows][c % srcCols];
      if (raw === undefined || raw === null) raw = '';

      var data = cell.getData();
      if (isGroup(data) || isSection(data)) continue;
      var src = findRow(data.id);
      if (!src) continue;

      var ok = false;
      if (isMonthField(field)) ok = writePastedMonth(src, data, field, raw);
      else ok = writePastedText(src, data, field, raw);
      if (!ok) continue;

      if (!touchedMap[src.id]) {
        touchedMap[src.id] = true;
        touchedIds.push(src.id);
      }
      // Force visual update even when value was already equal (setValue no-ops on same).
      try { cell.setValue(data[field]); } catch (e) {}
      try { cell.reformat(); } catch (e) {}
      changed++;
    }
  }

  if (!changed) {
    toast('No editable cells in selection to paste');
    return;
  }

  refreshAnalysis();
  setDirty(true);

  // In-place reformat is unreliable with selectableRange + virtual DOM (values only
  // appeared after a later edit → softRefreshTables). Rebuild from state, then
  // restore the pasted selection so focus does not jump to top-left.
  var mode = table === state.tables.allocation ? 'allocation' : 'demand';
  var pending = ['demand', 'allocation'].map(function (m) {
    var t = state.tables[m];
    if (!t) return Promise.resolve();
    return Promise.resolve(t.replaceData(buildTreeData(m)));
  });
  Promise.all(pending).then(function () {
    var live = state.tables[mode];
    if (live) restoreTableRange(live, startId, startField, endId, endField);
  }).catch(function () {
    softRefreshTables();
    setTimeout(function () {
      var live = state.tables[mode];
      if (live) restoreTableRange(live, startId, startField, endId, endField);
    }, 50);
  });
  toast('Pasted ' + changed + ' cell(s)');
}

function copySelectionAsTsv(table) {
  var ranges = tableRanges(table);
  if (!ranges.length) return false;
  var cells = ranges[0].getCells ? ranges[0].getCells() : [];
  if (!cells.length) return false;
  var lines = cells.map(function (rowCells) {
    return (rowCells || []).map(function (cell) {
      var v = cell.getValue();
      return v == null ? '' : String(v);
    }).join('\t');
  });
  var text = lines.join('\n');
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).catch(function () {});
  } else {
    var ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }
  return true;
}

function bindClipboard(table, mode) {
  var holder = table.element;

  holder.addEventListener('paste', function (e) {
    var tag = (e.target && e.target.tagName) || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA' || (e.target && e.target.isContentEditable)) {
      return; // native paste while editing
    }
    if (isEditingInTable(table)) return;
    var text = (e.clipboardData || window.clipboardData).getData('text');
    if (!text || !String(text).trim()) return;
    if (!tableRanges(table).length) return;
    e.preventDefault();
    e.stopPropagation();
    applyPasteToRange(table, parseClipboardMatrix(text));
  });

  holder.addEventListener('keydown', function (e) {
    var mod = e.ctrlKey || e.metaKey;
    if (!mod) return;
    var key = String(e.key || '').toLowerCase();
    var tag = (e.target && e.target.tagName) || '';
    var inEditor = tag === 'INPUT' || tag === 'TEXTAREA' || isEditingInTable(table);
    if (inEditor) return; // allow native copy/paste in editor
    if (!tableRanges(table).length) return;
    if (key === 'c') {
      e.preventDefault();
      try {
        if (table.modules && table.modules.clipboard && table.modules.clipboard.copy) {
          table.modules.clipboard.copy(false, true);
        } else {
          copySelectionAsTsv(table);
        }
      } catch (err) {
        copySelectionAsTsv(table);
      }
    } else if (key === 'v') {
      e.preventDefault();
      if (navigator.clipboard && navigator.clipboard.readText) {
        navigator.clipboard.readText().then(function (text) {
          if (!text || !String(text).trim()) return;
          applyPasteToRange(table, parseClipboardMatrix(text));
        }).catch(function () {});
      }
    }
  });
}

function collectDemandSiblingOrderFromTable(table, movedId, projectId) {
  var orderedIds = [];
  if (!table) return orderedIds;
  // Prefer the moved row's live parent children (visual order after drag)
  if (movedId != null) {
    var movedRow = findTableRow(table, movedId);
    if (movedRow) {
      var parent = movedRow.getTreeParent && movedRow.getTreeParent();
      var kids = parent && parent.getTreeChildren ? parent.getTreeChildren() : null;
      if (kids && kids.length) {
        kids.forEach(function (ch) {
          var cd = ch.getData();
          if (!cd || isEphemeral(cd.id) || isGroup(cd) || isSection(cd)) return;
          orderedIds.push(String(cd.id));
        });
      }
    }
  }
  if (orderedIds.length) return orderedIds;
  try {
    table.getRows().forEach(function (root) {
      var rd = root.getData();
      if (!isGroup(rd)) return;
      var pid = rd.project_id || '';
      if (projectId && String(pid) !== String(projectId)) return;
      (root.getTreeChildren() || []).forEach(function (ch) {
        var cd = ch.getData();
        if (!cd || isEphemeral(cd.id) || isGroup(cd) || isSection(cd)) return;
        orderedIds.push(String(cd.id));
      });
    });
  } catch (e) {}
  return orderedIds;
}

/** Rebuild project sibling order from Tabulator neighbors after a drag. */
function orderProjectSiblingsFromNeighbors(movedId, projectId) {
  var src = findRow(movedId);
  if (!src) return [];
  var pid = String(projectId != null ? projectId : (src.project_id || ''));
  var siblings = state.rows.filter(function (r) {
    return !isEphemeral(r.id) && String(r.project_id || '') === pid;
  }).slice().sort(function (a, b) {
    return (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0) ||
      String(a.id).localeCompare(String(b.id));
  });
  var without = siblings.filter(function (r) { return String(r.id) !== String(movedId); });
  var table = state.tables.demand;
  var movedRow = findTableRow(table, movedId);
  var insertAfterId = null;
  if (movedRow && movedRow.getPrevRow) {
    var cursor = movedRow.getPrevRow();
    while (cursor) {
      var cd = cursor.getData();
      if (isGroup(cd) || isSection(cd)) {
        if (isGroup(cd) && String(cd.project_id || '') === pid) {
          insertAfterId = null;
          break;
        }
        cursor = cursor.getPrevRow ? cursor.getPrevRow() : null;
        continue;
      }
      if (String(cd.project_id || '') === pid && String(cd.id) !== String(movedId)) {
        insertAfterId = cd.id;
        break;
      }
      cursor = cursor.getPrevRow ? cursor.getPrevRow() : null;
    }
  }
  var insertAt = 0;
  if (insertAfterId != null) {
    var ix = -1;
    for (var i = 0; i < without.length; i++) {
      if (String(without[i].id) === String(insertAfterId)) { ix = i; break; }
    }
    insertAt = ix >= 0 ? ix + 1 : without.length;
  }
  without.splice(insertAt, 0, src);
  return without.map(function (r) { return String(r.id); });
}

/** Apply drag order to state.rows the same way insertRowBelow renumbers siblings. */
function applyDemandSortOrderFromIds(orderedIds, projectId) {
  if (!orderedIds.length) return false;
  var gk = projectId ? ('p:' + projectId) : null;
  if (!gk) {
    var first = findRow(orderedIds[0]);
    if (first) gk = demandGroupKey(first);
  }
  if (!gk) return false;

  var groupMembers = orderedGroupMembers(state.rows, 'demand', gk);
  if (!groupMembers.length) {
    // Fallback: match by project_id directly
    groupMembers = state.rows.filter(function (r) {
      return !isEphemeral(r.id) && String(r.project_id || '') === String(projectId || '');
    });
  }
  if (!groupMembers.length) return false;
  var byId = {};
  groupMembers.forEach(function (r) { byId[String(r.id)] = r; });
  var merged = [];
  orderedIds.forEach(function (id) {
    if (byId[id] && merged.indexOf(byId[id]) < 0) merged.push(byId[id]);
  });
  groupMembers.forEach(function (r) {
    if (merged.indexOf(r) < 0) merged.push(r);
  });
  merged.forEach(function (r, n) { r.sort_order = n + 1; });

  var memberIds = {};
  groupMembers.forEach(function (r) { memberIds[r.id] = 1; });
  var out = [];
  var placed = false;
  state.rows.forEach(function (r) {
    if (memberIds[r.id]) {
      if (!placed) {
        out.push.apply(out, merged);
        placed = true;
      }
      return;
    }
    out.push(r);
  });
  if (!placed) out.push.apply(out, merged);
  state.rows = out;

  if (!state._sortOrderTouched) state._sortOrderTouched = {};
  merged.forEach(function (r) { state._sortOrderTouched[String(r.id)] = true; });
  setDirty(true);
  return true;
}

function persistSortOrderWithinProject(movedId, projectId) {
  var before = [];
  var src = findRow(movedId);
  var pid = String(projectId != null ? projectId : ((src && src.project_id) || ''));
  state.rows.filter(function (r) {
    return !isEphemeral(r.id) && String(r.project_id || '') === pid;
  }).slice().sort(function (a, b) {
    return (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0);
  }).forEach(function (r) {
    before.push(String(r.id) + '=' + (Number(r.sort_order) || 0));
  });

  var table = state.tables.demand;
  var orderedIds = collectDemandSiblingOrderFromTable(table, movedId, projectId);
  var via = 'tree';
  if (!applyDemandSortOrderFromIds(orderedIds, projectId)) {
    orderedIds = orderProjectSiblingsFromNeighbors(movedId, projectId);
    via = 'neighbors';
    applyDemandSortOrderFromIds(orderedIds, projectId);
  }
  if (!state._sortOrderTouched) state._sortOrderTouched = {};
  if (movedId != null) state._sortOrderTouched[String(movedId)] = true;
  setDirty(true);

  var after = [];
  state.rows.filter(function (r) {
    return !isEphemeral(r.id) && String(r.project_id || '') === pid;
  }).slice().sort(function (a, b) {
    return (Number(a.sort_order) || 0) - (Number(b.sort_order) || 0);
  }).forEach(function (r) {
    after.push(String(r.id) + '=' + (Number(r.sort_order) || 0));
  });
  toast('Drag registered (' + via + '): ' + orderedIds.length + ' rows · dirty=' + !!state.dirty +
    (before.join(',') !== after.join(',') ? ' · order changed' : ' · order same'));
}

