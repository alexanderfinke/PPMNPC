  );
  var programOpts = unique((state.meta.Program || []).concat(state.projects.map(function (p) { return p.program; })));
  var deptOpts = unique((state.meta.Department || state.meta.Group || []).concat(
    state.employees.map(function (e) { return e.group_name; }),
    state.employees.map(function (e) { return roleDepartmentFromRole(e.role); })
  ).filter(function (v) { return v && v !== '—'; }));
  var unitOpts = unique((state.meta.Unit || []).concat(
    state.employees.map(function (e) { return roleUnitFromRole(e.role); })
  ).filter(function (v) { return v && v !== '—'; }));
  var projectOpts = {};
  state.projects.forEach(function (p) { projectOpts[p.id] = p.project_topic; });

  function accessEditable(cell) {
    var row = cell.getData();
    return canEdit && !row.is_auto && row.id !== DEFAULT_ADMIN_ACCESS_ID &&
      String(row.user_name || '').trim().toLowerCase() !== 'the admin';
  }

  function scopeOptionsForRole(roleType) {
    if (roleType === 'admin' || roleType === 'viewer') {
      return { global: ACCESS_SCOPE_LABELS.global };
    }
    if (roleType === 'people_lead') {
      return {
        global: ACCESS_SCOPE_LABELS.global,
        department: ACCESS_SCOPE_LABELS.department,
        unit: ACCESS_SCOPE_LABELS.unit
      };
    }
    if (roleType === 'project_lead') {
      return {
        global: ACCESS_SCOPE_LABELS.global,
        project: ACCESS_SCOPE_LABELS.project,
        program: ACCESS_SCOPE_LABELS.program
      };
    }
    return ACCESS_SCOPE_LABELS;
  }

  state.tables.access = new Tabulator(host, {
    data: data,
    height: '100%',
    layout: 'fitDataStretch',
    index: 'id',
    selectableRows: 1,
    columns: [
      {
        title: 'Role', field: 'role_type', width: 140,
        editor: canEdit ? 'list' : false,
        editable: accessEditable,
        editorParams: { values: ACCESS_ROLE_LABELS, listOnEmpty: true },
        formatter: outlineFormatter(hierFields, 'role_label', {
          edit: canEdit,
          getText: function (cell) { return ACCESS_ROLE_LABELS[cell.getValue()] || cell.getValue() || ''; }
        })
      },
      {
        title: 'Scope', field: 'scope_type', width: 140,
        editor: canEdit ? 'list' : false,
        editable: accessEditable,
        editorParams: function (cell) {
          return { values: scopeOptionsForRole(cell.getData().role_type), listOnEmpty: true };
        },
        formatter: outlineFormatter(hierFields, 'scope_label', {
          edit: canEdit,
          getText: function (cell) { return ACCESS_SCOPE_LABELS[cell.getValue()] || cell.getValue() || ''; }
        })
      },
      {
        title: 'User name', field: 'user_name', minWidth: 140,
        editor: canEdit ? 'list' : false,
        editable: accessEditable,
        editorParams: canEdit ? metaListEditorParams('User Name', personNameOptions()) : undefined,
        formatter: outlineFormatter(hierFields, 'user_name', { edit: canEdit })
      },
      {
        title: 'Scope value', field: 'scope_value', minWidth: 180,
        editable: function (cell) {
          var row = cell.getData();
          return accessEditable(cell) && row.scope_type !== 'global';
        },
        editor: function (cell, onRendered, success, cancel) {
          var row = cell.getData();
          var input;
          if (row.scope_type === 'project') {
            input = document.createElement('select');
            var blank = document.createElement('option');
            blank.value = ''; blank.textContent = '—';
            input.appendChild(blank);
            Object.keys(projectOpts).forEach(function (k) {
              var opt = document.createElement('option');
              opt.value = k; opt.textContent = projectOpts[k];
              input.appendChild(opt);
            });
            input.value = cell.getValue() || '';
          } else {
            // program / department / unit — dropdown of existing + free text for new
            input = document.createElement('input');
            input.type = 'text';
            input.setAttribute('list', 'access-scope-datalist');
            var list = document.getElementById('access-scope-datalist');
            if (!list) {
              list = document.createElement('datalist');
              list.id = 'access-scope-datalist';
              document.body.appendChild(list);
            }
            list.innerHTML = '';
            var opts = row.scope_type === 'program' ? programOpts
              : row.scope_type === 'unit' ? unitOpts
              : deptOpts;
            opts.forEach(function (v) {
              var opt = document.createElement('option');
              opt.value = v;
              list.appendChild(opt);
            });
            input.value = cell.getValue() || '';
            input.placeholder = 'Pick or type new…';
          }
          input.style.width = '100%';
          onRendered(function () { input.focus(); });
          input.addEventListener('blur', function () { success(input.value || null); });
          input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') success(input.value || null);
            if (e.key === 'Escape') cancel();
          });
          return input;
        },
        formatter: outlineFormatter(hierFields, 'scope_display', {
          edit: canEdit,
          getText: function (cell) { return scopeValueDisplay(cell.getData()); }
        })
      }
    ],
    rowClick: function (e, row) {
      state.selectedAccessId = row.getData().id;
      selectWholeTableRow(state.tables.access, row);
    }
  });
  state.tables.access.on('cellEdited', function (cell) {
    applyAccessCellEdit(cell, deptOpts, unitOpts, programOpts);
    setTimeout(function () { renderAccess(); }, 0);
  });
  host.classList.add('ppm');
}

