function normalizeAccessRoleType(t) {
  var s = String(t || '').toLowerCase().replace(/_/g, ' ').trim();
  if (s.indexOf('admin') >= 0) return 'admin';
  if (s.indexOf('viewer') >= 0 || s.indexOf('read only') >= 0 || s.indexOf('readonly') >= 0) return 'viewer';
  if (s.indexOf('people') >= 0 && s.indexOf('project') >= 0) return 'people_lead'; // combined sheet rows rare; prefer separate rows
  if (s.indexOf('people') >= 0) return 'people_lead';
  if (s.indexOf('project') >= 0) return 'project_lead';
  if (s.indexOf('employee') >= 0) return 'employee';
  return 'viewer';
}
function normalizeAccessScopeType(t) {
  var s = String(t || '').toLowerCase().trim();
  if (s === 'global' || s === 'project' || s === 'program' || s === 'department' || s === 'unit') return s;
  return 'global';
}
function normalizeAccessList(list) {
  return (list || []).map(function (r, i) {
    var roleType = normalizeAccessRoleType(r.role_type || r.roleType || r.role);
    var scopeType = normalizeAccessScopeType(r.scope_type || r.scopeType);
    var scopeValue = r.scope_value != null ? r.scope_value : (r.scopeValue != null ? r.scopeValue : null);
    if (!r.scope_type && !r.scopeType) {
      if (r.project) { scopeType = 'project'; scopeValue = r.project; }
      else if (r.programm || r.program) { scopeType = 'program'; scopeValue = r.programm || r.program; }
      else if (r.department) { scopeType = 'department'; scopeValue = r.department; }
      else if (r.unit) { scopeType = 'unit'; scopeValue = r.unit; }
      else scopeType = 'global';
    }
    // Admin / Viewer always global
    if (roleType === 'admin' || roleType === 'viewer') {
      scopeType = 'global';
      scopeValue = null;
    }
    var userName = r.user_name || r.userName || r.user || '';
    return {
      id: r.id || ('A_' + (i + 1)),
      user_name: userName,
      role_type: roleType,
      scope_type: scopeType,
      scope_value: scopeType === 'global' ? null : (scopeValue || null),
      is_auto: !!(r.is_auto || r.isAuto),
      sort_order: Number(r.sort_order) || (i + 1),
      role_label: ACCESS_ROLE_LABELS[roleType] || roleType,
      scope_label: ACCESS_SCOPE_LABELS[scopeType] || scopeType,
      source_label: 'Manual'
    };
  }).sort(function (a, b) {
    return (a.sort_order - b.sort_order) || String(a.id).localeCompare(String(b.id));
  });
}
