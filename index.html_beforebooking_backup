function mastersDiffer(kind) {
  if (kind === 'projects') {
    return JSON.stringify(state.projects || []) !== JSON.stringify(state.originalProjects || []);
  }
  if (kind === 'employees') {
    return JSON.stringify(state.employees || []) !== JSON.stringify(state.originalEmployees || []);
  }
  if (kind === 'access') {
    return JSON.stringify(normalizeAccessList(state.access || [])) !==
      JSON.stringify(normalizeAccessList(state.originalAccess || []));
  }
  return false;
}

function markMastersDirtyIfChanged(kind) {
  if (mastersDiffer(kind)) markMastersDirty(kind);
}

