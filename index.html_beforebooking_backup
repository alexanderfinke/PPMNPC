/**
 * Progressive boot:
 *  Wave 0 (parallel): detectVisitor + getMastersBundle
 *  Intention picker (after identity)
 *  Wave 1: getPortfolioBundle (when view needs it)
 *  Wave 2: getFinanceBundle (when view needs it / background)
 */
function boot() {
  saveForceRegistered(false);
  state._boot = {
    detect: null,
    masters: null,
    identity: '',
    intention: null,
    portfolioStarted: false,
    financeStarted: false
  };
  if ($('appShell')) $('appShell').hidden = true;
  hideIntentionPicker();
  setBootMessage('Detecting Google account…');
  setBootProgress(8);

  var detectP = runGas('detectVisitor', '', false).then(function (info) {
    state._boot.detect = info || {};
    var identity = googleIdentityFromDetect(info);
    if (identity) {
      state._boot.identity = identity;
      saveRegisteredAs(identity);
      setBootMessage('Hello, ' + identity + '. Loading projects & employees…');
      setBootProgress(22);
      applyBootScopeFiltersFromDetect(info);
    } else {
      setBootMessage('Detecting Google account…');
    }
    return info;
  }).catch(function (e) {
    state._boot.detect = { needsRegistration: true, error: e && e.message ? e.message : String(e) };
    return state._boot.detect;
  });

  var mastersP = runGas('getMastersBundle', '', false).then(function (data) {
    state._boot.masters = data;
    setBootProgress(40);
    if (state._boot.identity) setBootMessage('Hello, ' + state._boot.identity + '. Master data ready…');
    else setBootMessage('Loading projects & employees…');
    return data;
  });

  Promise.all([detectP, mastersP]).then(function () {
    finishWaveMasters();
  }).catch(function (e) {
    setBootMessage('Load failed: ' + (e && e.message ? e.message : e));
  });
}

function applyBootScopeFiltersFromDetect(info) {
  // Prefer saved filters; otherwise seed from Access scopes once identity is known.
  if (activeFilterCount() > 0) return;
  var identity = googleIdentityFromDetect(info);
  if (!identity) return;
  // Access list arrives with masters — defer if not ready
  state._boot._pendingScopeFilters = true;
}

function applyBootScopeFilters() {
  if (!state._boot || !state._boot._pendingScopeFilters) return;
  if (activeFilterCount() > 0) {
    state._boot._pendingScopeFilters = false;
    return;
  }
  var me = String(state.registeredAs || '').trim().toLowerCase();
  if (!me) return;
  var role = state.role;
  var filters = clone(state.globalFilters || {});
  var changed = false;

  if (roleHasProjectLead(role) && role !== 'Admin') {
    var topics = [];
    normalizeAccessList(state.access || []).forEach(function (a) {
      if (String(a.user_name || '').trim().toLowerCase() !== me) return;
      var rt = String(a.role_type || '').toLowerCase();
      if (rt.indexOf('project') < 0 && rt !== 'project_lead') return;
      if (a.scope_type === 'project' && a.scope_value) {
        var p = state.projectById[a.scope_value];
        if (p && p.project_topic) topics.push(p.project_topic);
      }
    });
    // Also Topics where user is Project Lead
    (state.projects || []).forEach(function (p) {
      if (String(p.project_lead || '').trim().toLowerCase() === me && p.project_topic) {
        topics.push(p.project_topic);
      }
    });
    topics = unique(topics);
    if (topics.length && topics.length <= 40) {
      filters['Project / Topic'] = topics;
      changed = true;
    }
  }

  if (roleHasPeopleLead(role) && role !== 'Admin') {
    var depts = [];
    normalizeAccessList(state.access || []).forEach(function (a) {
      if (String(a.user_name || '').trim().toLowerCase() !== me) return;
      var rt = String(a.role_type || '').toLowerCase();
      if (rt.indexOf('people') < 0 && rt !== 'people_lead') return;
      if (a.scope_type === 'department' && a.scope_value) depts.push(String(a.scope_value));
    });
    depts = unique(depts);
    if (depts.length && depts.length <= 40) {
      filters.Department = depts;
      changed = true;
    }
  }

  if (changed) {
    state.globalFilters = filters;
    state.filterDraft = clone(filters);
    persistUserSettings();
    updateFiltersButtonLabel();
  }
